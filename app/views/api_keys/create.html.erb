<%# The ONE page that shows a raw API key — the direct response to the mint
    POST (ApiKeysController#create), served no-store. There is no URL that
    renders it again: reload re-submits the form and mints a different key. %>
<% raw_key = @api_key.raw_token %>
<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-extrabold text-heading mb-8">Your new API key</h1>

  <div class="card shadow p-6 mb-6" data-api-key-created>
    <p class="text-body font-semibold mb-1">Copy it now. We can't show it again.</p>
    <p class="text-secondary text-sm mb-4">
      We store only a fingerprint of this key, so if you lose it, revoke it and create another.
      It expires on <%= @api_key.expires_at.strftime("%b %-d, %Y") %>.
    </p>

    <div class="overflow-x-auto mb-6" data-api-key-secret>
      <%= render "components/copy_button", text: raw_key %>
    </div>

    <h2 class="text-sm font-bold text-heading mb-2">Check that it works</h2>
    <div class="overflow-x-auto mb-6">
      <%= render "components/copy_button",
            text: %(curl -H "Authorization: Bearer #{raw_key}" #{request.base_url}/api/v1/me),
            display: %(curl -H "Authorization: Bearer #{@api_key.prefix}…" #{request.base_url}/api/v1/me) %>
    </div>

    <%= link_to "I've copied it", account_path, class: "btn btn-primary w-full" %>
  </div>
</div>
