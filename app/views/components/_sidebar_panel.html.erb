<%# Shared fixed right-sidebar shell.

    A FORK OF studio-engine's components/_sidebar_panel (0.113.0), kept for two
    deltas the engine copy cannot carry yet (/tasks/turf-readopts-engine-navbar):
      title_html   the gear sidebar's live status line in the title's place.
                   The engine's header has only `title` (an escaped h3) and
                   actions_html, which sits in the right-hand ml-auto group,
                   so the status line would move from the left to beside the x.
      close hook   data-sidebar-panel-close="<id>", which the gear sidebar's
                   capture-phase click handler in layouts/application matches
                   by panel id. The engine's button says
                   data-link-sidebar-close="true", with no id.
    Everything else is the engine's copy, including its tag.attributes
    dismissal handlers and the close button's focus ring. Delete this file once
    the engine takes title_html and an id-bearing close hook.
    Locals:
      id             - DOM id for aria-controls
      title          - header title (plain text; also feeds the accessible name)
      title_html     - header LEAD SLOT: pre-rendered HTML in the title's place,
                       for a caller whose lead is a live status line rather than
                       a label. It is content, NOT a name: it never feeds
                       aria-labelledby or aria_label, so a caller that passes it
                       instead of `title` MUST pass its own aria_label or the
                       panel loses its accessible name entirely.
      open           - Alpine expression controlling visibility
      actions_html   - optional header action HTML
      body_html      - main sidebar body HTML
      footer_html    - optional footer HTML
      close_action   - optional Alpine expression for the close button
      outside_action - optional Alpine expression for click-outside
      escape_action  - optional Alpine expression for Escape
      display_class  - responsive display utilities, default desktop sidebar
      width_class    - width utility, default w-80 max-w-full
      z_class        - z-index utility, default z-40
      role           - ARIA role, default complementary
      aria_label     - label override, defaults to title
%>
<% id             = local_assigns.fetch(:id, nil) %>
<% title          = local_assigns.fetch(:title, nil) %>
<% title_html     = local_assigns.fetch(:title_html, nil) %>
<% open           = local_assigns.fetch(:open) %>
<% actions_html   = local_assigns.fetch(:actions_html, nil) %>
<% body_html      = local_assigns.fetch(:body_html, nil) %>
<% footer_html    = local_assigns.fetch(:footer_html, nil) %>
<% close_action   = local_assigns.fetch(:close_action, nil) %>
<% outside_action = local_assigns.fetch(:outside_action, nil) %>
<% escape_action  = local_assigns.fetch(:escape_action, nil) %>
<% display_class  = local_assigns.fetch(:display_class, "hidden md:flex") %>
<% width_class    = local_assigns.fetch(:width_class, "w-80 max-w-full") %>
<% z_class        = local_assigns.fetch(:z_class, "z-40") %>
<% panel_class    = local_assigns.fetch(:panel_class, "") %>
<% role           = local_assigns.fetch(:role, "complementary") %>
<% aria_label     = local_assigns.fetch(:aria_label, title) %>
<% labelledby     = id.present? && title.present? ? "#{id}-title" : nil %>

<aside
  <% if id.present? %>id="<%= id %>"<% end %>
  x-cloak
  x-show="<%= open %>"
  <%# THE THREE DISMISSAL HANDLERS, EMITTED BY tag.attributes, as in the
      engine's copy. They were %(@name="#{action}").html_safe, the attribute's
      own quotes assembled in Ruby and marked safe, so a double quote in an
      action closed the attribute and the rest became markup. The actions stay
      html_safe (they are Alpine expressions the caller wrote); tag_option still
      turns a double quote into &quot;, so none can end its attribute. %>
  <%= tag.attributes("@click.outside": outside_action.html_safe) if outside_action.present? %>
  <%= tag.attributes("@keydown.escape.window": escape_action.html_safe) if escape_action.present? %>
  <%= tag.attributes("@turbo:before-cache.window": close_action.html_safe) if close_action.present? %>
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="translate-x-full"
  x-transition:enter-end="translate-x-0"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="translate-x-0"
  x-transition:leave-end="translate-x-full"
  class="<%= display_class %> fixed right-0 <%= width_class %> bg-surface border-l border-subtle shadow-2xl <%= z_class %> flex-col <%= panel_class %>"
  <%# --nav-bottom, NOT --nav-h. The engine publishes both and documents the
      difference: --nav-h is the header's HEIGHT (use it to SIZE something as
      tall as the header), --nav-bottom is its BOTTOM EDGE in viewport
      coordinates (use it to START something underneath it). They are equal only
      while the header sits at the very top of the viewport. Rendering the
      environment bars ABOVE the header pushes it down, so --nav-h shrank by the
      stack height (measured: 96 vs 143 desktop, 131 vs 178 mobile — exactly the
      47px stack) while the header's on-screen bottom did not move, and a panel
      positioned at --nav-h landed 47px too high and painted over the navbar's
      lower strip. The engine already migrated its own copy of this partial. %>
  <%# data-pin-edge (studio-engine 0.111.1): on the scroll-timeline header
      --nav-bottom is the PINNED edge, and at the top of the page the expanded
      header reaches further down. engine.css moves this panel's top and height
      with the header on the same scroll timeline; off the timeline it matches
      nothing and the style below stands. %>
  data-pin-edge
  style="top:var(--nav-bottom, var(--nav-h, 6rem));height:calc(100% - var(--nav-bottom, var(--nav-h, 6rem)))"
  role="<%= role %>"
  <% if labelledby %>aria-labelledby="<%= labelledby %>"<% elsif aria_label.present? %>aria-label="<%= aria_label %>"<% end %>>
  <div class="flex flex-col h-full">
    <% if title.present? || title_html.present? || actions_html.present? || close_action.present? %>
      <div class="flex items-center justify-between p-4 border-b border-subtle">
        <% if title.present? %>
          <h3 <% if labelledby %>id="<%= labelledby %>"<% end %> class="text-lg font-bold text-heading"><%= title %></h3>
        <% elsif title_html.present? %>
          <%# min-w-0 so a long status line TRUNCATES inside its own box instead
              of pushing the close button off the panel's right edge on a phone. %>
          <div class="min-w-0 flex-1"><%= title_html %></div>
        <% end %>
        <div class="flex items-center gap-2 ml-auto">
          <%= actions_html if actions_html.present? %>
          <% if close_action.present? %>
            <button type="button"
                    @click="<%= close_action %>"
                    class="flex items-center justify-center w-8 h-8 rounded-full text-secondary hover:text-heading hover:bg-surface-alt focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 transition"
                    aria-label="Close sidebar"
                    data-sidebar-panel-close="<%= id %>">
              <span class="text-xl leading-none">&times;</span>
            </button>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= body_html if body_html.present? %>
    <%= footer_html if footer_html.present? %>
  </div>
</aside>
