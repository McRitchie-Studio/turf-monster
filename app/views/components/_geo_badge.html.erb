<%# The visitor's detected state — public, no sign-in required. Detection is
    IP-based (detect_geo_state runs for every request), so the badge can always
    say where the browser appears to be: a flag + code when the state resolves,
    a red "??" when it cannot (fail-closed: an undetectable US location is
    treated as blocked), red when the state is on the legal blocklist or a geo
    override is active. %>
<% state = geo_state %>
<%# A US state flag is ONLY correct for a US visitor. state_flag_path matches a
    bare two-letter code, so a foreign region normalising to "CA" would be shown
    the CALIFORNIA flag — wrong, and wrong in the way that looks right. Outside
    the US we render the country flag from the ISO alpha-2 instead, and never
    consult the state-flag lookup at all. %>
<% foreign = foreign_geo?(geo_country) %>
<% country_flag = foreign ? country_flag_emoji(geo_country) : nil %>
<span class="geo-badge inline-flex items-center gap-1.5 text-xs font-mono px-2 py-0.5 rounded-lg whitespace-nowrap
  <%= if geo_override_active?
        'bg-red-500/10 text-red-400 border border-red-500/30'
      elsif geo_blocked?
        'bg-red-500/10 text-red-400 border border-red-500/30'
      elsif state.present?
        'bg-surface-alt text-secondary border border-subtle'
      else
        'bg-surface-alt text-muted border border-subtle'
      end %>">
  <% if country_flag %>
    <span aria-label="<%= geo_country %>" role="img" style="line-height: 1; flex-shrink: 0;"><%= country_flag %></span>
  <% elsif !foreign && state.present? && (flag = state_flag_path(state)) %>
    <img src="<%= flag %>" alt="<%= state %>" class="rounded-sm" style="height: 12px; width: 16px; object-fit: cover; flex-shrink: 0;">
  <% end %>
  <%= state || "??" %>
</span>
