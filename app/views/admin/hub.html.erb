<% content_for(:title, "Link Hub — Turf Monster") %>

<div class="max-w-5xl mx-auto py-8 space-y-10">
  <div>
    <h1 class="text-heading text-3xl font-extrabold mb-1">Link Hub</h1>
    <p class="text-secondary text-sm">Admin tools, data browsers, and quick actions — everything that used to live in the navbar gear.</p>
  </div>

  <%= render layout: "hub_section", locals: { title: "Design" } do %>
    <%= render "hub_tile", name: "Theme",         url: admin_theme_path %>
    <%= render "hub_tile", name: "Emails",        url: admin_emails_path %>
    <%= render "hub_tile", name: "Navbar",        url: admin_navbar_path %>
    <%= render "hub_tile", name: "Level Badges",  url: admin_level_badges_path %>
    <% unless Rails.env.production? %>
      <%= render "hub_tile", name: "Toast Test", url: toast_test_path %>
    <% end %>
  <% end %>

  <%= render layout: "hub_section", locals: { title: "Sports" } do %>
    <%= render "hub_tile", name: "Teams",   url: teams_path %>
    <%= render "hub_tile", name: "Players", url: players_path %>
    <%= render "hub_tile", name: "Games",   url: games_path %>
    <%= render "hub_tile", name: "NFL Team Totals", url: nfl_team_totals_path,
          note: "2026 baseline expected points by team and week" %>
    <%= render "hub_tile", name: "Goal Console", url: admin_scoring_path, note: "Record goals live on game day (team + minute)" %>
    <%= render "hub_tile", name: "🏈 NFL Weeks", url: admin_nfl_weeks_path,
          note: "Drag a week's games into the order the live board prefers" %>
  <% end %>

  <%= render layout: "hub_section", locals: { title: "Admin" } do %>
    <%= render "hub_tile", name: "Dashboard", url: admin_dashboard_path %>
    <%= render "hub_tile", name: "Schema",       url: admin_schema_path %>
    <%= render "hub_tile", name: "Models",       url: admin_models_path, status: :reviewed,
          note: "Ten-row QA snapshots for users, teams, and arenas" %>
    <%= render "hub_tile", name: "Users",        url: admin_users_path, status: :reviewed %>
    <%= render "hub_tile", name: "Free Entries", url: admin_free_entries_path %>
    <%= render "hub_tile", name: "Entry Gifts",  url: admin_entry_gifts_path,
          note: "Send a friend a paid-for entry by email" %>
    <%= render "hub_tile", name: "Currencies",   url: admin_currencies_path, note: "On-chain accepted_currencies (register / deactivate / sweep)" %>
    <% unless Rails.env.production? %>
      <%= render "hub_tile", name: "Faucet",     url: faucet_path %>
    <% end %>
    <%= render "hub_tile", name: "Geo Settings", url: admin_geo_path, status: :reviewed %>
    <%= render "hub_tile", name: "Error Logs",   url: admin_error_logs_path, status: :reviewed,
          note: "Incident triage — class facets, target filter, deep-links" %>
  <% end %>

  <%= render layout: "hub_section", locals: { title: "Hub" } do %>
    <%= render "hub_tile", name: "New Contest", url: new_contest_path, status: :flagged %>
    <%= render "hub_tile", name: "Contests",    url: contests_path, status: :reviewed %>
    <%= render "hub_tile", name: "Landing Pages", url: admin_landing_pages_path, status: :reviewed %>
    <%= render "hub_tile", name: "Link Preview", url: admin_link_preview_path,
               note: "The site-wide image, title and description shared links unfurl with" %>
    <%= render "hub_tile", name: "Seasons",     url: admin_seasons_path, status: :flagged %>
    <%= render "hub_tile", name: "Treasury",    url: admin_pending_transactions_path, status: :flagged,
          note: "Co-sign pending vault transactions, the revenue sweep among them (hop 1)" %>
    <%# TWO TILES, ONE SQUAD, AND THAT IS DELIBERATE. Collecting operator revenue is
        two hops: the sweep lands funds in the treasury (Treasury, above), and moving
        them onward happens ONLY in Squads' own UI, which no code in this app performs
        or prepares. Mr. McRitchie had to hunt for that second hop mid-task, because
        the one Squads link on this page sat under "Signing and Multisig" labelled for
        MEMBERSHIP, which reads like a different errand. So the money hop gets its own
        tile beside the hop it follows, and the membership tile stays where an operator
        changing membership looks. Both resolve through Solana::Config.squads_app_url,
        which keys the URL on the cluster's VAULT PDA and appends /home: a hardcoded
        address would serve the wrong cluster, and the multisig address 404s. %>
    <%= render "hub_tile", name: "Squads Treasury", external: true,
          url: Solana::Config.squads_app_url,
          note: "Move swept revenue out of the #{Solana::Config::NETWORK} treasury (hop 2, Squads' own UI)" %>
    <% if Admin::VaultInitController.vault_uninitialized? %>
      <%= render "hub_tile", name: "Vault Init", url: admin_vault_init_path, note: "Vault is uninitialized", status: :flagged %>
    <% else %>
      <%= render "hub_tile", name: "Vault State", url: admin_vault_state_path,
            note: (Admin::VaultStateController.vault_paused? ? "🚨 PAUSED" : nil), status: :flagged %>
    <% end %>
    <%= render "hub_tile", name: "The Contract", url: contract_path, note: "turf-vault on-chain reference (admin sections expand)" %>
    <%= render "hub_tile", name: "Transparency", url: transparency_path, note: "Public trust hub — source, reserves, contract, policies" %>
    <%= render "hub_tile", name: "Jobs",        url: "/admin/jobs", status: :flagged %>
  <% end %>

  <%= render layout: "hub_section", locals: { title: "Signing & Multisig" } do %>
    <%# AUTHORITIES LEADS THIS SECTION, matching the page it opens. /admin/authorities
        now puts the eviction console above its four read-only panels, because
        evicting a compromised vault signer is the act an operator comes here to
        perform. The tile order says the same thing one level up: the two entries
        under it are a WIP page in another app and a link out to a third-party UI,
        neither of which is the thing to reach for first during an incident.

        THE TILE ITSELF IS NOT NEW. It shipped with the page in
        /tasks/admin-evicts-compromised-signers and has been on `accepted` since.
        A grep that reported it missing was reading a PRIMARY CHECKOUT sitting on
        `main`, which lags `accepted` by the release that carries it. %>
    <%= render "hub_tile", name: "Authorities", url: admin_authorities_path,
          note: "Evict a vault signer — plus thresholds and Squads, decoded from chain",
          status: :flagged %>
    <%# Signing Console is a WIP page in the mcritchie-studio app; it may 404 until that app deploys. %>
    <%= render "hub_tile", name: "Signing Console", external: true,
          url: "https://app.mcritchie.studio/admin/signing_requests",
          note: "Keyless multi-party signing queue (mcritchie-studio)" %>
    <%# TWO DEFECTS, ONE TILE, FIXED TOGETHER. It hardcoded the MAINNET Squad on
        every cluster AND called it "2-of-3"; the chain reads 3-of-5 on both,
        with different membership per cluster. `sweep-stale-signer-claims`
        dropped the stale threshold from the note and this branch made the URL
        cluster-keyed — the same tile, corrected from two directions. Kept as
        ONE fix: the address decides which cluster the link serves, so a
        hardcoded one is the more dangerous half and had to go.
        No number lives here at all now. A figure written into a tile cannot be
        re-derived on the day; the threshold is read live on /admin/authorities.

        THE URL LANDED ON A 404 until link-squads-from-admin, on this tile and on
        /admin/authorities alike: the builder interpolated the MULTISIG address, and
        Squads keys on the VAULT PDA plus /home. Same destination as the Squads
        Treasury tile in the Hub section above, kept as two tiles because the two jobs
        start in two different places; the reasoning is written out up there. %>
    <%= render "hub_tile", name: "Squads Multisig", external: true,
          url: Solana::Config.squads_app_url,
          note: "Change program-upgrade membership on #{Solana::Config::NETWORK} (Squads' own UI)" %>
  <% end %>

  <%= render layout: "hub_section", locals: { title: "Everything Else" } do %>
    <%= render "hub_tile", name: "Slate Formula", url: slates_path, status: :flagged %>
    <% if @active_slate %>
      <%= render "hub_tile", name: "Slate Simulator", url: manage_admin_slate_path(@active_slate), status: :flagged %>
    <% end %>
    <%= render "hub_tile", name: "Formula",           url: formula_report_slates_path, status: :flagged %>
    <%= render "hub_tile", name: "🏈 NFL Points Distribution", url: nfl_report_slates_path, status: :flagged %>
    <%= render "hub_tile", name: "🏈 Turf Score Benchmarks", url: benchmarks_path,
          note: "Public — the pricing board players read" %>
    <%= render "hub_tile", name: "Formula Defaults",  url: admin_formula_slates_path, status: :flagged %>
    <%= render "hub_tile", name: "Contest Generator", url: generator_contests_path, status: :flagged %>
    <%= render "hub_tile", name: "Transactions",      url: admin_transactions_path, status: :flagged %>
  <% end %>

  <%# Below every tile docs/workflows cites by line, so appending moves none. %>
  <%= render layout: "hub_section", locals: { title: "Marketing" } do %>
    <%= render "hub_tile", name: "Referrals", url: admin_referrals_path,
          note: "Clicks to email and account signups per ?reference= link" %>
  <% end %>

  <%# Actions — buttons and POST forms; a flex row, not the hub_section tile grid. %>
  <section>
    <h2 class="label-upper font-bold mb-3">Actions</h2>
    <div class="flex flex-wrap gap-3">
      <button type="button"
              @click="showNavSpinner(); refreshBalance().finally(function() { hideNavSpinner(); })"
              class="btn btn-outline btn-sm">Refresh Balance</button>
      <button type="button"
              @click="$dispatch('navbar-replay-level')"
              class="btn btn-outline btn-sm">Replay Level</button>
      <%= button_to(geo_override_active? ? "Clear simulation" : "Simulate WA",
            admin_geo_toggle_path, method: :post,
            class: "btn btn-sm #{geo_override_active? ? 'btn-danger' : 'btn-outline'}") %>
      <% if @latest_contest %>
        <%= button_to "Reset Contest", reset_contest_path(@latest_contest), method: :post,
              data: { turbo_confirm: "Reset contest? This clears all entries and results." },
              class: "btn btn-danger btn-sm" %>
      <% end %>
    </div>
  </section>
</div>
