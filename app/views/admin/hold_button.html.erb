<% content_for(:title, "Hold Button Fizz Lab — Turf Monster") %>

<%# Fizz lab for shared/_hold_button. The real button lives at the bottom of a
    contest board behind six picks and its success state is one-shot, so every
    phase of the particle layer is forced side by side here instead.
    CSS lives in app/assets/tailwind/application.css: the face colors in
    @utility hold-btn, the bubbles in @utility hold-stack ("Hold Button Fizz").
    The per-bubble table is ApplicationHelper#hold_button_fizz_bits. %>

<div class="max-w-5xl mx-auto py-8 px-4 space-y-10" x-data="{ submitting: false }">
  <header>
    <h1 class="text-heading text-3xl font-extrabold mb-1">Hold Button — Fizz Lab</h1>
    <p class="text-secondary text-sm">
      Carbonation on the hold-to-confirm CTA. Bubbles sit <em>behind</em> the button and only show
      where they escape its edges: they simmer at rest, boil on hover, on the nudge shake and
      through the hold, then burst outward when the entry confirms. Each button's scatter is
      seeded per <code class="text-xs">hold_id</code> — different per button, identical on every render.
    </p>
  </header>

  <section class="space-y-3">
    <h2 class="text-heading text-lg font-bold">With and without</h2>
    <p class="text-muted text-xs">Hover each one. Left is the new default; right is <code>fizz: false</code>.</p>
    <div class="card p-6 grid md:grid-cols-2 gap-8">
      <div class="space-y-2">
        <p class="text-heading font-semibold text-sm">Fizz on (default)</p>
        <div style="max-width:18rem">
          <%= render "shared/hold_button", hold_id: "fizz-on" %>
        </div>
      </div>
      <div class="space-y-2">
        <p class="text-heading font-semibold text-sm">Fizz off</p>
        <div style="max-width:18rem">
          <%= render "shared/hold_button", hold_id: "fizz-off", fizz: false %>
        </div>
      </div>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-heading text-lg font-bold">Calm and lively</h2>
    <p class="text-muted text-xs">
      Two intensities. <code>fizz_level: :lively</code> is the DEFAULT — it rests at a full boil, and
      hovering doubles the bubble <em>count</em> at the same speed: a second scatter fades in over the
      gaps in the first, and fades back out when you leave. The resting layer wears each team's
      <em>light</em> color and the hover layer its <em>dark</em> and <em>alt</em>, so the bright set
      carries the button and hover fills the gaps with the deep colors. <code>fizz_level: :calm</code> is the quiet alternative — one
      layer, simmering at rest, boiling on hover. Held, submitting, confirmed and blocked are identical.
    </p>
    <div class="card p-6 grid md:grid-cols-2 gap-8">
      <div class="space-y-2">
        <p class="text-heading font-semibold text-sm">Calm</p>
        <div style="max-width:18rem">
          <%= render "shared/hold_button", hold_id: "fizz-calm", fizz_level: :calm %>
        </div>
      </div>
      <div class="space-y-2">
        <p class="text-heading font-semibold text-sm">Lively (default)</p>
        <div style="max-width:18rem">
          <%= render "shared/hold_button", hold_id: "fizz-lively", fizz_level: :lively %>
        </div>
      </div>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-heading text-lg font-bold">Every phase</h2>
    <p class="text-muted text-xs">
      States are pinned by class here — the live button below walks them for real.
      Replay re-runs the one-shot burst.
    </p>
    <div class="card p-6 grid md:grid-cols-2 gap-8">
      <% [
           { id: "fizz-rest",    state: nil,       label: "Rest — simmer",   note: "Always on. Low amplitude, ~40% of each bubble's drift." },
           { id: "fizz-process", state: "process", label: "Held — boil",     note: "Full drift, faster cycle, bright. Runs for the 2s hold." },
           { id: "fizz-success", state: "success", label: "Confirmed — burst", note: "One-shot spew at 2.6x drift, then gone." },
           { id: "fizz-error",   state: "error",   label: "Blocked — no fizz", note: "Bubbles cut dead; the red state stays plain." }
         ].each do |demo| %>
        <div class="space-y-2" data-fizz-demo="<%= demo[:id] %>" data-fizz-state="<%= demo[:state] %>">
          <div class="flex items-center justify-between gap-2">
            <p class="text-heading font-semibold text-sm"><%= demo[:label] %></p>
            <% if demo[:state] %>
              <button type="button" class="text-xs text-secondary underline" data-fizz-replay="<%= demo[:id] %>">Replay</button>
            <% end %>
          </div>
          <div style="max-width:18rem">
            <%= render "shared/hold_button", hold_id: demo[:id] %>
          </div>
          <p class="text-muted text-xs"><%= demo[:note] %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-heading text-lg font-bold">Confirmed — which green?</h2>
    <p class="text-muted text-xs">
      The confirmed face used to jump to mint/teal, a different hue from the button you pressed,
      with a mint check on top of it that barely showed. The default is now Deep forest — the same
      brand green dropping into near-black, with a white check. Any of these can become the default —
      each is three variables (<code>--hold-success-from</code>, <code>--hold-success-to</code>, <code>--hold-success-glow-rgb</code>), settable on any ancestor.
    </p>
    <div class="card p-6 grid md:grid-cols-3 gap-8">
      <% [
           { id: "fizz-green-deep", label: "Deep forest (default)", style: "",
             note: "primary-500 → primary-900. Settles instead of shouting; the white check reads hard against it." },
           { id: "fizz-green-brand", label: "Brand lit",
             style: "--hold-success-from:#A5D7A8;--hold-success-to:#357A38;--hold-success-glow-rgb:75 175 80",
             note: "primary-300 → primary-700. Lighter, louder." },
           { id: "fizz-green-mint", label: "Emerald (the old one)",
             style: "--hold-success-from:#06d6a0;--hold-success-to:#025e40;--hold-success-glow-rgb:6 214 160",
             note: "What it looked like before — teal, off the brand." }
         ].each do |demo| %>
        <div class="space-y-2" data-fizz-demo="<%= demo[:id] %>" data-fizz-state="success" style="<%= demo[:style] %>">
          <div class="flex items-center justify-between gap-2">
            <p class="text-heading font-semibold text-sm"><%= demo[:label] %></p>
            <button type="button" class="text-xs text-secondary underline" data-fizz-replay="<%= demo[:id] %>">Replay</button>
          </div>
          <div style="max-width:18rem">
            <%= render "shared/hold_button", hold_id: demo[:id] %>
          </div>
          <p class="text-muted text-xs"><%= demo[:note] %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-heading text-lg font-bold">Dressed in team colors</h2>
    <p class="text-muted text-xs">
      What the board's button wears once six picks are in: each team's light and dark brand color,
      eighteen slots in pick order — three per team. The button is cut into six <em>zones</em> in a 3&times;2
      grid — three along the top edge, three along the bottom, left to right — one per pick, and a bubble
      only wears the colors of the team whose zone it sits in, so the fizz reads as six teams standing
      around the button. The resting layer takes each team's <em>light</em> color; the hover layer
      alternates its <em>dark</em> and its <em>alt</em>. Most teams have no alt and fall back to their
      dark — the third color is the flourish where one exists (the Ravens' red, the Buccaneers' orange). On the board these ride
      <code>:style="fizzPalette"</code> and re-dress themselves as picks change; unfilled slots keep
      the candy color.
    </p>
    <div class="card p-6 space-y-4">
      <div style="max-width:18rem">
        <%= render "shared/hold_button", hold_id: "fizz-teams",
              default_text: "Hold to Confirm",
              fizz_colors: @fizz_palette.flat_map { |team| [ team[:light], team[:dark], team[:alt] ] } %>
      </div>
      <div class="flex flex-wrap gap-3">
        <% @fizz_palette.each_with_index do |team, i| %>
          <div class="flex items-center gap-2 text-xs text-secondary">
            <span class="inline-flex rounded-full overflow-hidden border border-subtle" style="width:3rem;height:1.125rem">
              <span style="flex:1;background:<%= team[:light] %>"></span>
              <span style="flex:1;background:<%= team[:dark] %>"></span>
              <% if team[:alt_curated] %>
                <span style="flex:1;background:<%= team[:alt] %>"></span>
              <% end %>
            </span>
            <span>Zone <%= i + 1 %> · <%= team[:label] %></span>
          </div>
        <% end %>
      </div>
      <% if @fizz_palette_source == :candy %>
        <p class="text-muted text-xs">No teams carry both brand colors in this database, so these are the built-in candy hues — the slot wiring is the same.</p>
      <% end %>
    </div>
  </section>

  <section class="space-y-3">
    <h2 class="text-heading text-lg font-bold">Live</h2>
    <p class="text-muted text-xs">Press and hold for two seconds — the real thing, end to end.</p>
    <div class="card p-6 space-y-3">
      <div style="max-width:18rem">
        <%= render "shared/hold_button", hold_id: "fizz-live", duration: 2000 %>
      </div>
      <button type="button" class="text-xs text-secondary underline" data-fizz-reset>Reset</button>
    </div>
  </section>
</div>

<script>
  (function() {
    function btn(id) { return document.querySelector('.hold-btn[data-hold-id="' + id + '"]'); }

    function paint() {
      document.querySelectorAll('[data-fizz-demo]').forEach(function(wrap) {
        var state = wrap.dataset.fizzState;
        if (!state) return;
        var el = btn(wrap.dataset.fizzDemo);
        if (el) el.classList.add(state);
      });
    }

    document.addEventListener('click', function(e) {
      var replay = e.target.closest('[data-fizz-replay]');
      if (replay) {
        var wrap = document.querySelector('[data-fizz-demo="' + replay.dataset.fizzReplay + '"]');
        var el = btn(replay.dataset.fizzReplay);
        if (!wrap || !el) return;
        el.classList.remove(wrap.dataset.fizzState);
        void el.offsetWidth; // force reflow so the one-shot animation re-runs
        el.classList.add(wrap.dataset.fizzState);
        return;
      }
      if (e.target.closest('[data-fizz-reset]')) {
        var live = btn('fizz-live');
        if (live) live.classList.remove('process', 'success', 'error', 'loading');
      }
    });

    document.addEventListener('turbo:load', paint);
    paint();
  })();
</script>
