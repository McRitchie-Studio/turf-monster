<%#
  Operator goal-entry console. Each fixture is a game-scorer controller reading
  its initial state from its game value; its buttons POST to
  Admin::GamesController (record_goal / remove_goal / complete_game) and redraw
  from the JSON the server returns (authoritative score + goal list). Recording a
  goal cascades to Game#score_affected_contests! → every OPEN contest on the slate
  re-scores + the /live page refreshes over ActionCable.
%>

<section data-controller="scoring-filter"
         data-action="turbo:before-cache@document->scoring-filter#reset game-scorer:changed->scoring-filter#update">
  <div class="flex items-center justify-between gap-3 mb-2">
    <h2 class="text-2xl font-bold text-heading">Goal Console</h2>
    <%= link_to "Admin hub →", admin_hub_path, class: "text-sm text-muted hover:text-heading" %>
  </div>
  <p class="text-sm text-muted mb-5">
    Record goals live as they happen — pick the minute, tap the team that scored.
    Every goal re-scores all open contests on the slate and pushes the live leaderboard.
  </p>

  <!-- Toolbar -->
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-5">
    <input type="search" placeholder="Filter by team…"
           data-scoring-filter-target="query" data-action="input->scoring-filter#update"
           class="input flex-1" autocomplete="off" />
    <label class="flex items-center gap-2 text-sm text-muted select-none cursor-pointer">
      <input type="checkbox" class="accent-violet-500"
             data-scoring-filter-target="hideDone" data-action="change->scoring-filter#update" />
      Hide finished
    </label>
  </div>

  <% if @games.empty? %>
    <%= render "components/empty_state", message: "No fixtures yet." %>
  <% else %>
    <div class="space-y-3">
      <% @games.each do |game| %>
        <%
          # A goal's team is always one of this game's two teams (both already
          # eager-loaded), so resolve its emoji from this map instead of
          # goal.team — a separate belongs_to that would fire a query per goal.
          # Unknown slug → nil emoji (pill just shows the minute).
          emoji_by_slug = { game.home_team_slug => game.home_team.emoji, game.away_team_slug => game.away_team.emoji }
          config = {
            slug: game.slug,
            homeScore: game.home_score, awayScore: game.away_score, status: game.status,
            homeSlug: game.home_team_slug, awaySlug: game.away_team_slug,
            homeName: game.home_team.name, awayName: game.away_team.name,
            homeEmoji: game.home_team.emoji, awayEmoji: game.away_team.emoji,
            goals: game.goals.sort_by { |g| [g.minute || 999, g.created_at] }.map { |g|
              { id: g.id, teamSlug: g.team_slug, teamEmoji: emoji_by_slug[g.team_slug], minute: g.minute }
            }
          }
          search = [game.home_team.name, game.away_team.name, game.home_team.short_name, game.away_team.short_name].compact.join(" ").downcase
        %>
        <div class="card p-4"
             data-search="<%= search %>"
             data-done="<%= game.status == "completed" %>"
             data-scoring-filter-target="card"
             data-controller="game-scorer"
             data-action="turbo:before-cache@document->game-scorer#reset"
             data-game-scorer-game-value="<%= config.to_json %>"
             data-game-scorer-final-class="bg-emerald-500/15 text-emerald-400"
             data-game-scorer-open-class="bg-violet-500/15 text-violet-300">

          <!-- Scoreline -->
          <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2 flex-1 min-w-0">
              <span class="text-xl"><%= game.home_team.emoji %></span>
              <span class="text-heading font-semibold truncate"><%= game.home_team.name %></span>
            </div>
            <div class="text-2xl font-extrabold text-violet tabular-nums px-3" data-game-scorer-target="score"></div>
            <div class="flex items-center gap-2 flex-1 min-w-0 justify-end text-right">
              <span class="text-heading font-semibold truncate"><%= game.away_team.name %></span>
              <span class="text-xl"><%= game.away_team.emoji %></span>
            </div>
          </div>

          <!-- Meta row -->
          <div class="flex items-center justify-between gap-2 mt-1.5 mb-3 text-xs text-muted">
            <span><%= game.kickoff_at.present? ? game.kickoff_at.strftime("%a %b %-d · %l:%M %p") : "TBD" %></span>
            <span class="px-2 py-0.5 rounded-full font-semibold" data-game-scorer-target="status"></span>
          </div>

          <!-- Goal entry -->
          <div class="flex items-stretch gap-2">
            <input type="number" min="1" max="130" placeholder="min'"
                   class="input w-20 text-center" data-game-scorer-target="minute control" />
            <button type="button" data-game-scorer-target="control"
                    data-action="game-scorer#addGoal" data-game-scorer-side-param="home"
                    class="btn-secondary flex-1 flex items-center justify-center gap-1.5 disabled:opacity-50">
              <span><%= game.home_team.emoji %></span>
              <span class="truncate">Goal · <%= game.home_team.short_name || game.home_team.name %></span>
            </button>
            <button type="button" data-game-scorer-target="control"
                    data-action="game-scorer#addGoal" data-game-scorer-side-param="away"
                    class="btn-secondary flex-1 flex items-center justify-center gap-1.5 disabled:opacity-50">
              <span><%= game.away_team.emoji %></span>
              <span class="truncate">Goal · <%= game.away_team.short_name || game.away_team.name %></span>
            </button>
          </div>

          <!-- Goal list -->
          <div class="flex flex-wrap gap-1.5 mt-3" hidden data-game-scorer-target="goals"></div>
          <%# One goal's pill; the controller clones it per goal and fills the marked parts. %>
          <template data-game-scorer-target="goalTemplate">
            <span class="inline-flex items-center gap-1 pl-2 pr-1 py-0.5 rounded-full bg-violet-500/10 text-xs">
              <span data-goal-emoji></span>
              <span class="text-muted tabular-nums"><span data-goal-minute></span><span data-goal-tick>&rsquo;</span></span>
              <button type="button" data-goal-remove data-game-scorer-target="control" data-action="game-scorer#removeGoal"
                      class="ml-0.5 w-4 h-4 rounded-full hover:bg-rose-500/30 text-rose-400 leading-none">&times;</button>
            </span>
          </template>

          <!-- Footer -->
          <div class="flex items-center justify-between gap-2 mt-3 pt-2.5 border-t border-subtle">
            <span class="text-xs text-rose-400" data-game-scorer-target="error"></span>
            <button type="button" data-game-scorer-target="complete" data-action="game-scorer#complete"
                    class="text-xs font-semibold text-muted hover:text-heading disabled:opacity-40"></button>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
