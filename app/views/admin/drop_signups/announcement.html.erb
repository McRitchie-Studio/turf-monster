<% content_for(:title, "Drop Announcement — Admin") %>

<%# The drop announcement, sent by hand. Top to bottom: who it goes to (the
    exact count), how far a send has got, the Send form, then the rendered
    emails. Send stays disabled until the drop time unless "Send early" is
    ticked; the server enforces both that and the typed count
    (DropAnnouncement#send!), the disabled button is only the courtesy. %>
<div class="max-w-7xl mx-auto py-8 px-4 space-y-6" data-test="admin-drop-announcement">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-heading text-2xl font-bold mb-1">Drop Announcement</h1>
      <p class="text-secondary text-sm">
        "<%= NextSlateDrop.display_label %> is live" to the <span class="font-mono"><%= @announcement.slate_key %></span> list.
        Drops <%= NextSlateDrop.drops_at_label %>. Manual only: nothing sends this but the button below.
      </p>
    </div>
    <%= link_to "Back to the list", admin_drop_signups_path, class: "btn btn-outline btn-sm" %>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-6 gap-3">
    <div class="card p-4 col-span-2">
      <p class="label-upper">Recipients now</p>
      <p class="font-mono text-2xl text-heading" data-test="announcement-recipient-count"><%= number_with_delimiter(@recipient_count) %></p>
      <p class="text-xs text-muted mt-1">On the list, not yet announced to, not unsubscribed.</p>
    </div>
    <% { "Claimed" => @progress.claimed, "Sent" => @progress.sent, "Queued" => @progress.queued,
         "Failed" => @progress.failed }.each do |label, value| %>
      <div class="card p-4">
        <p class="label-upper"><%= label %></p>
        <p class="font-mono text-2xl text-heading" data-test="announcement-<%= label.downcase %>"><%= number_with_delimiter(value) %></p>
      </div>
    <% end %>
  </div>
  <% if @progress.stranded.positive? %>
    <p class="text-sm text-danger" data-test="announcement-stranded">
      <%= pluralize(@progress.stranded, "row") %> claimed with no outbox record (the send died mid-way). They are NOT re-sent automatically; check ErrorLog.
    </p>
  <% end %>
  <% if @progress.claimed.positive? %>
    <p class="text-xs text-muted">
      Queued mail goes out through the email outbox; <%= link_to "refresh", admin_drop_signups_announcement_path, class: "underline" %> to watch Sent climb.
      Failed rows stay in the outbox for its retry.
    </p>
  <% end %>

  <div class="card p-5" x-data="{ early: false, typed: '' }">
    <%= form_with url: admin_drop_signups_announcement_path, method: :post, local: true,
          data: { turbo: false, test: "announcement-send-form" },
          html: { onsubmit: "return confirm('Send the drop announcement to #{@recipient_count} #{'address'.pluralize(@recipient_count)}? This cannot be undone.')" } do |f| %>
      <div class="flex flex-wrap items-end gap-4">
        <label class="block">
          <span class="block text-sm text-secondary mb-1">Type <strong class="font-mono text-heading"><%= @recipient_count %></strong> to confirm</span>
          <%= f.text_field :confirm_count, value: nil, inputmode: "numeric", autocomplete: "off",
                class: "input w-32 font-mono", "x-model": "typed", data: { test: "announcement-confirm-count" } %>
        </label>
        <% unless @dropped %>
          <label class="flex items-center gap-2 text-sm text-secondary">
            <%= f.check_box :send_early, { "x-model": "early", data: { test: "announcement-send-early" } }, "1", "0" %>
            Send early (it hasn't dropped yet)
          </label>
        <% end %>
        <%= f.submit "Send drop announcement", class: "btn btn-primary",
              data: { test: "announcement-send" },
              disabled: @recipient_count.zero?,
              ":disabled": "#{@recipient_count.zero?} || typed.trim() !== '#{@recipient_count}' || (#{!@dropped} && !early)" %>
      </div>
      <% unless @dropped %>
        <p class="text-xs text-muted mt-2">Before the drop the button stays disabled unless "Send early" is ticked.</p>
      <% end %>
    <% end %>
  </div>

  <% [["announcement", "Drop announcement"], ["confirmation", "Confirmation (sent on signup)"]].each do |kind, title| %>
    <div class="space-y-2">
      <h2 class="text-heading text-lg font-bold"><%= title %></h2>
      <%# One email per row until the screen fits two 600px emails side by side. %>
      <div class="grid 2xl:grid-cols-2 gap-4">
        <% [["new_player", "No account yet"], ["existing_player", "Has an account"]].each do |variant, caption| %>
          <div class="card p-2">
            <p class="label-upper px-2 py-1"><%= caption %></p>
            <iframe src="<%= admin_drop_signups_announcement_preview_path(email: kind, variant: variant) %>"
                    title="<%= title %>: <%= caption %>" class="w-full rounded bg-white" style="height: 560px; border: 0;"
                    data-test="announcement-preview-<%= kind %>-<%= variant %>"></iframe>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
