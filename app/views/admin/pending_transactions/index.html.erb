<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-heading">Treasury</h1>
    <% if @pending_count > 0 %>
      <span class="bg-primary text-white text-xs font-bold px-2 py-1 rounded-full"><%= @pending_count %> pending</span>
    <% end %>
  </div>

  <% if @pending.empty? %>
    <%= render "components/empty_state",
          message: "No treasury transactions yet.",
          detail:  "Multisig transactions requiring cosigning will appear here." %>
  <% else %>
    <%= render "shared/wallet_desktop_only_notice" %>

    <div class="space-y-3">
      <% @pending.each do |tx| %>
        <div class="card p-4">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="font-mono text-xs text-muted"><%= tx.slug %></span>
                <% case tx.status %>
                <% when "pending" %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-yellow-100 text-yellow-800">Pending</span>
                <% when "confirmed" %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">Confirmed</span>
                <% when "expired" %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">Expired</span>
                <% when "failed" %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-red-100 text-red-800">Failed</span>
                <% end %>
              </div>

              <p class="text-heading font-semibold">
                <%= tx.tx_type.titleize %>
                <% if tx.target %>
                  <span class="text-secondary font-normal">- <%= tx.target.try(:name) || tx.target.try(:slug) %></span>
                <% end %>
              </p>

              <div class="flex items-center gap-4 mt-1 text-xs text-muted">
                <span>Created <%= time_ago_in_words(tx.created_at) %> ago</span>
                <% if tx.cosigner_address.present? %>
                  <span>Cosigner: <span class="font-mono"><%= tx.cosigner_address[0..7] %>...</span></span>
                <% end %>
                <% if tx.tx_signature.present? %>
                  <span>TX: <a href="https://explorer.solana.com/tx/<%= tx.tx_signature %>?cluster=devnet" target="_blank" class="text-primary hover:text-primary-600 font-mono"><%= tx.tx_signature[0..11] %>...</a></span>
                <% end %>
              </div>

              <% if tx.metadata.present? %>
                <% meta = tx.parsed_metadata %>
                <% if meta["settlements"] %>
                  <div class="mt-2 text-xs text-muted">
                    <%= meta["settlements"].size %> settlement(s),
                    total payout: $<%= (meta["settlements"].sum { |s| s["payout"].to_i } / 1_000_000.0).round(2) %>
                  </div>
                <% end %>
                <% case tx.tx_type %>
                <% when "register_currency" %>
                  <div class="mt-2 text-xs text-muted">
                    Mint: <span class="font-mono"><%= meta["mint"] %></span><% if meta["kind"] %> · kind <%= meta["kind"] %><% end %>
                  </div>
                <% when "deactivate_currency" %>
                  <div class="mt-2 text-xs text-muted">Slot: <%= meta["currency_idx"] %></div>
                <% when "sweep_operator_revenue" %>
                  <div class="mt-2 text-xs text-muted">
                    Mint: <span class="font-mono"><%= meta["currency_mint"] %></span> ·
                    amount: <%= meta["amount"].to_i.zero? ? "all" : meta["amount"] %>
                  </div>
                <% when "cancel_contest" %>
                  <div class="mt-2 text-xs text-muted">
                    Refund creator: <span class="font-mono"><%= meta["creator"] %></span>
                  </div>
                <% end %>
              <% end %>
            </div>

            <div class="flex flex-col gap-2 flex-shrink-0" data-cosign-controls>
              <% if tx.pending? %>
                <%# HOW MANY SIGNATURES THIS ACTION NEEDS, stated before the
                    operator commits to signing. Six of these rose to three
                    under turf-vault v0.26 — the server signs as admin, and
                    every remaining slot is a Phantom wallet. A transaction one
                    signature short does not fail politely: five come back
                    6046 InsufficientSigners and settle_contest comes back
                    6047 CosignerDidNotSign, neither of which names a wallet.

                    `extras_needed` is the SAME call the server validates with,
                    never `required_signatures - 2`. That arithmetic is
                    governance-independent and the server's is not, so the two
                    disagreed on a v0.25 boot: the page asked for a second
                    wallet and #rebuild refused it 422. %>
                <% required = tx.required_signatures %>
                <% extras_needed = tx.extra_cosigners_needed %>
                <% if extras_needed.positive? && @eligible_extras.any? %>
                  <label class="text-xs text-base-content/70 flex flex-col gap-1">
                    <span>
                      Second Phantom wallet
                      <span class="opacity-60">(<%= required %> signatures required)</span>
                    </span>
                    <%# NOT a free-text field: the server re-validates against
                        the on-chain signer set either way, and a typed pubkey
                        that is one character off spends a build to be told
                        Unauthorized. %>
                    <select data-extra-cosigner
                            class="select select-bordered select-xs font-mono w-56">
                      <% @eligible_extras.each do |signer| %>
                        <option value="<%= signer %>"><%= signer.truncate(16) %></option>
                      <% end %>
                    </select>
                  </label>
                <% elsif extras_needed.positive? %>
                  <%# NO WALLET TO OFFER. Saying so, and disabling the button, is
                      the honest failure: an empty select would let the operator
                      click into a 422 that names a threshold rather than the
                      configuration that cannot meet it. %>
                  <p class="text-xs text-error max-w-56">
                    No second signer is available. This action needs <%= required %>
                    vault signatures and the configured signer set offers only the
                    admin key and <%= @primary_cosigner.truncate(12) %>.
                  </p>
                <% end %>

                <%# NEVER OFFER A BUTTON THAT CAN ONLY FAIL, AND SAY WHY IT IS OFF.
                    A throwaway console let Mr. McRitchie press Execute at 2 of 3
                    approvals and spend a transaction on a certain refusal; the
                    lesson is that a disabled control has to carry its reason or
                    it reads as a broken page.

                    The fee payer is the SERVER's admin key, not his wallet
                    (measured: account 0 of a built wire). `funded == false` means
                    that account is empty, and every one of these six
                    transactions would come back "Attempt to debit an account but
                    found no record of a prior credit" — which names no account.
                    `funded` NIL is a balance we could not READ, and must not
                    block: refusing to let him act on an RPC flake is its own
                    outage. %>
                <% blocked_reason =
                     if extras_needed.positive? && @eligible_extras.empty?
                       "No second vault signer is configured, so #{required} signatures cannot be collected."
                     elsif @fee_payer && @fee_payer[:funded] == false
                       "The server's fee payer (#{@fee_payer[:address].to_s.truncate(12)}) holds " \
                       "#{format('%.4f', @fee_payer[:balance_sol].to_f)} SOL and cannot pay the network fee."
                     end %>
                <% if blocked_reason %>
                  <p class="text-xs text-error max-w-56" data-cosign-blocked><%= blocked_reason %></p>
                <% end %>

                <%# THE ROSTER — Mr. McRitchie's own requirement: "easy to see
                    what's done and what's next". Rendered with the wallet the
                    select currently names; cosign.js repoints that row when he
                    changes the selection, and paints each row's state as the
                    signatures come in. %>
                <% if extras_needed.positive? %>
                  <%= render "signer_roster",
                             roster: Solana::CosignPlan.new(tx_type: tx.tx_type)
                                       .roster(extras: @eligible_extras.first(extras_needed),
                                               fee_payer: @fee_payer),
                             required_signatures: required %>
                <% end %>

                <%# The wire is NOT rendered into this button any more. It used to be,
                    and because the blockhash inside it aged from page-render
                    time, a second Co-sign click re-broadcast the same expired
                    bytes — which is why retrying never worked. cosignTransaction
                    now asks the server to build a fresh transaction at click
                    time, so there is no stale copy and no rush to approve.
                    That also retires the Rebuild button, whose only job was
                    refreshing that blockhash by hand. %>
                <button data-tx-slug="<%= tx.slug %>"
                        data-tx-label="<%= tx.tx_type.titleize %>"
                        onclick="cosignTransaction(this.dataset.txSlug, this.dataset.txLabel, collectExtraCosigners(this), this)"
                        data-desktop-only-action
                        <%= "disabled" if blocked_reason %>
                        class="btn btn-primary btn-sm">
                  Co-sign
                </button>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="json-debug mt-8">
    <pre><%= JSON.pretty_generate(@pending.map { |t| { slug: t.slug, type: t.tx_type, status: t.status, target: t.target_type, created: t.created_at } }) %></pre>
  </div>
</div>

<%# BROWSER-facing, so public_rpc_url — never the server RPC constant, which
    carries the provider api-key on mainnet. See Solana::Config. %>
<%# No #cosign-config here: this page's browser never talks to an RPC now.
    The server broadcasts the cosigned wire over the credentialed endpoint
    (Admin::PendingTransactionsController#broadcast). The vault_init and
    vault_state pages still render their own — they have separate inline
    flows that were not part of this fix. %>
