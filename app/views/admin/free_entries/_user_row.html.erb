<%# Single row in the free-entries admin table. Rendered as part of the
    initial /admin/free_entries page AND as part of each auto-loaded
    turbo-frame batch (see _page_frame.html.erb). Locals: `row` is the
    hash compute_user_data_for emits. %>
<% user = row[:user] %>
<tr class="border-b border-subtle/40 hover:bg-inset transition">
  <td class="px-4 py-3">
    <div class="flex items-center gap-2">
      <%= render "components/avatar", user: user, size: "sm" %>
      <div>
        <div class="text-heading font-semibold"><%= user.display_name %></div>
        <div class="font-mono text-[10px] text-muted"><%= user.truncated_solana %></div>
      </div>
    </div>
  </td>
  <%# seeds/level come from the denormalized users.seeds mirror — always
      accurate, shown even while the on-chain token list is warming. %>
  <td class="px-3 py-3 text-right font-mono"><%= row[:seeds] %></td>
  <td class="px-3 py-3 text-right font-mono"><%= row[:level] %></td>
  <%# minted/unconsumed/owed derive from the CACHE-FIRST entry-token list. On a
      cold cache the row is "loading" (a background job warms it) — show a muted
      "…" instead of a misleading 0. %>
  <td class="px-3 py-3 text-right font-mono"><%= row[:loading] ? tag.span("…", class: "text-muted", title: "Syncing on-chain data…") : row[:minted] %></td>
  <td class="px-3 py-3 text-right font-mono"><%= row[:loading] ? tag.span("…", class: "text-muted", title: "Syncing on-chain data…") : row[:unconsumed] %></td>
  <td class="px-3 py-3 text-right font-mono font-bold" style="<%= !row[:loading] && row[:owed] > 0 ? 'color: var(--color-cta);' : 'color: var(--color-text-muted);' %>"><%= row[:loading] ? tag.span("…", class: "font-normal", title: "Syncing on-chain data…") : row[:owed] %></td>
  <td class="px-4 py-3 text-right">
    <div class="inline-flex items-center justify-end gap-2">
      <%# Cold cache: don't offer a Mint on unverified counts — the background
          job is warming this row; a refresh surfaces the real owed. %>
      <% if row[:loading] %>
        <span class="text-muted text-xs">syncing…</span>
      <% end %>
      <% if !row[:loading] && row[:owed] > 0 %>
        <%= button_to admin_mint_free_entries_path(user_slug: user.slug),
                      class: "btn btn-success btn-sm",
                      form_class: "inline-block",
                      data: { turbo_confirm: "Mint #{row[:owed]} free #{'entry'.pluralize(row[:owed])} for #{user.display_name}?" } do %>
          Mint <%= row[:owed] %>
        <% end %>
      <% end %>
      <%# Claw-back. Offered on UNCONSUMED (what the user can still spend), not on
          `owed` — those are opposite directions: owed is what we still have to
          give, unconsumed is what we can still take back. A row can show both.
          Cold cache hides these for the same reason it hides Mint: never aim a
          destructive action at an unverified count.

          "Burn all" passes no count and the controller burns everything unspent;
          "Burn 1" takes the NEWEST, which is the one a fat-fingered grant just
          created. Both confirm first — a burn is irreversible, and unlike an
          over-mint it cannot be undone by clicking the other button. %>
      <% if !row[:loading] && row[:unconsumed] > 0 %>
        <%# btn-danger on BOTH, not just Burn all. --color-cta and --color-success
            are the same green in the live theme, so btn-outline here rendered
            pixel-identical to the benign "Act as" at rest and, on hover, to
            "Mint" 8px away. This is the app's only irreversible action; it does
            not get to look like the two safe buttons beside it. %>
        <%= button_to admin_burn_free_entries_path(user_slug: user.slug, count: 1),
                      class: "btn btn-danger btn-sm",
                      form_class: "inline-block",
                      data: { turbo_confirm: "Burn the newest unspent free entry for #{user.display_name}? This cannot be undone." } do %>
          Burn 1
        <% end %>
        <% if row[:unconsumed] > 1 %>
          <%# PASS THE COUNT THE OPERATOR IS SHOWN — this is what makes the
              confirm binding. row[:unconsumed] is CACHED (cache-first, up to 60s
              stale, and the page never auto-refreshes, so the window is however
              long the tab sits open), while the controller re-reads the chain
              LIVE. Sending no count made it fall through to `burnable.length`,
              so a token minted after render — a level-up sweep, a completed
              TokenPurchaseJob, another admin's "Mint All Owed" — was destroyed
              by an operator who agreed to burn a smaller number. Irreversible,
              and in the harmful direction.

              With the count sent, the controller's clamp(0, burnable.length)
              turns the confirmed number into a CEILING: burn everything you saw,
              never more, and still fewer if some were spent in the meantime. %>
          <%= button_to admin_burn_free_entries_path(user_slug: user.slug, count: row[:unconsumed]),
                        class: "btn btn-danger btn-sm",
                        form_class: "inline-block",
                        data: { turbo_confirm: "Burn ALL #{row[:unconsumed]} unspent free entries for #{user.display_name}? This cannot be undone." } do %>
            Burn all <%= row[:unconsumed] %>
          <% end %>
        <% end %>
      <% end %>
      <%# OPSEC-046: act-as entry point in the web2 console (the Lauren support
          workflow). Non-admins only — admins can't be impersonated. %>
      <% unless user.admin? %>
        <%= button_to "Act as", admin_impersonate_path(user.slug),
                      method: :post,
                      class: "btn btn-outline btn-sm",
                      form_class: "inline-block",
                      data: { turbo_confirm: "Act as #{user.display_name}? You'll browse the app as this user until you return." } %>
      <% end %>
      <%# The "nothing actionable" placeholder, so an admin's cell is never blank.
          It must track EVERY button above it or it contradicts them: admins get
          no "Act as", so before burn existed `owed <= 0` really did mean the cell
          was empty. It no longer does — an admin can hold unspent tokens with
          nothing owed — so the dash now also requires there to be nothing to
          burn. %>
      <% if !row[:loading] && row[:owed] <= 0 && row[:unconsumed] <= 0 && user.admin? %>
        <span class="text-muted text-xs">—</span>
      <% end %>
    </div>
  </td>
</tr>
