<% content_for(:title, "#{@experiment.name} — Experiments") %>

<div class="max-w-7xl mx-auto px-4 py-8 space-y-6" data-experiment="<%= @experiment.slug %>">
  <%= render "studio/page_header", title: @experiment.name, crumbs: studio_crumbs(parent: :admin_experiments),
        action: { label: "Edit", href: edit_admin_experiment_path(@experiment.slug) } %>
  <p class="text-secondary text-sm">
    <span class="font-mono"><%= @experiment.slug %></span> on
    <%= link_to @experiment.page_path, @experiment.page_path, target: "_blank", rel: "noopener", class: "font-mono text-primary hover:underline" %>
    · <%= @experiment.active? ? "Running" : "Paused" %>
    <% if @short_links.any? %>
      · short links: <% @short_links.each do |link| %><span class="font-mono">/l/<%= link.token %></span> <% end %>
    <% end %>
  </p>

  <%= render "admin/experiments/window_nav", window: @report.window,
             path_for: ->(key) { admin_experiment_path(@experiment.slug, days: key) } %>

  <%= render "admin/experiments/report_table", report: @report %>

  <section class="space-y-2">
    <h2 class="text-lg font-bold text-heading">Preview each variant</h2>
    <p class="text-secondary text-sm">Opening a preview puts this browser into that variant (it sets your cookie) and counts as one visit to it.</p>
    <ul class="flex flex-wrap gap-2">
      <% @experiment.variants.each do |variant| %>
        <li><%= link_to variant.display_name, "#{@experiment.page_path}?#{PageExperiment::VARIANT_PARAM}=#{variant.key}",
                  target: "_blank", rel: "noopener", class: "btn btn-outline btn-sm", data: { preview_variant: variant.key } %></li>
      <% end %>
    </ul>
  </section>
</div>
