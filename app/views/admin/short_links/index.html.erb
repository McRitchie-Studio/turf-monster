<% content_for(:title, "Short Links — Admin") %>

<div class="max-w-6xl mx-auto py-8 px-4 space-y-6">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      <h1 class="text-heading text-2xl font-bold mb-1">Short Links</h1>
      <p class="text-muted text-sm max-w-2xl">
        Campaign links for bios and posts. <span class="font-mono">/l/&lt;name&gt;</span> sends a click to its
        page tagged <span class="font-mono">?r=&lt;reference&gt;</span>, where it counts once per visitor per day.
        Disable a link instead of deleting it: one already printed keeps being clicked.
        Clicks are all time; <%= link_to "Referrals", admin_referrals_path, class: "text-primary hover:underline" %> has the funnel.
      </p>
    </div>
    <%= link_to "New Short Link", new_admin_short_link_path, class: "btn btn-success" %>
  </div>

  <%= render "admin/short_links/list", short_links: @short_links, clicks: @clicks %>
</div>
