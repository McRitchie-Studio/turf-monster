<%#
  "Connect Wallet" picker (reown-style). Mounted via the modal host's
  <template x-if="id==='wallet-connect'"> — so this MUST have a single root.

  Props (set by the opener):
    linkMode       — true when an account-linking flow (logged in)
    currentUserId  — bound into the SIWS message when linking (OPSEC-005)
    returnUrl      — where to go after a successful connect (the in-contest
                     flow passes the contest URL so the saved cart auto-enters;
                     standalone omits it and uses the server's redirect).

  Connect itself goes through window.solanaConnectAndVerify (inline in the
  layout) so this modal is self-contained in both the standalone and the
  in-contest (swapped-in) cases.
%>
<div x-data="{
       get props() { var c = $store.modals.current(); return (c && c.props) || {}; },
       wallets: [],
       installs: [
         { name: 'Phantom',  url: 'https://phantom.app/download' },
         { name: 'Solflare', url: 'https://solflare.com/download' },
         { name: 'Backpack', url: 'https://backpack.app/downloads' }
       ],
       connecting: false,
       picking: '',
       error: '',
       ageAttested: false,
       ageError: false,
       // Show the legal-age attestation for guests (a wallet connect is
       // create-or-login, so a brand-new wallet creates an account). Linking
       // flows and logged-in users skip it. Server-side enforcement in
       // SolanaSessionsController#verify is the boundary for NEW accounts.
       // Hard false when the attestation flag is off (checkbox parked) —
       // attested() then always passes.
       get needsAttestation() {
         if (!<%= AppFlags.age_attestation? %>) return false;
         var s = Alpine.store('session');
         return !this.props.linkMode && !(s && s.loggedIn);
       },
       attested() {
         if (!this.needsAttestation) return true;
         if (this.ageAttested) return true;
         this.ageError = true;
         return false;
       },
       init() {
         // Pre-check when the opener (auth card) already collected it.
         this.ageAttested = this.props.ageAttested === true;
         this.refresh();
         // Wallet Standard registration can land a tick after the module
         // loads — re-read once so a just-registered wallet still appears.
         var self = this;
         setTimeout(function() { if (!self.connecting) self.refresh(); }, 300);
       },
       refresh() {
         this.wallets = (window.walletProvider && window.walletProvider.available && window.walletProvider.available()) || [];
       },
       get isMobile() { return !!(window.walletProvider && window.walletProvider.isMobile && window.walletProvider.isMobile()); },
       hasWallet(name) {
         var n = ('' + name).toLowerCase();
         return (this.wallets || []).some(function(w) { return w.name && w.name.toLowerCase() === n; });
       },
       // Resolve a known install-brand name to its engine wallet-sprite symbol
       // suffix (studio-engine 0.20 _wallet_brand_sprite). The three install
       // rows are always known brands, so this always resolves; an unknown name
       // returns null → <use> paints nothing (detected rows never use this —
       // they keep the wallet's own Wallet-Standard icon).
       brandIcon(name) {
         var n = ('' + name).toLowerCase();
         return ['phantom', 'solflare', 'backpack'].indexOf(n) !== -1 ? n : null;
       },
       get missingInstalls() {
         var self = this;
         return this.installs.filter(function(i) { return !self.hasWallet(i.name); });
       },
       async pick(name) {
         if (this.connecting) return;
         if (!this.attested()) return;
         this.connecting = true; this.picking = name; this.error = '';
         try {
           var result = await window.solanaConnectAndVerify(name, { linkMode: this.props.linkMode, currentUserId: this.props.currentUserId, ageAttested: this.ageAttested });
           if (result && result.success) {
             if (typeof window.handleSolanaVerifySuccess === 'function') window.handleSolanaVerifySuccess(result);
             window.location.href = this.props.returnUrl || result.redirect || '/';
           } else {
             this.error = (result && result.error) || 'Verification failed.';
             this.connecting = false; this.picking = '';
           }
         } catch (e) {
           var msg = (e && e.code === 4001) ? 'Signature rejected' : ((e && e.message) || 'Connection failed');
           if (typeof parseSolanaError === 'function') msg = parseSolanaError(msg);
           this.error = msg; this.connecting = false; this.picking = '';
         }
       },
       deepLink() {
         if (!this.attested()) return;
         // The deep link round-trips through the Phantom app — stash the
         // attestation alongside the other phantom_dl_* keys so the callback
         // page can include it in the verify POST.
         try { localStorage.setItem('phantom_dl_age_attested', this.ageAttested ? '1' : '0'); } catch (e) {}
         if (typeof startPhantomDeepLink === 'function') {
           startPhantomDeepLink(this.props.linkMode || false, (this.props.linkMode && this.props.currentUserId) || null);
         }
       },
       // Back: from the in-contest flow (opened via swap from the auth modal),
       // slide back to the auth options; standalone just closes the picker,
       // revealing the page's Google / Solana / Email choices.
       back() {
         if (this.connecting) return;
         if (this.props.backTo === 'auth') {
           Alpine.store('modals').swap('auth',
             { step: 'credentials', submitting: null, formError: '', phantomError: '', googleError: '' },
             { direction: 'back' });
         } else {
           Alpine.store('modals').close();
         }
       }
     }"
     class="relative">

  <%# Wallet brand-icon sprite (studio-engine 0.20). Inline SVG <symbol> marks
      for the known install brands, referenced by the install rows below via
      <use href="#se-wallet-…">. MUST live inside this picker's single root so
      the host's <template x-if="id==='wallet-connect'"> clones it with the card
      (a sibling of the root would be dropped, painting empty icons). Replaces
      the former /wallet-phantom.png|/wallet-solflare.png|/wallet-backpack.png
      app assets. %>
  <%= render "studio/modals/blocks/wallet_brand_sprite" %>

  <div class="relative mb-4">
    <h3 class="text-heading font-bold text-lg text-center pt-1">Connect Wallet</h3>
    <button @click="$store.modals.close()"
            class="absolute top-0 right-0 -mr-1 text-secondary hover:text-heading text-xl leading-none"
            aria-label="Close">&times;</button>
  </div>

  <%# Legal-age attestation — guests only (connect is create-or-login). %>
  <template x-if="needsAttestation">
    <div class="mb-3">
      <%= render "shared/age_attestation" %>
    </div>
  </template>

  <div class="space-y-2">
    <%# Detected wallets — INSTALLED, click to connect %>
    <template x-for="w in wallets" :key="w.name">
      <button type="button" @click="pick(w.name)" :disabled="connecting"
              class="w-full flex items-center gap-3 p-3 rounded-xl bg-surface-alt border border-strong hover:bg-surface transition text-left disabled:opacity-60 disabled:cursor-wait">
        <img :src="w.icon || '/solana-mark.svg'" alt="" class="w-9 h-9 rounded-lg">
        <span class="font-semibold text-heading" x-text="w.name"></span>
        <span class="ml-auto flex items-center gap-2">
          <span x-show="picking === w.name" class="inline-flex items-center gap-1.5 text-xs text-secondary"><span class="cta-spinner" aria-hidden="true"></span>Connecting…</span>
          <span x-show="picking !== w.name" class="badge border-primary text-primary">Installed</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-muted">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </span>
      </button>
    </template>

    <%# Featured wallets that aren't installed — open the install page %>
    <template x-for="i in missingInstalls" :key="i.name">
      <a :href="i.url" target="_blank" rel="noopener noreferrer"
         class="w-full flex items-center gap-3 p-3 rounded-xl bg-surface-alt border border-strong hover:bg-surface transition no-underline">
        <svg class="w-9 h-9" aria-hidden="true"><use :href="'#se-wallet-' + brandIcon(i.name)"></use></svg>
        <span class="font-semibold text-heading" x-text="i.name"></span>
        <span class="ml-auto flex items-center gap-2">
          <span class="text-xs text-muted uppercase tracking-wide">Install</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 text-muted">
            <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
          </svg>
        </span>
      </a>
    </template>

    <%# Mobile (no extension) — deep-link into the Phantom app %>
    <button x-show="isMobile" type="button" @click="deepLink()"
            class="w-full flex items-center gap-3 p-3 rounded-xl bg-surface-alt border border-strong hover:bg-surface transition text-left">
      <img src="/phantom-white.png" alt="" class="w-9 h-9 rounded-lg bg-violet p-1.5">
      <span class="font-semibold text-heading">Open in Phantom app</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="ml-auto w-4 h-4 text-muted">
        <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
      </svg>
    </button>
  </div>

  <template x-if="error">
    <p class="text-red-400 text-sm mt-3 text-center" x-text="error"></p>
  </template>

  <button type="button" @click="back()" :disabled="connecting"
          class="mt-4 w-full text-center text-sm text-secondary hover:text-heading disabled:opacity-50">
    &larr; Back
  </button>
</div>
