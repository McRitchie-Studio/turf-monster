<div x-data="{
       get props() { var c = $store.modals.current(); return (c && c.props) || {}; },
       busy: false,
       error: '',
       short(addr) {
         addr = addr || '';
         return addr.length > 12 ? (addr.slice(0, 6) + '...' + addr.slice(-4)) : addr;
       },
       async continueSwitch() {
         if (this.busy) return;
         this.busy = true;
         this.error = '';
         try {
           var store = Alpine.store('wallet');
           if (!store || !store.continueSwitch) throw new Error('Wallet switch helper is still loading.');
           await store.continueSwitch(this.props.newAddress);
         } catch (e) {
           this.busy = false;
           this.error = (e && e.message) || 'Could not continue with this wallet.';
         }
       }
     }">
  <%= render 'studio/modals/blocks/card_header',
        icon: :external_tab,
        title: 'Wallet changed' do %>
    It looks like you changed your wallet.
  <% end %>

  <div class="rounded-lg border border-subtle bg-surface-alt p-4 text-sm text-secondary mb-4 space-y-3">
    <p>
      Your current Turf Monster session belongs to
      <span class="text-heading font-mono" x-text="short(props.oldAddress)"></span>.
      Start a new session to continue with
      <span class="text-heading font-mono" x-text="short(props.newAddress)"></span>.
    </p>
    <p>
      <span x-text="props.providerLabel || 'Your wallet'"></span> will ask you to sign a message.
      This proves the wallet is yours and does not move funds.
    </p>
  </div>

  <p class="text-xs text-muted mb-4">
    Want to keep this session? Switch your wallet back to
    <span class="font-mono" x-text="short(props.oldAddress)"></span>.
  </p>

  <template x-if="error">
    <p class="text-sm text-red-300 mb-3" x-text="error"></p>
  </template>

  <div>
    <button type="button" class="btn btn-primary btn-lg w-full"
            :disabled="busy"
            :aria-busy="busy"
            @click="continueSwitch()">
      <span x-show="!busy">Start New Session</span>
      <span x-show="busy" class="inline-flex items-center gap-2">
        <span class="cta-spinner" aria-hidden="true"></span>
        Waiting for <span x-text="props.providerLabel || 'wallet'"></span>&hellip;
      </span>
    </button>
  </div>
</div>
