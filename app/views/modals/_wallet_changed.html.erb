<div x-data="{
       get props() { var c = $store.modals.current(); return (c && c.props) || {}; },
       busy: false,
       error: '',
       short(addr) {
         addr = addr || '';
         return addr.length > 12 ? (addr.slice(0, 6) + '...' + addr.slice(-4)) : addr;
       },
       async continueSwitch() {
         if (this.busy) return;
         this.busy = true;
         this.error = '';
         try {
           var store = Alpine.store('wallet');
           if (!store || !store.continueSwitch) throw new Error('Wallet switch helper is still loading.');
           await store.continueSwitch(this.props.newAddress);
         } catch (e) {
           this.busy = false;
           this.error = (e && e.message) || 'Could not continue with this wallet.';
         }
       }
     }">
  <%# No subtitle: it restated the title ("Wallet changed" / "It looks like you
      changed your wallet") and pushed the two addresses — the only facts the
      reader actually needs — further down the card. %>
  <%= render 'studio/modals/blocks/card_header',
        icon: :external_tab,
        title: 'Wallet changed' %>

  <%# THE TWO ADDRESSES ARE THE MESSAGE: which session you hold, and which
      wallet Phantom is now offering. They used to sit inside a sentence, which
      is the one place a base58 address cannot be read at a glance — the eye has
      to parse prose to find the part that matters. Labelled rows instead, with
      the direction of the handoff drawn between them, so the card answers
      "from what, to what" before it is read. %>
  <div class="rounded-lg border border-subtle bg-surface-alt p-4 mb-4">
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-xs uppercase tracking-wide text-muted">Session</span>
      <span class="text-sm text-heading font-mono" x-text="short(props.oldAddress)"></span>
    </div>
    <%# Decorative: the labels already carry the direction for a screen reader. %>
    <div class="flex justify-center py-1.5" aria-hidden="true">
      <svg class="w-4 h-4 text-muted" fill="none" viewBox="0 0 24 24"
           stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
    <div class="flex items-baseline justify-between gap-3">
      <span class="text-xs uppercase tracking-wide text-muted">Wallet</span>
      <span class="text-sm text-heading font-mono" x-text="short(props.newAddress)"></span>
    </div>
  </div>

  <p class="text-sm text-secondary mb-4">
    <span x-text="props.providerLabel || 'Your wallet'"></span> will ask you to sign.
    This proves the wallet is yours &mdash; it does not move funds.
  </p>

  <template x-if="error">
    <p class="text-sm text-red-300 mb-3" x-text="error"></p>
  </template>

  <div>
    <button type="button" class="btn btn-primary btn-lg w-full"
            :disabled="busy"
            :aria-busy="busy"
            @click="continueSwitch()">
      <span x-show="!busy">Start New Session</span>
      <span x-show="busy" class="inline-flex items-center gap-2">
        <span class="cta-spinner" aria-hidden="true"></span>
        Waiting for <span x-text="props.providerLabel || 'wallet'"></span>&hellip;
      </span>
    </button>

    <%# The way OUT of a card that cannot be dismissed. It sits under the action
        it is the alternative to, rather than above it where it read as a
        caption on the addresses. %>
    <p class="text-xs text-muted mt-3 text-center">
      To keep this session, switch
      <span x-text="props.providerLabel || 'your wallet'"></span> back to
      <span class="font-mono" x-text="short(props.oldAddress)"></span>.
    </p>
  </div>
</div>
