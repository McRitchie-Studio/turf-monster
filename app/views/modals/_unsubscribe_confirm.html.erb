<%#
  ENGINE STATUS (studio-engine 0.113.0.rc1, measured 2026-10-24
  (turf-readopts-engine-modals)): KEPT. The engine's newsletter-unsubscribe card is
  the nearest match, but its subtitle differs and it lacks the spinner, the inline
  error line and the swap to unsubscribe-goodbye. The engine newsletter modals
  (studio/profiles/_newsletter_modals) are NOT a drop-in:
    - they answer to $store.profileModals, not the app host's $store.modals;
    - they post a plain form (turbo off, full reload) to the engine's
      profile_newsletter_path, while this app posts JSON to its own
      newsletter_subscribe_path / newsletter_unsubscribe_path and applies the
      25-seed StateFanout and the newsletter-state-changed event in place;
    - they register only newsletter-email and newsletter-unsubscribe: the engine
      has no subscribe card with a consent box, no Subscribed! beat and no goodbye
      beat, and its copy differs.
  Engine follow-up: newsletter modals that take modal_store, a JSON submit mode
  with a success hook, and optional subscribe / success / goodbye cards with
  app copy. Until then this card stays here.
%>
<%# unsubscribe-confirm — confirm leaving the newsletter. Opened from the
    /account newsletter card ("Unsubscribe"). POSTs newsletter_unsubscribe_path;
    on success swaps to the unsubscribe-goodbye beat. The bottom Close link is the
    "never mind, keep me subscribed" out. SINGLE root; x-data double-quoted so
    everything inside is single-quoted. %>
<div x-data="{
       saving: false,
       error: null,
       url: '<%= newsletter_unsubscribe_path %>',
       async unsubscribe() {
         if (this.saving) return;
         this.saving = true;
         this.error = null;
         try {
           var csrf = (document.querySelector('meta[name=csrf-token]') || {}).content || '';
           var fetcher = window.authedFetch || window.fetch;
           var resp = await fetcher(this.url, {
             method: 'POST',
             headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrf, 'Accept': 'application/json' }
           });
           if (!resp) { this.saving = false; return; }
           var data = await resp.json();
           if (!data.success) throw new Error(data.error || 'Could not unsubscribe.');
           try { window.dispatchEvent(new CustomEvent('newsletter-state-changed', { detail: { subscribed: false } })); } catch (e) {}
           this.$store.modals.swap('unsubscribe-goodbye');
         } catch (e) {
           this.error = (e && e.message) || 'Could not unsubscribe.';
           this.saving = false;
         }
       }
     }">
  <%= render "studio/modals/blocks/card_header",
        size: :lg,
        icon: :error,
        title: "Unsubscribe?",
        subtitle: "Are you sure? You'll stop getting sports news and contest updates." %>

  <p x-show="error" x-cloak role="alert" aria-live="assertive" aria-atomic="true"
     x-text="error" class="text-xs mb-3 text-center text-danger-ink"></p>

  <button type="button" @click="unsubscribe()" :disabled="saving"
          class="btn btn-danger btn-lg w-full disabled:opacity-50 disabled:cursor-not-allowed">
    <span x-show="!saving">Unsubscribe</span>
    <span x-show="saving" x-cloak class="inline-flex items-center justify-center gap-2">
      <span class="cta-spinner" aria-hidden="true"></span>Unsubscribing…
    </span>
  </button>

  <button type="button" @click="$store.modals.close()"
          class="block mx-auto mt-3 text-sm text-secondary hover:text-heading transition">
    Close
  </button>
</div>
