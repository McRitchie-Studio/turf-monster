<%# Body only — branded_mailer supplies the banner, card and footer. %>

<p style="margin:0 0 20px;font-size:17px;line-height:1.6;color:#1f2a1c;">
  <strong><%= @sender_name %></strong> just gave you a <strong>free entry</strong> to Turf Monster.
</p>

<% if @note %>
  <%# The sender's own words, quoted. Kept visually distinct from our copy so it
      reads as a note from a person rather than as marketing we wrote. %>
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:0 0 24px;">
    <tr>
      <td style="border-left:3px solid #4BAF50;padding:4px 0 4px 16px;font-size:15px;line-height:1.6;color:#3f4a3c;font-style:italic;">
        <%= @note %>
      </td>
    </tr>
  </table>
<% end %>

<p style="margin:0 0 28px;font-size:15px;line-height:1.6;color:#3f4a3c;">
  <% if @contest %>
    No card, no deposit — the entry is already paid for. Tap below and you'll land on
    <strong style="color:#1f2a1c;"><%= @contest.name %></strong> with your account set up.
  <% else %>
    No card, no deposit — the entry is already paid for. Tap below and your account is set up.
  <% end %>
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;">
  <tr><td align="center" bgcolor="#4BAF50" style="border-radius:10px;">
    <a href="<%= @claim_url %>" style="display:inline-block;padding:16px 40px;font-size:17px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Claim your free entry 🎟️</a>
  </td></tr>
</table>

<p style="margin:28px 0 0;font-size:13px;line-height:1.5;color:#6b756a;text-align:center;">
  This link is for <strong style="color:#2f3a2c;"><%= @gift.recipient_email %></strong>, sets up your
  account in one tap, and can only be used once.
</p>

<p style="margin:24px 0 0;font-size:12px;line-height:1.4;color:#8a948a;text-align:center;">
  Button not working? Copy and paste this link:<br>
  <a href="<%= @claim_url %>" style="font-size:9px;line-height:1.3;color:#3d8b40;word-break:break-all;"><%= @claim_url %></a>
</p>

<p style="margin:28px 0 0;font-size:12px;line-height:1.5;color:#8a948a;text-align:center;">
  Not expecting this? You can safely ignore this email — nothing has been set up in your name.
</p>

<p style="margin:20px 0 0;font-size:13px;color:#6b756a;text-align:center;">— <%= @sender_name %>, via Turf Monster</p>
