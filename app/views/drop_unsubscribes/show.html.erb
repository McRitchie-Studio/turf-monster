<% content_for(:title, "Unsubscribe — Turf Monster") %>
<%# GET: the page a person lands on from the email's Unsubscribe link. The form
    AUTO-SUBMITS on load (the auto-submit controller), so their one click is the
    whole act; a no-JS scanner that only GETs never runs it and unsubscribes
    nobody. The button is the no-JS / slow-network fallback. See
    DropUnsubscribesController. %>
<div class="max-w-md mx-auto py-16 px-4 text-center" data-test="drop-unsubscribe">
  <h1 class="text-heading text-2xl font-bold mb-3">Unsubscribing…</h1>
  <p class="text-secondary mb-6">Taking <span class="font-mono"><%= @signup.email %></span> off the <%= NextSlateDrop.display_label %> list.</p>
  <%= button_to "Unsubscribe", drop_unsubscribe_confirm_path(token: @token), method: :post,
        class: "btn btn-primary", form: { id: "drop-unsubscribe-form", data: { turbo: "false", controller: "auto-submit" } } %>
</div>
