<%# Body only — branded_mailer supplies the banner, card and footer. %>

<p style="margin:0 0 20px;font-size:17px;line-height:1.6;color:#1f2a1c;">
  Your <strong>free entry</strong> is in your Turf Monster account.
</p>

<p style="margin:0 0 28px;font-size:15px;line-height:1.6;color:#3f4a3c;">
  <% if @contest %>
    Make your picks in <strong style="color:#1f2a1c;"><%= @contest.name %></strong>
    and submit before the contest locks<% if (lock_time = claim_lock_time(@contest)) %> on <strong style="color:#1f2a1c;"><%= lock_time %></strong><% end %>.
    The entry is already paid for.
  <% else %>
    Pick a contest, make your picks and submit. The entry is already paid for.
  <% end %>
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto;">
  <tr><td align="center" bgcolor="<%= Studio.theme_primary %>" style="border-radius:10px;">
    <a href="<%= @contest_url %>" style="display:inline-block;padding:16px 40px;font-size:17px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:10px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">Make your picks</a>
  </td></tr>
</table>

<p style="margin:24px 0 0;font-size:12px;line-height:1.4;color:#8a948a;text-align:center;">
  Button not working? Copy and paste this link:<br>
  <a href="<%= @contest_url %>" style="font-size:11px;line-height:1.3;color:#3d8b40;word-break:break-all;"><%= @contest_url %></a>
</p>
