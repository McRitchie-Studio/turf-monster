<%# Rotating-blob splash background — adapted from a CodePen by Ksenia Kondrashova
    (dev.to/uuuuuulala), recoloured to the Turf Monster brand palette.
    A dark splash: the blobs glow on the dark page colour, light text on top. %>
<style>
  @keyframes lp-blob-rotate {
    0%   { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  .lp-blobs { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
  .lp-blobs svg { width: 100%; height: 100%; display: block; }
  .lp-blobs .out-top, .lp-blobs .in-top,
  .lp-blobs .out-bottom, .lp-blobs .in-bottom { transform-box: view-box; }
  .lp-blobs .out-top    { animation: lp-blob-rotate 20s linear infinite; transform-origin: 13px 25px; }
  .lp-blobs .in-top     { animation: lp-blob-rotate 10s linear infinite; transform-origin: 13px 25px; }
  .lp-blobs .out-bottom { animation: lp-blob-rotate 25s linear infinite; transform-origin: 84px 93px; }
  .lp-blobs .in-bottom  { animation: lp-blob-rotate 15s linear infinite; transform-origin: 84px 93px; }
  /* Dark wash so the blobs read as deep glows and the light text stays legible. */
  .lp-blob-scrim { position: fixed; inset: 0; z-index: 0; background: rgba(13, 11, 30, 0.62); }
  /* .lp-splash text overrides live in app/assets/tailwind/application.css @layer utilities. */
  @media (prefers-reduced-motion: reduce) {
    .lp-blobs .out-top, .lp-blobs .in-top,
    .lp-blobs .out-bottom, .lp-blobs .in-bottom { animation: none; }
  }
</style>

<%# bg-page = the theme page colour — dark, since the splash forces dark theme.
    Blob fills use the brand palette: violet accent, green, mint, warning orange.
    The green is the BRIGHT #4BAF50 on purpose, not the theme primary #2E7D32.
    The blobs are glows under a 62 percent dark scrim: there the bright green
    stands 1.86:1 off the page and the darker primary only 1.43:1. %>
<div class="lp-blobs bg-page" aria-hidden="true">
  <svg preserveAspectRatio="xMidYMid slice" viewBox="10 10 80 80">
    <path fill="#8E82FE" class="out-top" d="M37-5C25.1-14.7,5.7-19.1-9.2-10-28.5,1.8-32.7,31.1-19.8,49c15.5,21.5,52.6,22,67.2,2.3C59.4,35,53.7,8.5,37-5Z"/>
    <path fill="#4BAF50" class="in-top" d="M20.6,4.1C11.6,1.5-1.9,2.5-8,11.2-16.3,23.1-8.2,45.6,7.4,50S42.1,38.9,41,24.5C40.2,14.1,29.4,6.6,20.6,4.1Z"/>
    <path fill="#06D6A0" class="out-bottom" d="M105.9,48.6c-12.4-8.2-29.3-4.8-39.4.8-23.4,12.8-37.7,51.9-19.1,74.1s63.9,15.3,76-5.6c7.6-13.3,1.8-31.1-2.3-43.8C117.6,63.3,114.7,54.3,105.9,48.6Z"/>
    <path fill="#FF7C47" class="in-bottom" d="M102,67.1c-9.6-6.1-22-3.1-29.5,2-15.4,10.7-19.6,37.5-7.6,47.8s35.9,3.9,44.5-12.5C115.5,92.6,113.9,74.6,102,67.1Z"/>
  </svg>
</div>
<div class="lp-blob-scrim" aria-hidden="true"></div>
