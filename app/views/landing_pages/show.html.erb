<% page_title = @landing_page.headline.presence || @landing_page.name %>
<% content_for :title, "#{page_title} — Turf Monster" %>
<%# Drive the unfurl metadata through the layout's canonical og/twitter tags
    (title from :title, description from :meta_description, image from the
    default landscape og.png with width/height). Emitting og:title/og:type/
    og:image here too would duplicate those tags and pin a stale image. %>
<% content_for :meta_description, @landing_page.subheadline if @landing_page.subheadline.present? %>

<%= render "landing_pages/backgrounds/#{@landing_page.background_partial}" %>

<div class="lp-splash relative z-10 min-h-screen flex flex-col items-center px-4 py-8">
  <% unless @landing_page.active? %>
    <div class="w-full max-w-lg mb-4 rounded-lg bg-yellow-500/15 border border-yellow-500/40 text-yellow-300 text-xs font-semibold px-3 py-2 text-center">
      Preview — this landing page is inactive and not visible to the public.
    </div>
  <% end %>

  <div class="w-full max-w-lg">
    <%# Brand %>
    <%= link_to root_path, class: "flex items-center justify-center gap-2 mb-8" do %>
      <%= brand_logo px: 40, classes: "w-10 h-10 shadow-lg" %>
      <span class="text-xl font-extrabold tracking-tight"><span class="text-heading">Turf</span><span class="text-primary">Monster</span></span>
    <% end %>

    <%# Hero %>
    <div class="text-center mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-heading leading-tight mb-3"><%= page_title %></h1>
      <% if @landing_page.subheadline.present? %>
        <p class="text-secondary text-lg"><%= @landing_page.subheadline %></p>
      <% end %>
      <% if @landing_page.badge.present? %>
        <div class="mt-3">
          <span class="lp-badge inline-block px-3 py-1 rounded-full bg-violet/20 text-violet border border-violet/30 text-xs font-bold uppercase tracking-widest"><%= @landing_page.badge %></span>
        </div>
      <% end %>
    </div>

    <%# Contest snapshot + CTA %>
    <% if @contest %>
      <div class="card p-6 mb-6">
        <p class="text-muted text-[10px] uppercase tracking-widest text-center mb-1">The Contest</p>
        <p class="text-heading text-xl font-bold text-center mb-5"><%= @contest.name %></p>

        <div class="grid grid-cols-3 gap-3 text-center mb-5">
          <div>
            <p class="font-mono text-2xl font-bold text-heading"><%= @contest.entry_fee_cents.to_i.zero? ? "Free" : "$#{@contest.entry_fee_dollars.to_i}" %></p>
            <p class="text-muted text-[10px] uppercase tracking-wide">Entry</p>
          </div>
          <div>
            <p class="font-mono text-2xl font-bold text-primary">$<%= @contest.guaranteed_prize_dollars.to_i %></p>
            <p class="text-muted text-[10px] uppercase tracking-wide">Prizes</p>
          </div>
          <div>
            <p class="font-mono text-2xl font-bold text-heading"><%= @contest.active_entry_count %>/<%= @contest.max_entries %></p>
            <p class="text-muted text-[10px] uppercase tracking-wide">Entries</p>
          </div>
        </div>

        <%# The time the "Contest Locks" step below points at. lock_time_display
            reads starts_in_at, the same attribute Contest#locks_at reads, so
            this line and that sentence can never name different moments.
            data-test scopes the guard in turf_totals_lock_rule_test.rb. %>
        <p class="text-secondary text-xs text-center mb-5" data-test="funnel-lock-time"><%= @contest.lock_time_display %></p>

        <%= link_to @landing_page.cta_label_display, contest_path(@contest.slug, scroll: 280),
              class: "btn btn-primary btn-lg w-full shadow-lg shadow-primary/20",
              target: "_blank", rel: "noopener" %>
      </div>
    <% else %>
      <div class="card p-6 mb-6 text-center">
        <p class="text-secondary mb-4">The contest for this page is being set up — check back soon.</p>
        <span class="btn btn-primary btn-lg w-full opacity-50 cursor-not-allowed">Contest coming soon</span>
      </div>
    <% end %>

    <%# How it works %>
    <div class="mb-8" data-test="funnel-how-it-works">
      <p class="text-muted text-[10px] uppercase tracking-widest text-center mb-4">How it works</p>
      <div class="space-y-3">
        <% funnel_how_it_works(@contest).each_with_index do |(title, body), i| %>
          <div class="flex items-start gap-3">
            <span class="flex-shrink-0 w-7 h-7 rounded-full bg-primary/15 text-primary font-bold text-sm flex items-center justify-center"><%= i + 1 %></span>
            <div>
              <p class="text-heading font-semibold text-sm"><%= title %></p>
              <p class="text-muted text-xs"><%= body %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# Footer %>
    <p class="text-center text-muted text-xs" data-test="funnel-footer">
      <% if @contest&.world_cup_survivor? %>
        New here?
        <%= link_to "Visit the Help Center", help_path, target: "_blank", rel: "noopener", class: "text-primary hover:text-primary-300 underline underline-offset-2" %>
      <% else %>
        New to Turf Monster?
        <%# DERIVED, never hardcoded: turf-totals-v1 is the World Cup rulebook and
            turf-monster-v1 the NFL one (routes.rb - one page per SEASON, not per
            brand). The sport comes off the contest slate, so each audience opens
            its own book. See LandingPagesHelper.funnel_rulebook_path. %>
        <%= link_to "See how it works", funnel_rulebook_path(@contest), target: "_blank", rel: "noopener", class: "text-primary hover:text-primary-300 underline underline-offset-2" %>
      <% end %>
    </p>
  </div>
</div>
