<section>
  <div class="mb-6">
    <%= link_to "&larr; All Teams".html_safe, teams_path, class: "text-secondary hover:text-heading text-sm transition" %>
  </div>

  <div class="card p-6 mb-6">
    <div class="flex items-center gap-4 mb-4">
      <span class="text-4xl"><%= @team.emoji %></span>
      <div>
        <h2 class="text-2xl font-bold text-heading"><%= @team.name %></h2>
        <div class="flex items-center gap-3 mt-1">
          <% if @team.short_name.present? %>
            <span class="text-sm text-secondary font-mono"><%= @team.short_name %></span>
          <% end %>
          <% if @team.location.present? %>
            <span class="text-sm text-muted"><%= @team.location %></span>
          <% end %>
          <% if @team.league.present? %>
            <span class="text-sm text-muted"><%= [@team.league.upcase, @team.conference, @team.division].compact.join(" · ") %></span>
          <% end %>
        </div>
      </div>
      <%# Brand palette by intrinsic lightness: 🌒 dark · 🌖 dark alt · 🔆 light ·
          🔅 light alt · ✳️ alt · 🩶 grey. Slots show only when the team curates them. %>
      <div class="ml-auto flex items-center gap-1.5">
        <% [["🌒", @team.color_dark], ["🌖", @team.color_dark_alt], ["🔆", @team.color_light], ["🔅", @team.color_light_alt], ["✳️", @team.color_alt], ["🩶", @team.color_grey]].each do |emoji, hex| %>
          <% if hex.present? %>
            <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center text-[9px] leading-none"
                 style="background-color: <%= hex %>" title="<%= emoji %> <%= hex %>"><span class="opacity-80"><%= emoji %></span></div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @team.home_arena.present? || @team.hashtag.present? || @team.x_handle.present? %>
    <div class="card p-4 mb-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <% if @team.home_arena.present? %>
          <div>
            <p class="text-xs text-muted uppercase tracking-wide">Home Arena</p>
            <p class="text-heading font-semibold"><%= @team.home_arena.name %></p>
            <p class="text-xs text-muted"><%= @team.home_arena.location %></p>
          </div>
        <% end %>
        <% if @team.hashtag.present? %>
          <div>
            <p class="text-xs text-muted uppercase tracking-wide">Hashtag</p>
            <p class="text-heading font-mono"><%= [@team.hashtag, @team.hashtag2].compact.join(" ") %></p>
          </div>
        <% end %>
        <% if @team.x_handle.present? %>
          <div>
            <p class="text-xs text-muted uppercase tracking-wide">X</p>
            <p class="text-heading font-mono">@<%= @team.x_handle %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @team.players.any? %>
    <div class="mb-6">
      <h3 class="text-lg font-bold text-heading mb-3">Players (<%= @team.players.count %>)</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
        <% @team.players.order(:name).each do |player| %>
          <div class="card p-3 flex items-center gap-3">
            <% if player.jersey_number.present? %>
              <span class="text-violet-500 font-bold font-mono text-sm w-6 text-right">#<%= player.jersey_number %></span>
            <% end %>
            <div class="flex-1 min-w-0">
              <p class="text-heading text-sm font-semibold truncate"><%= player.name %></p>
              <% if player.position.present? %>
                <p class="text-muted text-xs"><%= player.position %></p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# NFL roster from the seeded player database, grouped by position. Capped
      at a preview here; the full roster lives on /nfl-players. %>
  <%# Loaded once: .any?/.size/.first(12) on an Array beats three queries. %>
  <% roster = @team.athletes.includes(:person, :team, :image_caches).in_roster_order.to_a %>
  <% if roster.any? %>
    <div class="mb-6">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-lg font-bold text-heading">Roster (<%= roster.size %>)</h3>
        <%= link_to "View all →", nfl_players_path(team: @team.slug), class: "text-sm text-secondary hover:text-primary" %>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        <%= render partial: "nfl_players/athlete_card", collection: roster.first(12), as: :athlete %>
      </div>
    </div>
  <% end %>

  <% games = (@team.home_games + @team.away_games).sort_by(&:kickoff_at) %>
  <% if games.any? %>
    <div class="mb-6">
      <h3 class="text-lg font-bold text-heading mb-3">Games (<%= games.count %>)</h3>
      <div class="space-y-2">
        <% games.each do |game| %>
          <div class="card p-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-sm"><%= game.home_team&.emoji %></span>
              <span class="text-heading text-sm font-semibold"><%= game.home_team&.short_name || game.home_team_slug %></span>
              <span class="text-muted text-xs">vs</span>
              <span class="text-heading text-sm font-semibold"><%= game.away_team&.short_name || game.away_team_slug %></span>
              <span class="text-sm"><%= game.away_team&.emoji %></span>
            </div>
            <div class="text-right">
              <p class="text-xs text-muted"><%= game.kickoff_at&.strftime("%b %d, %Y") %></p>
              <p class="text-xs text-muted"><%= game.venue %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= render "components/json_debug", record: @team %>
</section>
