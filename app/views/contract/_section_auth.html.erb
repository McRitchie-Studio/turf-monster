<%#
  Auth model: who signs what. The vault cards are DERIVED (ContractHelper):
  the signer count from Solana::Config::MULTISIG_SIGNERS (VaultState's set),
  each action's threshold from Solana::Governance (turf-vault v0.26 per-action
  thresholds), and the holders sentence from config/signer_roster.yml. A
  signer rotation or a threshold change moves this copy without an edit;
  test/views/contract_signer_names_test.rb pins the derivation.
%>
<section class="card p-6 sm:p-8 mb-6">
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:gap-4 mb-2">
    <h2 class="text-heading font-bold text-xl">Who can call what</h2>
    <span class="text-[11px] font-mono text-muted uppercase tracking-wider">signer matrix</span>
  </div>
  <p class="text-secondary text-sm mb-5 max-w-3xl">
    Each instruction is bound to one signer role and, for vault actions, a number of signatures
    &mdash; the contract refuses to execute when the wrong key signs or too few sign.
  </p>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">

    <%# INIT_AUTHORITY — one-time only %>
    <div class="bg-surface-alt border border-subtle border-t-2 border-t-warning rounded-lg p-4 sm:p-5">
      <div class="text-[10px] sm:text-xs uppercase tracking-wider text-secondary font-semibold mb-1">INIT_AUTHORITY</div>
      <div class="font-mono text-sm text-heading mb-3">Mr. McRitchie's Phantom key</div>
      <ul class="space-y-1 text-[12px] sm:text-[13px] text-secondary list-disc list-outside pl-4">
        <li>initialize <span class="text-muted">(once, ever)</span></li>
      </ul>
    </div>

    <%# One card per signature count, lowest first. %>
    <% tier_borders = { 1 => "border-t-violet", 2 => "border-t-primary" } %>
    <% vault_signer_tiers.each do |threshold, actions| %>
      <div class="bg-surface-alt border border-subtle border-t-2 <%= tier_borders.fetch(threshold, "border-t-danger") %> rounded-lg p-4 sm:p-5" data-test="signer-matrix-tier-<%= threshold %>">
        <div class="text-[10px] sm:text-xs uppercase tracking-wider text-secondary font-semibold mb-1"><%= threshold %> of <%= vault_signer_count %> vault signers</div>
        <div class="font-mono text-sm text-heading mb-3"><%= threshold == 1 ? "any one vault signer" : "#{threshold} distinct vault signers" %></div>
        <ul class="space-y-1 text-[12px] sm:text-[13px] text-secondary list-disc list-outside pl-4">
          <% actions.each do |action| %>
            <li data-test="signer-matrix-action"><%= action %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%# User wallet — Phantom or managed keypair %>
    <div class="bg-surface-alt border border-subtle border-t-2 border-t-mint rounded-lg p-4 sm:p-5">
      <div class="text-[10px] sm:text-xs uppercase tracking-wider text-secondary font-semibold mb-1">User wallet signs</div>
      <div class="font-mono text-sm text-heading mb-3">Phantom or managed keypair</div>
      <ul class="space-y-1 text-[12px] sm:text-[13px] text-secondary list-disc list-outside pl-4">
        <li>enter_contest</li>
        <li>enter_contest_with_token</li>
        <li>set_username</li>
        <li>create_user_account <span class="text-muted">(permissionless)</span></li>
      </ul>
    </div>

  </div>

  <p class="text-secondary text-[13px] mt-4 max-w-3xl" data-test="signer-matrix-members">
    There are <%= vault_signer_count %> vault signers: <%= vault_signer_holders_sentence %>.
    Moving a contest lock that has already passed, or amending a conclusion time already set, needs
    <%= vault_threshold("set_contest_lock_time_reopen") %> of them.
  </p>
</section>
