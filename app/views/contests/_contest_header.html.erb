<%
  creator_name = @creator&.display_name || "Turf Monster"
  entry_count  = @contest.active_entry_count
  max          = @contest.max_entries || @contest.format_config[:max_entries]
  # Only `active` entries are editable — `complete` (settled-contest) entries
  # show up in @my_active_entries but can't be modified.
  editable_entries = (@my_active_entries || []).select(&:active?)
  has_edit_items   = @contest.open? && editable_entries.any?
  has_admin_item   = current_user&.admin?
  show_dropdown    = has_edit_items || has_admin_item

  # Row 3's slate column: the league is the LABEL and the span is the VALUE
  # ("NFL" over "Weeks 1-3"). Slate#sport is the two-value column
  # ("nfl" | "fifa"); everything non-NFL in this app is the World Cup, and a
  # bare "FIFA" reads as a governing body rather than a competition.
  slate_sport = @contest.slate&.sport.to_s
  slate_label = slate_sport == "nfl" ? "NFL" : "World Cup"
  # Multi-week contests name their span ("Weeks 1-3"); the anchor slate name
  # alone would read as a single-week contest.
  slate_value = (@contest.multi_week? && @contest.week_span_label) || @contest.slate&.name
%>

<%# `data-contest-row` marks the four rows the operator's mobile mockup named.
    They are the addressable seam for test/views/contest_header_rows_test.rb —
    the utility classes alone are not (grid-cols-3 recurs several times on a
    rendered contest page). Renaming a row means updating that test. %>
<div class="mb-6">
  <%# Row 1 — the contest name. Sized up a step at every breakpoint: on mobile
      this is the card's header and it was reading the same weight as the stats
      row beneath it. %>
  <div data-contest-row="title" class="flex items-start justify-between gap-2">
    <h1 class="text-3xl md:text-4xl font-extrabold text-heading">
      <%= @contest.name %>
      <% if @contest.cancelled? %>
        <span class="align-middle inline-flex items-center px-2 py-0.5 rounded text-xs font-bold bg-red-100 text-red-800 uppercase tracking-wide">Cancelled</span>
      <% end %>
    </h1>

    <% if show_dropdown %>
      <div x-data="{ open: false }" @click.outside="open = false" class="relative flex-shrink-0">
        <button type="button" @click="open = !open"
                class="p-2 -m-2 rounded-md text-secondary hover:text-heading hover:bg-surface-alt transition"
                :aria-expanded="open"
                aria-label="Contest actions">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M10 3a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm0 5.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zM10 14a1.5 1.5 0 110 3 1.5 1.5 0 010-3z"/>
          </svg>
        </button>
        <div x-show="open" x-cloak
             x-transition:enter="transition ease-out duration-150"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-100"
             x-transition:leave-start="opacity-100 scale-100"
             x-transition:leave-end="opacity-0 scale-95"
             class="absolute right-0 mt-1 w-48 rounded-lg bg-surface border border-subtle shadow-lg py-1 z-30 origin-top-right">
          <% if has_edit_items %>
            <% editable_entries.each_with_index do |entry, idx| %>
              <% label = editable_entries.size > 1 ? "Edit Entry #{idx + 1}" : "Edit Entry" %>
              <%= link_to label, contest_path(@contest, edit_entry: entry.slug),
                    class: "block px-4 py-2 text-sm text-body hover:bg-surface-alt transition" %>
            <% end %>
          <% end %>
          <% if has_admin_item %>
            <% if has_edit_items %>
              <div class="border-t border-subtle my-1"></div>
            <% end %>
            <%= link_to "Edit Contest", edit_contest_path(@contest),
                  class: "block px-4 py-2 text-sm text-body hover:bg-surface-alt transition" %>
            <%= link_to "Admin View", admin_contest_path(@contest),
                  class: "block px-4 py-2 text-sm text-secondary hover:text-heading hover:bg-surface-alt transition" %>
            <%= link_to "Pending Transactions", admin_pending_transactions_path,
                  class: "block px-4 py-2 text-sm text-secondary hover:text-heading hover:bg-surface-alt transition" %>
            <% if @contest.locked? && !@contest.settled? %>
              <%= button_to "Grade", grade_contest_path(@contest), method: :post,
                    form_class: "block",
                    class: "block w-full text-left px-4 py-2 text-sm text-body hover:bg-surface-alt transition" %>
            <% end %>
            <% if @contest.open? && !@contest.locked? %>
              <%# Testing aid: schedule the lock 60s out (Phantom-signed) to watch the countdown engage. %>
              <button type="button"
                      onclick="lockContestViaPhantom('<%= @contest.slug %>', 60)"
                      class="block w-full text-left px-4 py-2 text-sm text-yellow-500 hover:bg-surface-alt transition">
                Lock in 60s
              </button>
            <% end %>
            <% unless @contest.concluded? || @contest.settled? %>
              <%# Testing aid: schedule the conclusion 60s out (Phantom-signed). %>
              <button type="button"
                      onclick="concludeContestViaPhantom('<%= @contest.slug %>', 60)"
                      class="block w-full text-left px-4 py-2 text-sm text-orange-500 hover:bg-surface-alt transition">
                Conclude in 60s
              </button>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Start countdown lives in the Row 3 meta grid below. Only the conclusion
      countdown floats free up here. %>
  <% if @contest.concludes_at.present? && !@contest.settled? %>
    <div class="flex flex-wrap items-center gap-2 mt-2">
      <%= render "contests/timestamp_countdown", target: @contest.concludes_at, label: "Concludes in", done_label: "🏁 Concluded", tone: "orange" %>
    </div>
  <% end %>

  <%
    show_start = @contest.starts_in_at.present? && !@contest.settled?
    # Row 3's grammar matches Row 2's: bold VALUE first, muted label after
    # ("Weeks 1-3 NFL", the same shape as "$500 Prizes"), inline at EVERY width
    # and on one baseline so the 10px label sits on the 12px value's.
    meta_cell  = "flex items-baseline gap-1.5 md:gap-2 min-w-0"
    meta_label = "text-[10px] font-medium text-muted shrink-0 leading-tight"
    meta_value = "text-xs font-bold text-heading truncate max-w-full leading-tight"
  %>

  <%# Rows 2 and 3 are ONE block with two layouts.

      Mobile — the two row wrappers go `display: contents`, so their six cells
      become direct items of THIS grid and the two rows share one set of tracks.
      That is what keeps the columns aligned. Equal thirds (grid-cols-3) does
      not work here: measured at 390px each third is 111px and "turf monster
      creator" needs 122, so the name clipped to "turf mon…". `auto auto 1fr`
      sizes the first two tracks to their content and gives the rest to the
      widest cell — 91 + 100 + the remainder, inside 358px, nothing clipped.

      md and up — side by side on one line, Row 3 to the RIGHT of Row 2: there
      is width to spare there, and the vertical stack was spending a whole row
      on reference detail. Both wrappers become flex containers again, so each
      hugs its own content instead of holding tracks. %>
  <div class="mt-3 grid grid-cols-[auto_auto_1fr] gap-x-3 gap-y-3
              md:flex md:flex-wrap md:items-baseline md:gap-x-8 md:gap-y-2">

    <%# Row 2 — the money line. The three figures a player decides on. No
        surface of its own: the type size (text-lg here vs text-xs in Row 3)
        carries the hierarchy, and an inset panel behind only these three read
        as a separate component. Divider pips went with it. %>
    <div data-contest-row="stats" class="contents md:flex md:items-baseline md:gap-6 md:shrink-0">
      <div class="whitespace-nowrap">
        <%# The prize pot is the headline number — it sweeps once every 10s to
            pull the eye back without animating continuously. See .prize-shimmer. %>
        <span class="prize-shimmer text-lg font-extrabold text-primary">$<%= @contest.guaranteed_prize_dollars.to_i %></span>
        <span class="text-xs text-muted ml-1">Prizes</span>
      </div>
      <div class="whitespace-nowrap">
        <span class="text-lg font-extrabold text-heading">$<%= @contest.entry_fee_dollars.to_i %></span>
        <span class="text-xs text-muted ml-1">Entry</span>
      </div>
      <div class="whitespace-nowrap">
        <span class="text-lg font-extrabold text-heading"><%= entry_count %>/<%= max %></span>
        <span class="text-xs text-muted ml-1">Entries</span>
      </div>
    </div>

    <%# Row 3 — the odds and ends, consolidated. Replaces the old
        "week span · creator" subtitle line above the title AND the start
        countdown that used to ride inside the stats row. %>
    <div data-contest-row="meta" class="contents md:flex md:items-baseline md:gap-6">
      <% if slate_value.present? %>
        <div class="<%= meta_cell %>">
          <span class="<%= meta_value %>"><%= slate_value %></span>
          <span class="<%= meta_label %>"><%= slate_label %></span>
        </div>
      <% end %>

      <% if show_start %>
        <%# Click the start countdown to reveal the exact start date as a tooltip. %>
        <div x-data="{ tip: false }" @click.outside="tip = false" class="relative min-w-0">
          <div role="button" tabindex="0" @click="tip = !tip" @keydown.enter.prevent="tip = !tip" @keydown.space.prevent="tip = !tip"
               class="cursor-pointer" aria-label="Show start time" :aria-expanded="tip">
            <%# shell_class hands the countdown the SAME cell shape as the two
                plain cells beside it; label_after puts its digits first to
                match them.
                max_units: 2 keeps it to "13d 19h" — four units is what pushed
                Row 3 onto a second line beside Row 2 at tablet width. %>
            <%= render "contests/timestamp_countdown", target: @contest.starts_in_at, label: "Starts in",
                  done_label: (@contest.turf_totals? ? "Watch Live" : "🔒 Entries closed"),
                  done_href: (@contest.turf_totals? ? live_contest_path(@contest) : nil),
                  tone: "yellow", on_done_modal: "it-begins", on_done_url: contest_path(@contest),
                  wrapper_class: "", shell_class: meta_cell, label_class: meta_label,
                  label_after: true, max_units: 2, emphasize: true, compact: true %>
          </div>
          <div x-show="tip" x-cloak
               x-transition:enter="transition ease-out duration-150"
               x-transition:enter-start="opacity-0 translate-y-1"
               x-transition:enter-end="opacity-100 translate-y-0"
               class="absolute left-0 top-full mt-1.5 z-30 whitespace-nowrap rounded-lg border border-subtle bg-surface px-3 py-1.5 text-xs font-medium text-secondary shadow-lg">
            <%= @contest.start_time_display %>
          </div>
        </div>
      <% end %>

      <div class="<%= meta_cell %>">
        <span class="<%= meta_value %>"><%= creator_name.downcase %></span>
        <span class="<%= meta_label %>">creator</span>
      </div>
    </div>
  </div>
</div>
