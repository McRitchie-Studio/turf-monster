<%# Final standings for a retired-format contest (Contest#retired_format?).
    Such a contest has no slate and no board, so its page reads only what
    grading wrote on each entry: rank, score and payout. Read-only, and the
    same in every viewer state. Callers: contests/show and
    ContestsController#leaderboard_poll; both pass compact: and viewer:. %>
<%
  contest = local_assigns.fetch(:contest, @contest)
  entries = local_assigns.fetch(:entries, @entries)
  viewer  = local_assigns.fetch(:viewer, nil)
%>
<section class="card overflow-hidden mb-8" data-final-standings>
  <div class="flex items-center justify-between px-4 py-3 border-b border-subtle">
    <h2 class="text-lg font-semibold text-body">Final standings</h2>
    <span class="text-xs text-muted"><%= pluralize(entries.size, "entry") %></span>
  </div>
  <p class="px-4 pt-3 text-xs text-muted">This contest ran a format Turf Monster no longer offers. Its results are kept here as a record.</p>

  <div class="p-3 space-y-2">
    <% if entries.empty? %>
      <p class="px-1 py-2 text-sm text-muted">No entries.</p>
    <% end %>
    <% entries.each_with_index do |entry, i| %>
      <% is_me = viewer && entry.user_id == viewer.id %>
      <div class="card overflow-hidden <%= is_me ? 'ring-1 ring-primary/40' : '' %>">
        <div class="flex items-center gap-3 px-4 py-3">
          <div class="w-7 text-center font-mono font-bold text-heading"><%= entry.rank || i + 1 %></div>
          <%= render "components/avatar", user: entry.user, size: "sm" %>
          <span class="font-semibold truncate text-sm flex-1 min-w-0 text-heading">
            <%= entry.user.display_name %><% if is_me %> <span class="text-primary text-xs">(you)</span><% end %>
          </span>
          <% if entry.payout_cents.to_i.positive? %>
            <span class="text-right font-mono text-sm flex-shrink-0 text-violet-ink"><%= dollars(entry.payout_cents / 100.0) %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
