<%# THE PLAY-BY-PLAY for one game — what is happening between the scores.
    Locals: game (Game).

    Rendered inside #game_<slug>_plays (contests/_live_focus owns that wrapper),
    which Contest::LiveBroadcast.plays_changed updates whenever the poller
    stores a new play. So this is pure content, with no outer id, and the whole
    list is redrawn each time: forty short rows is about 10KB, and a redraw
    cannot drift from what a fresh page load would show the way an appended row
    can.

    NEWEST FIRST, for the reason the scoring rail is: a feed that grows downward
    pushes the play you are waiting for out of a fixed-height box. A redraw
    also puts the scroller back at the top, which is where the new play is.

    A scheduled game has no plays and asks the database for none — this partial
    runs once per game in the week, and most of a week is not being played. %>
<%
  plays = game.status == "scheduled" ? [] : game.plays.newest_first.limit(GamePlay::FEED_LIMIT).to_a
  # What marks a play that is not an ordinary snap. Inline colours, not
  # utilities: these four are the feed's whole vocabulary and must not depend
  # on which classes the last stylesheet build happened to scan.
  kind_ink = {
    "score"    => "#4ade80",
    "turnover" => "#f87171",
    "penalty"  => "#facc15",
    "timeout"  => "#fb923c",
    "sack"     => "#c4b5fd"
  }
%>
<% if plays.any? || game.live? %>
  <%# COLLAPSED BY DEFAULT, so the list never takes more of the page than the
      game above it. At rest this is one line and the list opens on a click.

      `plays` lives on the page wrapper beside `focus` (contests/live.html.erb),
      OUTSIDE this stream target, for the reason `focus` does: a play replaces
      everything in here every twenty seconds, and a toggle stored among it
      would close itself each time. The inline display:none is the first-paint
      state, so the list does not flash open before Alpine boots. %>
  <%# ONE LINE THAT READS WITH THE RAIL ABOVE IT. The rail's
      bottom third lists what just happened in a word — "Interception" — and
      the right third of this bar, directly beneath it and the same width,
      says it properly: who (up to three small portraits), what the play
      was in bold, and its detail underneath. The quarter and clock stay on the left with the
      heading: they are detail about the play, not the play. %>
  <% latest = plays.first %>
  <%# BETWEEN A SCORE AND ITS KICKOFF the bar says what everyone is waiting for,
      not the TV timeout the feed puts in the gap (GamePlay.awaiting_kickoff_after). %>
  <%
    awaiting = GamePlay.awaiting_kickoff_after(plays, game: game)
    kicker   = if awaiting
                 # From the score itself; the latest goal, then the play's own
                 # team, only when the feed sent no running score.
                 scorer = GamePlay.scoring_team_slug(awaiting, plays: plays, game: game) ||
                          game.goals.max_by { |goal| goal.id.to_i }&.team_slug || awaiting.team_slug
                 [game.away_team, game.home_team].compact.find do |team|
                   team.slug == GamePlay.kicking_team_slug(awaiting, scorer_slug: scorer, game: game)
                 end
               end
  %>
  <div class="card p-0 mt-1 overflow-hidden" data-test="live-plays" data-game-slug="<%= game.slug %>">
    <div class="flex flex-col sm:flex-row sm:items-stretch">
      <button type="button" class="flex items-center gap-2 min-w-0 flex-1 text-left px-4 py-2"
              data-test="live-plays-toggle"
              @click="plays = !plays" :aria-expanded="plays.toString()" aria-expanded="false">
        <span class="text-xs text-muted transition-transform" :class="plays && 'rotate-90'" aria-hidden="true">&#9656;</span>
        <h2 class="text-sm font-bold uppercase tracking-wider text-secondary whitespace-nowrap">Play by Play</h2>
        <% if latest&.clock_label %>
          <span class="text-xs font-mono tabular-nums text-muted whitespace-nowrap" data-test="live-plays-clock"><%= latest.clock_label %></span>
        <% end %>
      </button>

      <% if latest && awaiting %>
        <div class="flex items-center justify-center gap-3 min-w-0 sm:w-1/3 px-4 py-2"
             style="background: rgba(8, 10, 16, 0.82)"
             data-test="live-plays-latest" data-play-kind="pending-kickoff" data-play-id="<%= latest.external_id %>"
             title="<%= latest.text %>">
          <span class="relative inline-flex items-center max-w-full" data-test="live-plays-group">
            <span class="absolute top-1/2 -translate-y-1/2 flex items-center" data-test="live-plays-avatars"
                  style="right: calc(100% + 0.5rem)">
              <span class="h-7 w-7 rounded-full flex items-center justify-center text-sm"
                    style="background: <%= normalize_hex(kicker&.card_background) || "#3a3f4b" %>; box-shadow: 0 0 0 2px <%= kicker ? team_card_palette(kicker)[:accent] : "rgba(255,255,255,0.3)" %>">
                <span aria-hidden="true"><%= kicker&.emoji %></span>
              </span>
            </span>
            <span class="min-w-0 leading-tight text-center" data-test="live-plays-words">
              <span class="block text-sm font-extrabold text-white truncate" data-test="live-plays-result">Pending Kickoff</span>
              <% if kicker %>
                <span class="inline-block max-w-full truncate text-xs font-bold" data-test="live-plays-detail"
                      style="background: <%= team_two_tone_ink(kicker) %>; -webkit-background-clip: text; background-clip: text; color: transparent"><%= kicker.short_name %> kicks off</span>
              <% end %>
            </span>
          </span>
        </div>
      <% elsif latest %>
        <%
          side     = [game.away_team, game.home_team].compact.find { |team| team.slug == latest.team_slug }
          sides    = [game.away_team, game.home_team].compact.index_by(&:slug)
          names    = latest.players
          athletes = latest.athletes
        %>
        <%# CENTRED, like the rail's own rows directly above it: the rail lists
            "Interception" centred in its third, and this says the same word
            centred in the same third, so the two read as one column. %>
        <%# ITS OWN DARK GROUND, in both themes. The rail above is dark whatever
            the theme, and the detail line below is drawn in team colours chosen
            to read on dark; on the light theme's pale card that ink fell to
            about 2:1. So this third carries the rail's surface down with it,
            which is also what makes the two read as one column. %>
        <div class="flex items-center justify-center gap-3 min-w-0 sm:w-1/3 px-4 py-2"
             style="background: rgba(8, 10, 16, 0.82)"
             data-test="live-plays-latest" data-play-id="<%= latest.external_id %>" data-play-kind="<%= latest.kind %>"
             title="<%= latest.text %>">
          <span class="relative inline-flex items-center max-w-full" data-test="live-plays-group">
          <%# WHO — up to three, overlapping, the one that matters most on the
              left and ON TOP (the receiver over the passer on a completion).
              A player we hold a portrait for shows it; one we only have a name
              for shows initials; a play that names nobody shows its team. %>
          <%# OUT OF THE FLOW, floated into the space to the left of the
              words. The two lines of words are CENTRED in this
              third, exactly under the rail's centred column, and centred
              against each other. If the portraits took part in that centring,
              one, two or three of them would push the words a different
              distance each time. %>
          <span class="absolute top-1/2 -translate-y-1/2 flex items-center" data-test="live-plays-avatars"
                style="right: calc(100% + 0.5rem)">
            <% if names.empty? %>
              <span class="h-7 w-7 rounded-full flex items-center justify-center text-sm"
                    style="background: <%= normalize_hex(side&.card_background) || "#3a3f4b" %>; box-shadow: 0 0 0 2px <%= side ? team_card_palette(side)[:accent] : "rgba(255,255,255,0.3)" %>">
                <span aria-hidden="true"><%= side&.emoji %></span>
              </span>
            <% end %>
            <% names.each_with_index do |name, index| %>
              <%
                athlete  = athletes[index]
                # A name we cannot place wears the play's team — except the
                # one who took the ball away, who plays for the other side.
                taker    = latest.kind == "turnover" && index.zero?
                club     = sides[athlete&.team_slug] || (taker ? (sides.values - [side]).first : side) || side
                portrait = athlete&.headshot_url(width: 100)
                initials = name.scan(/[A-Z]/).first(2).join
              %>
              <%# 1.75rem, each tucked more than half under the one before: a
                  cluster that says "these three", not three portraits in a row. %>
              <span class="relative h-7 w-7 rounded-full overflow-hidden flex items-center justify-center text-[9px] font-black"
                    data-test="live-plays-avatar" data-player="<%= name %>"
                    title="<%= athlete ? athlete.person.full_name : name %>"
                    style="z-index: <%= 3 - index %>; <%= "margin-left: -0.75rem;" unless index.zero? %> color: <%= team_card_palette(club)[:fg] %>;
                           background: <%= normalize_hex(club&.card_background) || "#3a3f4b" %>;
                           box-shadow: 0 0 0 2px <%= club ? team_card_palette(club)[:accent] : "rgba(255,255,255,0.3)" %>, 0 0 0 3px rgba(8, 10, 16, 0.55)">
                <% if portrait %>
                  <img src="<%= portrait %>" alt="" class="h-full w-full object-cover object-top">
                <% else %>
                  <span aria-hidden="true"><%= initials %></span>
                <% end %>
              </span>
            <% end %>
          </span>

          <%# WHAT, in the board's bold white; the DETAIL under it in the two
              colours of the team that ran the play. %>
          <span class="min-w-0 leading-tight text-center" data-test="live-plays-words">
            <span class="block text-sm font-extrabold text-white truncate" data-test="live-plays-result"><%= latest.result_label %></span>
            <% if latest.detail_label %>
              <span class="inline-block max-w-full truncate text-xs font-bold" data-test="live-plays-detail"
                    style="background: <%= side ? team_two_tone_ink(side) : "linear-gradient(90deg, #cbd5e1, #94a3b8)" %>;
                           -webkit-background-clip: text; background-clip: text; color: transparent"><%= latest.detail_label %></span>
            <% end %>
          </span>
          </span>
        </div>
      <% end %>
    </div>

    <% if plays.any? %>
      <ol class="tt-play-feed max-h-72 overflow-y-auto border-t border-subtle" data-test="live-plays-list"
          x-show="plays" style="display: none">
        <% plays.each_with_index do |play, index| %>
          <% ink = kind_ink[play.kind] %>
          <% team = [game.away_team, game.home_team].compact.find { |side| side.slug == play.team_slug } %>
          <% if play.kind == "break" %>
            <%# A break in play is a divider, not an event: the quarter ending
                and the two-minute warning belong to nobody, so they carry no
                team and sit centred between the plays either side. %>
            <li class="px-4 py-1.5 text-center text-[11px] font-bold uppercase tracking-wider text-muted border-b border-subtle"
                data-test="live-play" data-play-kind="break" data-play-id="<%= play.external_id %>">
              <%= play.text.to_s.sub(/\.\z/, "") %>
            </li>
          <% else %>
            <li class="flex items-start gap-3 px-4 border-b border-subtle <%= index.zero? ? "py-3 tt-play-latest" : "py-2" %>"
                data-test="live-play" data-play-kind="<%= play.kind %>" data-play-id="<%= play.external_id %>"
                style="<%= "box-shadow: inset 3px 0 0 #{ink};" if ink %>">
              <span class="w-16 flex-shrink-0 pt-0.5 text-[11px] font-mono font-bold tabular-nums text-muted">
                <%= play.clock_label %>
              </span>
              <span class="flex-shrink-0 w-5 text-center leading-none pt-0.5"><%= team&.emoji %></span>
              <span class="min-w-0 flex-1">
                <% if play.label || play.down_distance.present? %>
                  <span class="flex flex-wrap items-center gap-x-2 gap-y-0.5 mb-0.5">
                    <% if play.label %>
                      <span class="text-[10px] font-black uppercase tracking-wider"
                            style="color: <%= ink %>"><%= play.label %></span>
                    <% end %>
                    <% if play.down_distance.present? %>
                      <span class="text-[11px] font-semibold text-muted"><%= play.down_distance %></span>
                    <% end %>
                  </span>
                <% end %>
                <span class="block leading-snug <%= index.zero? ? "text-sm font-semibold text-heading" : "text-[13px] text-secondary" %>">
                  <%= play.text %>
                </span>
              </span>
            </li>
          <% end %>
        <% end %>
      </ol>
    <% else %>
      <p class="px-4 py-3 text-sm text-muted border-t border-subtle" data-test="live-plays-empty"
         x-show="plays" style="display: none">Waiting for the first play.</p>
    <% end %>
  </div>
<% end %>
