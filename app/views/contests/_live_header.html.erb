<%# locals: (contest:)

    The live page's title row: the slate, the contest name with its live-state
    badge, and the "← Contest" link. Rendered by contests/live and by the
    /turf-monster-v2 laptop snapshot, so the two cannot drift. %>
<div class="mb-5 flex items-start justify-between gap-3">
  <div class="min-w-0">
    <% if contest.slate %>
      <p class="text-sm text-secondary font-medium"><%= contest.slate.name %></p>
    <% end %>
    <h1 class="text-2xl md:text-3xl font-extrabold text-heading flex items-center gap-2 flex-wrap">
      <%= contest.name %>
      <% badge = contest_live_badge(contest) %>
      <span class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider <%= badge[:classes] %>"
            data-test="live-state" data-state="<%= contest_live_state(contest) %>">
        <span class="h-2 w-2 rounded-full <%= badge[:dot] %>"></span> <%= badge[:label] %>
      </span>
    </h1>
  </div>
  <%= link_to "← Contest", contest_page_path(contest), class: "btn btn-outline btn-sm flex-shrink-0" %>
</div>
