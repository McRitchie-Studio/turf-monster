<%# Contest chat panel — real-time via Turbo Streams over ActionCable.
    Composer is pinned at the top, under the heading; messages read newest-first
    below it. Reading is public; posting is limited to entrants + admins
    (Contest#chat_participant?). The .chat-admin class on the root reveals the
    per-message Hide buttons for admins — broadcast partials can't know the
    viewer, so visibility is driven by this container class. %>
<% messages = Message.recent_for(contest) %>
<% can_post = logged_in? && contest.chat_enabled? && contest.chat_participant?(current_user) %>
<%# Quest 2 typewriter deck (contests_helper#chat_prompt_samples). Gated on
    @quest_step, which contests#show sets only for an entrant — because the ONLY
    thing that dispatches quest-chat-active is the quest card, and contests#live
    renders no quest card. Without the gate, #live paid for the helper's fallback
    query on every render to build a deck nothing could ever play.
    @my_active_entries (also #show-only) preloads selections -> matchup -> team,
    so the helper's own query never runs on the page that has one. %>
<% chat_prompts = can_post && @quest_step.present? ? chat_prompt_samples(contest, current_user, entries: @my_active_entries) : [] %>

<%# .chat-admin*, .chat-message-in, .chat-kbd, .chat-live-ping, .chat-scroll-fade
    + their @keyframes live in app/assets/tailwind/application.css (migrated 2026-05-24). %>
<%# chatPanelPop — one-shot scale pulse to draw attention to the chat when the
    contest quest card lands on its "send your first message" step (the questCard
    factory dispatches quest-chat-active). Reuses the seedsCardPop easing/shape so
    it reads as the same family of "look here" pop used elsewhere. Defined here
    (outside any template) because the pulse target is this panel specifically. %>
<style>
  @keyframes chatPanelPop {
    0%   { transform: scale(1); }
    35%  { transform: scale(1.025); }
    100% { transform: scale(1); }
  }
  .chat-panel-pop { animation: chatPanelPop 600ms cubic-bezier(0.34, 1.56, 0.64, 1); will-change: transform; }
  @media (prefers-reduced-motion: reduce) { .chat-panel-pop { animation: none; } }
</style>
<div class="flex flex-col <%= 'chat-admin' if current_user&.admin? %> <%= 'chat-can-react' if can_post %>"
     style="height: 32rem;"
     x-data="contestChat(<%= messages.empty? %>)"
     @quest-chat-active.window="questChatActive()"
     data-post-url="<%= contest_messages_path(contest) %>"
     data-chat-prompts="<%= chat_prompts.to_json %>"
     data-can-react="<%= can_post %>">
  <%= turbo_stream_from contest, :messages %>

  <%# Header %>
  <div class="flex items-center justify-between mb-4 flex-shrink-0">
    <h2 class="text-xl font-semibold text-body">Contest Chat</h2>
    <span class="flex items-center gap-1.5 text-xs text-muted">
      <span class="relative inline-flex w-2 h-2">
        <span class="chat-live-ping absolute inline-flex w-full h-full rounded-full bg-primary"></span>
        <span class="relative inline-flex w-2 h-2 rounded-full bg-primary"></span>
      </span>
      Live
    </span>
  </div>

  <%# Composer — pinned at the top, directly under the heading. %>
  <div class="flex-shrink-0 pb-3 border-b border-subtle">
    <% if !contest.chat_enabled? %>
      <p class="text-sm text-muted text-center py-1">Chat is closed for this contest.</p>
    <% elsif !logged_in? %>
      <p class="text-sm text-muted text-center py-1">
        <%= link_to "Sign in", signin_path, class: "text-primary hover:text-primary-300 font-medium" %> to join the chat.
      </p>
    <% elsif !can_post %>
      <p class="text-sm text-muted text-center py-1">Enter the contest to join the chat.</p>
    <% else %>
      <form class="flex items-center gap-2" @submit.prevent="send()">
        <%# Quest 2: .chat-input-glow while the "Send Your First Message" mission
            is live, and the placeholder types itself through chat_prompts. Both
            are bound (not static) so they retire the moment the quest completes
            — see questChatActive()/startPrompts() below. %>
        <textarea x-model="body" x-ref="input" id="contest-chat-input" rows="1" maxlength="<%= Message::BODY_MAX_LENGTH %>"
                  :placeholder="typing ? typed : 'Message the contest…'"
                  placeholder="Message the contest…"
                  aria-label="Message the contest"
                  :class="{ 'chat-input-glow': questGlow }"
                  @keydown.enter="if ($event.metaKey || $event.ctrlKey) { $event.preventDefault(); send(); }"
                  class="flex-1 h-10 resize-none rounded-lg bg-surface-alt border border-subtle px-3 py-2 text-sm text-body placeholder:text-muted focus:outline-none focus:border-primary"></textarea>
        <button type="submit" :disabled="sending || !body.trim()"
                :class="{ 'opacity-50 cursor-not-allowed': sending || !body.trim() }"
                class="btn btn-primary btn-sm flex-shrink-0 inline-flex items-center gap-2 h-10">
          <span>Send</span>
          <span class="inline-flex items-center gap-1" aria-hidden="true">
            <kbd class="chat-kbd" x-text="isMac ? '⌘' : 'Ctrl'"></kbd>
            <kbd class="chat-kbd">↵</kbd>
          </span>
        </button>
      </form>
    <% end %>
  </div>

  <%# Messages — newest first, reading top to bottom. %>
  <div class="flex-1 min-h-0 overflow-y-auto pt-3 chat-scroll-fade">
    <div id="contest_<%= contest.id %>_messages" x-ref="messageList" class="flex flex-col space-y-4">
      <% if messages.empty? %>
        <p x-show="empty" class="text-sm text-muted text-center py-8">
          No messages yet — say hi 👋
        </p>
      <% end %>
      <%= render partial: "messages/message", collection: messages %>
    </div>
  </div>

  <%# Shared "Find another reaction" picker — one per panel, position:fixed so
      the message-list overflow can't clip it. openReactionPicker() points its
      data-react-url at the hovered message before showing it. %>
  <div id="chat-reaction-picker" class="chat-reaction-picker bg-surface border border-strong rounded-xl shadow-2xl" data-react-url="" role="menu" aria-label="Pick a reaction">
    <% Reaction::PICKER.each do |e| %>
      <button type="button" onclick="pickReaction('<%= e %>')"><%= e %></button>
    <% end %>
  </div>
</div>

<script>
  // Inline (not a module): Alpine evaluates x-data before importmap modules
  // load — see docs/UI_PATTERNS.md "Inline JS that stays inline".

  // Error toast — the studio-engine toast manager renders 'alert' as error styling.
  function chatToast(title, message) {
    window.dispatchEvent(new CustomEvent('toast', {
      detail: { type: 'alert', title: title, message: message || '', duration: 4000 }
    }));
  }

  function contestChat(isEmpty) {
    return {
      body: '',
      sending: false,
      empty: isEmpty,
      // Quest 2 ("Send Your First Message") nudge state. questGlow drives the
      // .chat-input-glow halo on the composer; `typed` is the placeholder the
      // typewriter is part-way through and falls back to the static prompt
      // whenever it is empty. Both live only while the mission is unfinished.
      questGlow: false,
      typed: '',
      // `typing` gates the placeholder, not `typed` — between two lines the
      // typed text is legitimately empty, and falling back on emptiness flashed
      // "Message the contest…" for 400ms every cycle.
      typing: false,
      _prompts: [],
      _promptIdx: 0,
      _promptN: 0,
      _promptPhase: 'type',
      _promptTimer: null,
      _promptsOff: false,
      // Rest is TERMINAL, and it needs its own flag. The guard used to key off
      // _promptTimer, which _promptStep() nulls when it rests — so a rested
      // component read as idle and any second quest-chat-active re-entered the
      // machine at phase 'hold', erased the rested line, walked _promptIdx past
      // the end of the deck and rested on undefined. That left typed = '' with
      // typing = true: a permanently EMPTY placeholder. Reachable by an ordinary
      // click, since contests/_quest_chat puts @click="focusChat()" on the whole
      // card and focusChat() dispatches quest-chat-active.
      _promptsRested: false,
      // The mission is over (first message sent). Latches so a stray ping can
      // never re-arm the glow on a finished quest.
      _questOver: false,
      // ⌘+Enter on Mac, Ctrl+Enter elsewhere — drives the Send-button hint.
      isMac: /Mac/i.test(navigator.platform || navigator.userAgent || ''),
      init() {
        // Focus the composer on load so you can type straight away.
        // preventScroll keeps the page from jumping down to the chat; on
        // mobile the panel sits in a hidden tab, so focus() no-ops there.
        this.$nextTick(() => { this.$refs.input?.focus({ preventScroll: true }); });

        // The typewriter deck, rendered per-viewer by chat_prompt_samples.
        try { this._prompts = JSON.parse(this.$root.dataset.chatPrompts || '[]'); } catch (e) { this._prompts = []; }

        // Typing anything at all retires the demo prompts for good — they have
        // done their job, and a line cycling behind real text is just noise.
        this.$watch('body', (v) => { if (v) { this.stopPrompts(); } });

        // Who am I + can I react — read once for the client-side "reacted"
        // highlight and the participant gate (the server is the real gate).
        var session = window.Alpine && Alpine.store('session');
        window.__chatMyUserId = (session && session.userId) || null;
        window.__chatCanReact = this.$root.dataset.canReact === 'true';

        var listEl = this.$refs.messageList;
        if (listEl) {
          // New messages prepend at the top — clear the empty state and play a
          // slide-in animation on each freshly added bubble. Direct children
          // only, so a nested reactions-row replace doesn't re-trigger it.
          new MutationObserver((mutations) => {
            this.empty = false;
            mutations.forEach((m) => {
              m.addedNodes.forEach((node) => {
                if (node.nodeType === 1 && node.id && node.id.startsWith('message_')) {
                  node.classList.add('chat-message-in');
                }
              });
            });
          }).observe(listEl, { childList: true });

          // Separate subtree observer for reaction highlighting: fires for both
          // freshly prepended messages AND the per-message reactions row being
          // replaced by a broadcast. Re-marks which pills are "mine".
          new MutationObserver((mutations) => {
            mutations.forEach((m) => {
              m.addedNodes.forEach((node) => {
                if (node.nodeType === 1) markMyReactions(node);
              });
            });
          }).observe(listEl, { childList: true, subtree: true });

          // Highlight reactions already present on initial load.
          this.$nextTick(() => markMyReactions(listEl));
        }

        // Desktop: keep the panel as tall as the leaderboard column so the two
        // columns line up at the bottom. Mobile keeps the fixed CSS height.
        var leaderboard = document.getElementById('leaderboard-container');
        if (leaderboard && window.ResizeObserver) {
          var panel = this.$root;
          var desktop = window.matchMedia('(min-width: 768px)');
          new ResizeObserver(function () {
            panel.style.height = desktop.matches ? leaderboard.offsetHeight + 'px' : '32rem';
          }).observe(leaderboard);
        }
      },
      async send() {
        var text = this.body.trim();
        if (!text || this.sending) return;
        this.sending = true;
        try { window.dispatchEvent(new CustomEvent('quest-chat-sending')); } catch (e) {} // quest 2 arrow -> spinner
        try {
          var resp = await fetch(this.$root.dataset.postUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json',
              'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
            },
            body: JSON.stringify({ message: { body: text } })
          });
          var data = await resp.json().catch(() => ({}));
          if (resp.ok && data.ok) {
            this.body = '';
            // The message landed, so the nudge has done its job — retire BOTH
            // cues here rather than inside the seeds branch below. A first
            // message that earns no bonus is still a first message, and leaving
            // the glow pulsing at someone who just posted is the edge that
            // acceptance criterion 5 ("stop after first message sends") means.
            this.questDone();
            // First-message quest bonus: MessagesController#create returns the
            // seeds payload only on the user's first-ever contest-chat message.
            // Flip the quest arrow to a checkmark, fire the seeds tick-up, and
            // advance the contest quest card from chat -> newsletter.
            if (data.seeds_earned) {
              try { window.dispatchEvent(new CustomEvent('quest-chat-success')); } catch (e) {} // arrow -> checkmark
              try { window.completeQuest(data, { to: 'newsletter' }); } catch (e) {} // unified celebration
            } else {
              try { window.dispatchEvent(new CustomEvent('quest-chat-reset')); } catch (e) {} // no bonus -> un-spin
            }
          } else {
            try { window.dispatchEvent(new CustomEvent('quest-chat-reset')); } catch (e) {}
            chatToast('Message not sent', data.error || 'Please try again.');
          }
        } catch (e) {
          try { window.dispatchEvent(new CustomEvent('quest-chat-reset')); } catch (e2) {}
          chatToast('Message not sent', 'Network error.');
        } finally {
          this.sending = false;
        }
      },
      // The quest card landed on (or advanced to) the chat mission. One event
      // drives all three nudges: the panel pop, the composer's glow, and the
      // typed sample messages.
      questChatActive() {
        if (this._questOver) return; // finished mission — never re-arm the cues
        this.pulse();
        this.questGlow = true;
        this.startPrompts();
      },

      // First message landed and earned its seeds — the composer goes back to
      // being an ordinary composer.
      questDone() {
        this._questOver = true;
        this.questGlow = false;
        this.stopPrompts();
      },

      startPrompts() {
        if (this._promptsOff || this._promptsRested || this._promptTimer || !this._prompts.length) return;
        // Reduced motion keeps the plain placeholder. Nothing MOVES here, but a
        // string rewriting itself character by character is animation all the
        // same, and it sits under a caret the reader is trying to type into.
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        this.typing = true;
        this._promptStep();
      },

      stopPrompts() {
        this._promptsOff = true;
        this.typing = false;
        clearTimeout(this._promptTimer);
        this._promptTimer = null;
        this.typed = '';
      },

      // One frame of the typewriter: type out -> hold -> erase -> next line,
      // and REST on the last line of the deck instead of looping. The deck is
      // sized to the number of passes worth showing (chat_prompt_samples), so
      // the final line simply stays put as the placeholder from then on.
      //
      // Steps over CODE POINTS (Array.from), never string indexes — slicing
      // mid-emoji leaves a lone surrogate, which paints as a replacement box
      // for a frame on every ✅ / 🔥 / 👋 in the deck.
      _promptStep() {
        var chars = Array.from(this._prompts[this._promptIdx] || '');
        var rest = false;
        var delay;
        if (this._promptPhase === 'type') {
          this._promptN++;
          if (this._promptN >= chars.length) {
            rest = this._promptIdx >= this._prompts.length - 1;
            this._promptPhase = 'hold';
            delay = 1800;
            if (rest) { this._promptsRested = true; }
          } else {
            delay = 55;
          }
        } else if (this._promptPhase === 'hold') {
          this._promptPhase = 'erase';
          delay = 30;
        } else {
          this._promptN--;
          if (this._promptN <= 0) {
            this._promptN = 0;
            // Never step past the last line — rest is the only way out of the
            // deck, and indexing past it is what produced the empty placeholder.
            this._promptIdx = Math.min(this._promptIdx + 1, this._prompts.length - 1);
            this._promptPhase = 'type';
            delay = 420;
          } else {
            delay = 22;
          }
        }
        this.typed = chars.slice(0, this._promptN).join('');
        // Resting leaves `typing` true, so the finished line stays in the
        // placeholder — dropping it here would fall back to the static prompt
        // and undo the whole point of stopping on a good line.
        if (rest) { this._promptTimer = null; return; }
        var self = this;
        this._promptTimer = setTimeout(function () { self._promptStep(); }, delay);
      },

      // Turbo caches the page on navigation; without this the typewriter keeps
      // firing against a detached component.
      destroy() { clearTimeout(this._promptTimer); },

      // One-shot attention pop — fired by the quest card's quest-chat-active event
      // when its chat mission shows. Restart trick (remove → reflow → add) so a
      // re-trigger replays the keyframe.
      pulse() {
        var el = this.$root;
        el.classList.remove('chat-panel-pop');
        void el.offsetWidth;
        el.classList.add('chat-panel-pop');
        setTimeout(function () { el.classList.remove('chat-panel-pop'); }, 700);
      }
    };
  }

  function hideChatMessage(btn) {
    if (!window.confirm('Hide this message for everyone?')) return;
    fetch(btn.dataset.messageUrl, {
      method: 'DELETE',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
      }
    }).then(function(r) {
      if (!r.ok) {
        chatToast('Could not hide message');
      }
      // On success the bubble is removed for everyone via the Turbo Stream broadcast.
    }).catch(function() {});
  }

  // === Emoji reactions =================================================
  // The updated pill row arrives for everyone (including the actor) via the
  // Reaction broadcast, so these only fire the toggle + manage the picker —
  // no optimistic DOM writes. markMyReactions() (above, via observer) re-applies
  // the viewer's "reacted" highlight whenever a row renders.

  // Toggle which of THIS viewer's pills are highlighted, by comparing the
  // server-rendered reactor ids against my own id. Viewer-specific, so it lives
  // here and never in the broadcast partial.
  function markMyReactions(root) {
    var myId = window.__chatMyUserId;
    if (myId == null || !root.querySelectorAll) return;
    var pills = (root.matches && root.matches('[data-reactor-ids]'))
      ? [root] : root.querySelectorAll('[data-reactor-ids]');
    pills.forEach(function(p) {
      var ids = (p.dataset.reactorIds || '').split(',');
      p.classList.toggle('reacted', ids.indexOf(String(myId)) !== -1);
    });
  }

  // Parse a reactions-row HTML string into its detached container element.
  function parseReactionsContainer(html) {
    var tpl = document.createElement('template');
    tpl.innerHTML = (html || '').trim();
    return tpl.content.querySelector('[id$="_reactions"]');
  }

  // Play one of the reaction transitions on a pill, cleaning up after itself.
  // type: 'pop' (0→1), 'bump' (1→2+), 'shrink' (1→0, runs `done` on end).
  function animatePill(pill, type, done) {
    if (!pill) { if (done) done(); return; }
    var cls = 'rx-' + type;
    pill.classList.remove('rx-pop', 'rx-bump', 'rx-shrink');
    void pill.offsetWidth; // restart the animation if the class was just present
    pill.classList.add(cls);
    pill.addEventListener('animationend', function h() {
      pill.removeEventListener('animationend', h);
      pill.classList.remove(cls);
      if (done) done();
    }, { once: true });
  }

  function pillCount(pill) {
    var c = pill && pill.querySelector('.chat-reaction-count');
    return c ? (parseInt(c.textContent, 10) || 0) : 0;
  }

  // Reconcile a message's existing reactions row against a freshly-rendered one,
  // mutating pills in place so each change animates independently:
  //   new emoji      → clone in + pop
  //   higher count   → update number + bump
  //   emoji removed   → shrink, then remove
  // Used by BOTH the actor's click (applyReactionHtml) and the live broadcast
  // (the "reactions" Turbo Stream action), so animations are identical on both.
  function reconcileReactions(containerEl, newContainerEl) {
    if (!containerEl || !newContainerEl) return;
    var oldPills = {};
    containerEl.querySelectorAll('.chat-reaction-pill').forEach(function(p) { oldPills[p.dataset.emoji] = p; });
    var seen = {};

    newContainerEl.querySelectorAll('.chat-reaction-pill').forEach(function(np) {
      var emoji = np.dataset.emoji;
      seen[emoji] = true;
      var old = oldPills[emoji];
      if (old) {
        var was = pillCount(old);
        var now = pillCount(np);
        old.dataset.reactorIds = np.dataset.reactorIds || '';
        old.setAttribute('title', np.getAttribute('title') || '');
        var c = old.querySelector('.chat-reaction-count');
        if (c) c.textContent = now;
        if (now > was) animatePill(old, 'bump');
      } else {
        var clone = np.cloneNode(true);
        clone.classList.remove('reacted');
        containerEl.appendChild(clone); // newest emoji sort last — append matches server order
        animatePill(clone, 'pop');
      }
    });

    // Removed emoji: shrink the stale pill out, then drop it.
    Object.keys(oldPills).forEach(function(emoji) {
      if (!seen[emoji]) {
        var p = oldPills[emoji];
        animatePill(p, 'shrink', function() { if (p.parentNode) p.remove(); });
      }
    });

    // Keep the row's spacing class (mt-1.5 only when non-empty) in sync.
    containerEl.className = newContainerEl.className;
    markMyReactions(containerEl);
  }

  // Apply the toggle response (actor's own click) with the same reconcile +
  // animations the broadcast uses, so the actor sees instant, animated feedback.
  function applyReactionHtml(messageEl, html) {
    if (!messageEl || html == null) return;
    var container = messageEl.querySelector('[id$="_reactions"]');
    reconcileReactions(container, parseReactionsContainer(html));
  }

  function sendReaction(messageEl, emoji) {
    if (!messageEl) return;
    var url = messageEl.dataset.reactUrl;
    if (!url) return;
    if (!window.__chatCanReact) {
      chatToast('Join to react', 'Enter the contest to react to messages.');
      return;
    }
    fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
      },
      body: JSON.stringify({ emoji: emoji })
    }).then(function(r) { return r.json().catch(function() { return {}; }); })
      .then(function(data) {
        if (data && data.error) { chatToast('Reaction failed', data.error); return; }
        if (data && typeof data.html === 'string') applyReactionHtml(messageEl, data.html);
      })
      .catch(function() { chatToast('Reaction failed', 'Network error.'); });
  }

  // Click handler for the hover quick-bar buttons AND the existing pills.
  function reactToMessage(el, emoji) {
    var root = el.closest('[data-react-url]');
    hideReactionPicker();
    if (root) sendReaction(root, emoji);
  }

  function openReactionPicker(btn) {
    var picker = document.getElementById('chat-reaction-picker');
    if (!picker) return;
    // Stash the message element so pickReaction can apply the instant update.
    picker._targetMessageEl = btn.closest('[data-react-url]');
    picker.classList.add('is-open');
    // Prefer above-right of the "+"; clamp into the viewport, flip below if no room.
    var r = btn.getBoundingClientRect();
    var pw = picker.offsetWidth, ph = picker.offsetHeight;
    var left = Math.min(Math.max(8, r.right - pw), window.innerWidth - pw - 8);
    var top = r.top - ph - 6;
    if (top < 8) top = r.bottom + 6;
    picker.style.left = left + 'px';
    picker.style.top = top + 'px';
  }

  function hideReactionPicker() {
    var picker = document.getElementById('chat-reaction-picker');
    if (picker) picker.classList.remove('is-open');
  }

  function pickReaction(emoji) {
    var picker = document.getElementById('chat-reaction-picker');
    var messageEl = picker ? picker._targetMessageEl : null;
    hideReactionPicker();
    sendReaction(messageEl, emoji);
  }

  // Dismissal wiring once per page (chat may render on more than one view).
  if (!window.__chatReactionsWired) {
    window.__chatReactionsWired = true;
    document.addEventListener('click', function(e) {
      var picker = document.getElementById('chat-reaction-picker');
      if (!picker || !picker.classList.contains('is-open')) return;
      if (picker.contains(e.target)) return;
      if (e.target.closest && e.target.closest('.chat-react-add')) return; // opener manages itself
      hideReactionPicker();
    }, true);
    window.addEventListener('scroll', function() { hideReactionPicker(); }, true);
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') hideReactionPicker(); });

    // Register the custom "reactions" Turbo Stream action (used by
    // Message#broadcast_reactions) so live updates reconcile + animate instead
    // of swapping the whole row. Turbo loads as a deferred module, so poll
    // until it's ready (broadcasts only arrive after a user interaction, so
    // there's ample time before the first one).
    (function registerReactionStreamAction() {
      if (!window.Turbo || !window.Turbo.StreamActions) { return setTimeout(registerReactionStreamAction, 60); }
      if (window.Turbo.StreamActions.reactions) return;
      window.Turbo.StreamActions.reactions = function() {
        var existing = this.targetElements && this.targetElements[0];
        var incoming = this.templateContent && this.templateContent.querySelector('[id$="_reactions"]');
        reconcileReactions(existing, incoming);
      };
    })();
  }
</script>
