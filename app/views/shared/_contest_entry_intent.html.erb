<%# THE contest_entry INTENT — rendered from layouts/application, on EVERY page.
    That is deliberate and it is the fix for the blocker below.

    WHY NOT IN THE BOARD PARTIAL, where this started. The board renders only on
    contests/show and contests/world_cup. A wallet returns to
    /auth/phantom/callback, which renders studio-engine's view — this app ships no
    local override — so the handler map on that document was EMPTY while the
    registry itself was present. walletOps.resume() consumes the journal at take()
    BEFORE the signTransaction hop reaches requireHandler, so the throw arrived
    with nothing left to retry. The user approved the transaction in their wallet,
    came back, and the entry was silently gone.

    WHY NOT THE OTHER FIX, which review offered as the alternative: have the engine
    callback render a host-supplied registration partial. That is the cleaner
    separation and it is the right long-term shape — but it needs a studio-engine
    change, a release, and ANOTHER gem floor on a chain already deep with
    silent-failure notes. Days, while entries are lost. This costs the handlers'
    JS on every page and gets every FUTURE intent working on the callback for free.

    Registration is idempotent and guarded, so rendering it everywhere is safe: a
    page without solana_studio/wallet_ops.js registers nothing and throws nothing. %>
<script>
// THE contest_entry INTENT — registered here, at page load, BY NAME.
//
// WHY BY NAME AND NOT AS A CLOSURE, which is the whole reason walletOps has this
// shape: on the redirect transport the page is DESTROYED between preparing the
// transaction and getting it back signed. A closure cannot survive that. The name
// is the only thing that can be written into localStorage and looked up again by
// whatever document the wallet returns to — which may not even be the same tab.
//
// WHAT CROSSES THE REDIRECT is a server-side SLUG, never transaction bytes.
// prepare_entry mints a PreparedTransaction row and hands back ptx_slug; the
// journal carries that plus the ids, and complete() posts them to
// confirm_onchain_entry. The row is the durable half, and it already existed for
// blockhash freshness — this flow just needed it to be the thing that travels.
//
// SIGN-ONLY, AND THIS IS NOT A PREFERENCE. prepare_entry returns a PARTIALLY
// signed transaction whose admin slot is deliberately EMPTY. The user's wallet
// signs its own slot and the SERVER cosigns and broadcasts (Transaction
// #cosign_wire). A wallet that broadcast it directly would hand Solana a
// transaction missing a required signature — and worse, we would never receive
// the signed bytes the server needs, so the entry would fail with nothing to
// retry. See /tasks/intent-declares-sign-only: walletOps currently PREFERS
// signAndSendTransaction where a wallet has one, which is wrong for every
// co-signed flow. It does not bite Phantom (its send-side deeplink is
// deprecated, so signingHop already falls to signTransaction) and no other
// wallet reaches redirect signing yet — but this comment is here so the next
// reader does not "fix" the preference back.
(function () {
  var S = window.SolanaStudio;
  // GUARDED like every optional capability in this app: a page that did not load
  // solana_studio/wallet_ops.js simply has no registry, and the entry flow's
  // inline path below is unaffected. An absent capability must not default to
  // the permissive branch.
  if (!S || !S.walletOps || typeof S.walletOps.define !== 'function') return;

  S.walletOps.define('contest_entry', {
    // Runs BEFORE the wallet is reached on the redirect transport, so everything
    // it returns must be JSON-serialisable — it is literally serialised.
    prepare: function (ctx) {
      return window.tmPrepareContestEntry(ctx);
    },
    // Runs on the callback document, in a page that never saw prepare().
    // Everything it needs arrives through ctx (the caller's own arguments) and
    // state (what prepare returned) — nothing from a closure.
    complete: function (ctx, result, state) {
      return window.tmCompleteContestEntry(ctx, result, state);
    }
  });
})();

// THE TWO HALVES OF contest_entry, split at the seam a page death runs through.
//
// Everything before the wallet is reached lives in prepare(); everything after
// it answers lives in complete(). They share NOTHING but their arguments,
// because on the redirect transport they execute in DIFFERENT DOCUMENTS.
//
// BASE58 IS THE WIRE FORMAT, and the conversions here are the price of that.
// The server speaks base64 (serialized_tx in, signed_tx out); every wallet
// deeplink protocol speaks base58. The gem's codec owns both directions, so the
// encoding lives here rather than being re-derived at each end.

// Prepare: mint the server-side transaction and hand back ONLY what survives
// serialisation. No Transaction object, no closure, no DOM — this return value
// is written to localStorage verbatim.
window.tmPrepareContestEntry = async function (ctx) {
  console.log('[contest-entry] POST prepare_entry (fresh blockhash + priority fee), currency=' + ctx.currency);
  var resp = await window.authedFetch('/contests/' + ctx.contestId + '/prepare_entry', {
    method: 'POST',
    headers: { 'X-CSRF-Token': ctx.csrfToken, 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ currency: ctx.currency })
  });
  // authedFetch answers falsy on a 401 and has ALREADY surfaced the login modal.
  // The inline flow returns here; a handler must THROW instead, because walletOps
  // is awaiting a promise and a silent undefined would read as a prepared entry.
  if (!resp) throw new Error('Your session expired — sign in and try again.');

  var data = await resp.json();
  console.log('[contest-entry] prepare_entry response:', { success: data.success, error: data.error, entry_pda: data.entry_pda, ptx_slug: data.ptx_slug, serialized_tx_len: data.serialized_tx ? data.serialized_tx.length : null });
  if (!data.success) throw new Error(data.error || 'Failed to prepare entry');

  var bytes = Uint8Array.from(atob(data.serialized_tx), function (c) { return c.charCodeAt(0); });
  return {
    transaction: window.SolanaStudio.walletTransport.base58.encode(bytes),
    ptx_slug: data.ptx_slug,
    entry_id: data.entry_id,
    entry_pda: data.entry_pda,
    token_funded: !!data.token_funded
  };
};

// Complete: hand the wallet's signature to the server, which cosigns and
// broadcasts. Runs in a document that never saw prepare().
window.tmCompleteContestEntry = async function (ctx, result, state) {
  // SIGN-ONLY IS A REQUIREMENT HERE, not a preference — see the intent's comment
  // above. A wallet that broadcast instead of signing returns a signature and no
  // transaction, and there is nothing to recover: the server never got the bytes
  // it must cosign. Refuse loudly rather than post an empty body.
  if (!result || !result.signedTransaction) {
    throw new Error('The wallet broadcast this entry instead of signing it. ' +
                    'This contest needs a co-signature from the server, so the entry could not complete.');
  }

  var signed = window.SolanaStudio.walletTransport.base58.decode(result.signedTransaction);
  // Chunked, because String.fromCharCode.apply blows the argument stack on a
  // full transaction — the same 0x8000 window the inline path uses.
  var sb = '';
  var chunk = 0x8000;
  for (var i = 0; i < signed.length; i += chunk) {
    sb += String.fromCharCode.apply(null, signed.subarray(i, i + chunk));
  }

  var resp = await window.authedFetch('/contests/' + ctx.contestId + '/confirm_onchain_entry', {
    method: 'POST',
    headers: { 'X-CSRF-Token': ctx.csrfToken, 'Content-Type': 'application/json', 'Accept': 'application/json' },
    body: JSON.stringify({ signed_tx: btoa(sb), entry_id: state.entry_id, entry_pda: state.entry_pda, ptx_slug: state.ptx_slug })
  });
  if (!resp) throw new Error('Your session expired before the entry was recorded.');

  var data = await resp.json();
  if (!data.success) throw new Error(data.error || 'Failed to confirm entry');
  console.log('[contest-entry] server cosigned + confirmed on-chain:', data.tx_signature);
  return data;
};
</script>
