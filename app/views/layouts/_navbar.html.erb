<%# Navbar partial — rendered in application layout and admin navbar review.
    Locals (all optional):
      show_logged_in — override for logged_in? (default: real session)
      preview        — if true, disables scroll handler and sticky positioning
%>
<% show_user = local_assigns.fetch(:show_logged_in, logged_in?) %>
<% is_preview = local_assigns.fetch(:preview, false) %>

<%# z-[110] sits BELOW the modal host's z-[120] backdrop. A modal is the
    active task, so its backdrop and card cover all persistent navigation
    chrome instead of appearing cut off beneath the navbar. Toasts remain
    above both layers through the app-level 200/199 overrides below. %>

<%# Toast z-index override now lives in app/assets/tailwind/application.css as CSS
    custom properties (--studio-toast-z / --studio-toast-blur-z), read
    by studio-engine 0.4.10+. The previous inline <style> block here
    needed !important to beat the engine's old inline `style="z-index:60"`;
    the engine no longer uses inline, so the var-based override wins
    via normal cascade. %>
<%# vt-pinned-header (engine 0.24 smooth-load): names this header as the shared
    view-transition element so it stays pinned while page content cross-fades.
    NON-PREVIEW ONLY — the admin navbar-review page renders preview copies of
    this partial inside the body, and a duplicate view-transition-name silently
    disables ALL view transitions on the page. Exactly one pinned header per page. %>
<header data-navbar-root x-data="{ scrolled: false }" <%= '@scroll.window="scrolled = scrolled ? (window.scrollY > 5) : (window.scrollY > 60)"'.html_safe unless is_preview %>
        class="<%= is_preview ? 'bg-page' : 'vt-pinned-header sticky top-0 z-[110] bg-page transition-shadow duration-300' %>"
        :class="scrolled && 'shadow-lg border-b border-subtle is-scrolled'">
  <%# Self-gating (studio-engine >= 0.30). The engine partial was built by
      lifting THIS app's behavior — the QA message composition, the DEVNET chip
      when devnet && !qa, and the link-vs-inert-chip email button — so this is a
      swap, not a downgrade. preview: keeps the admin navbar-review page from
      rendering a second banner — a duplicate pinned-header view-transition name
      silently disables every view transition on the page (see the note above;
      smooth_load_component_test counts that class name here, so don't spell it
      again in prose). %>
  <%= render "studio/banners/environment",
             preview: is_preview,
             devnet: Solana::Config.devnet? %>
  <%= render "shared/impersonation_banner" if !is_preview && impersonating? %>
  <%# .user-nav-col / .nav-title / .nav-logo / .nav-logo-link responsive
      rules live in app/assets/tailwind/application.css @layer utilities (migrated
      2026-05-24, dropped the 10 !important workarounds). %>
  <div class="flex items-center min-w-0 <%= is_preview ? 'py-6' : 'transition-all duration-300' %>"
       <%= ":class=\"scrolled ? 'py-2' : 'py-6'\"".html_safe unless is_preview %>>
    <%# Left side: logo + nav %>
    <div class="flex-1 min-w-0 px-4">
      <div class="flex items-center gap-6 min-w-0">
        <%= link_to root_path, class: "nav-logo-link inline-flex items-center gap-3 group" do %>
          <img src="/icon-192.png" alt="Turf Totals" width="48" height="48" class="nav-logo rounded-full shadow-lg <%= is_preview ? 'w-12 h-12' : 'group-hover:scale-105 transition-all duration-300' %>"
               <%= "x-bind:class=\"scrolled ? 'w-8 h-8' : 'w-12 h-12'\"".html_safe unless is_preview %>>
          <h1 class="nav-title font-extrabold text-heading tracking-tight <%= is_preview ? 'text-3xl' : 'transition-all duration-300' %>"
              <%= "x-bind:class=\"scrolled ? 'text-xl' : 'text-3xl'\"".html_safe unless is_preview %>><span class="dm-salmon">Turf</span><span class="dm-yellow text-primary">Totals</span></h1>
        <% end %>
        <nav class="dm-teal hidden md:flex items-center gap-4 min-w-0">
          <%= link_to "Contests", contests_path, class: "text-secondary hover:text-primary text-sm font-medium transition" %>
          <%= link_to "NFL Totals", nfl_team_totals_path, class: "text-secondary hover:text-primary text-sm font-medium transition" %>
          <%= link_to "Rules", turf_totals_v1_path, class: "text-secondary hover:text-primary text-sm font-medium transition" %>
          <%= link_to "Reserves", proof_of_reserves_path, class: "text-secondary hover:text-primary text-sm font-medium transition" %>
          <%= render "components/geo_badge" %>
        </nav>
      </div>
    </div>
    <%# Right side: user nav (matches sidebar width) %>
    <% balance_html = capture do %>
      <%# The balance SLOT holds two mutually exclusive faces:
            [data-balance-display]     the "$1284" wallet link
            [data-free-entry-label]    the "✨ Free Entry" stand-in
          A $0 balance held by a user WITH an entry token reads "✨ Free Entry"
          instead of a redundant "$0" — the amount they can enter for is zero
          dollars, which is the point, not an empty wallet. The same rule
          re-applies live through applyBalanceSlotRule() in solana_utils.js
          after mints + consumes, so server render and client never drift.
          The label ALSO peeks over the amount while the ✨ badge beside the
          avatar is hovered (.fe-peek, driven by freeEntryHover in _user_nav) —
          that is the answer to "what is this sparkle?". %>
      <%# display_balance is nil while the navbar cache is cold ("loading") —
          the server no longer blocks the render on the balance RPC. HIDE the
          whole balance link (incl. the "$") while loading so there's no lone
          "$" placeholder; client-side refreshBalance() then sets
          [data-balance-display] AND removes .hidden (its else-branch), so the
          full "$112" appears all at once. %>
      <% balance_loading = display_balance.nil? %>
      <% balance_dollars = display_balance.to_f %>
      <% balance_zero    = !balance_loading && balance_dollars.zero? %>
      <%# Cache-first (display_entry_token_count) — nil while cold counts as
          "no tokens" so we don't swap a real $0 balance during loading;
          applyBalanceSlotRule re-applies the swap after hydrate. %>
      <% has_tokens      = display_entry_token_count.to_i.positive? %>
      <% free_entry      = balance_zero && has_tokens %>
      <% hide_balance    = balance_loading || free_entry %>
      <div class="relative flex-shrink-0 leading-none mr-1"
           data-balance-slot="true"
           x-bind:class="freeEntryHover ? 'fe-peek' : ''">
        <%= link_to wallet_path, class: "dm-blue block font-mono text-primary hover:text-primary-600 transition-all duration-300 font-bold leading-none #{'hidden' if hide_balance}", "x-bind:class": "scrolled ? 'text-lg' : 'text-xl'", data: { balance_display: true } do %><% unless balance_loading %>$<%= balance_dollars.to_i %><% end %><% end %>
        <%# No size binding here: the two faces want DIFFERENT sizes (the peek is
            a compact pill, the stand-in matches the amount it replaces), so
            .free-entry-label / .is-active own font-size in application.css. %>
        <%= link_to wallet_path, class: "free-entry-label dm-blue gap-1 font-bold text-primary hover:text-primary-600 leading-none whitespace-nowrap #{'is-active' if free_entry}", data: { free_entry_label: true } do %><span class="fe-spark" aria-hidden="true">✨</span><span>Free Entry</span><% end %>
      </div>
    <% end if show_user %>
    <div class="user-nav-col dm-purple flex-shrink-0 min-w-0 pl-0 pr-4 md:px-4">
      <% if show_user %>
        <%= render "components/user_nav", balance_html: balance_html %>
      <% else %>
        <div class="flex items-center justify-end gap-3">
          <span class="hidden md:flex"><%= render "components/theme_toggle_morph" %></span>
          <%# Single unified CTA — login + signup are one create-or-login flow
              (magic link / Google / wallet all find-or-create). Opens the in-page
              auth modal at the credentials step; href=/signin is the no-JS
              fallback (the page still exists, just unrouted from here for now). %>
          <%= link_to "Sign in", signin_path, class: "btn btn-primary",
                "@click.prevent": "$store.modals.open('auth', { step: 'credentials', mode: 'signup', submitting: null, formError: '', phantomError: '', googleError: '' })" %>
        </div>
      <% end %>
    </div>
  </div>
  <%# Mobile sub-navbar: compact row of links hidden on desktop %>
  <div class="dm-coral flex md:hidden items-center gap-3 px-4 py-1.5 border-t border-subtle bg-surface-alt">
    <%= link_to "Contests", contests_path, class: "text-secondary hover:text-primary text-xs font-medium transition whitespace-nowrap" %>
    <%= link_to "NFL Totals", nfl_team_totals_path, class: "text-secondary hover:text-primary text-xs font-medium transition whitespace-nowrap" %>
    <%= link_to "Rules", turf_totals_v1_path, class: "text-secondary hover:text-primary text-xs font-medium transition whitespace-nowrap" %>
    <%= link_to "Reserves", proof_of_reserves_path, class: "text-secondary hover:text-primary text-xs font-medium transition whitespace-nowrap" %>
    <%= render "components/geo_badge" %>
    <span class="ml-auto flex items-center gap-3">
      <%= render "components/gear_sidebar_trigger" %>
      <%= render "components/theme_toggle_morph" %>
    </span>
  </div>
</header>
<%# --nav-h + overflow-anchor are shipped by studio-engine (>=0.4.4) from
    layouts/studio/_head.html.erb — no per-app navbar script needed. %>
