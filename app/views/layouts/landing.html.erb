<!DOCTYPE html>
<%# Funnel splash always renders dark — it sits on an animated background. %>
<html lang="en" class="dark">
  <head>
    <%# Funnel pages are the URLs most likely to be shared in SMS/Slack/social.
        A per-funnel image set in /admin/landing_pages overrides the preview;
        an unset one falls back to the site identity at /admin/link_preview.
        The title and description resolve the same way the tags do, and the
        tags themselves come from studio-engine's layouts/studio/_head. %>
    <% link_preview image: @landing_page&.og_image %>
    <% identity = studio_link_preview %>
    <title><%= identity[:title] %></title>
    <% if identity[:description] %>
    <meta name="description" content="<%= identity[:description] %>">
    <% end %>

    <%= render "layouts/studio/head" %>
  </head>

  <%# Minimal funnel layout — no navbar or footer, keeps visitors on the CTA. %>
  <body class="bg-page text-body min-h-screen">
    <%= render "layouts/studio/flash" %>
    <%= yield %>
  </body>
</html>
