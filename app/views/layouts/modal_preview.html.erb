<%#
  Stripped layout for /admin/modals iframe previews. Mirrors the
  essential pieces of application.html.erb (Tailwind, Alpine, the
  modal host, the session + solanaModal stores) and DROPS everything
  the modal partials don't need:

    - LogRocket (script + identify)
    - Invite link capture + set_inviter
    - Devnet refresh-balance startup ping
    - Navbar + phantom watcher + solana errors + flash
    - User-change localStorage cleanup
    - The max-w-7xl content wrapper (we yield directly under body)

  Result: each preview iframe loads roughly 70 pct less JS/DOM than the
  full layout, and the console doesn't spam TensorFlow.js kernel warnings.
  (Spelled "pct" on purpose: ERB comment bodies must contain zero percent
  characters — see docs/UI_PATTERNS.md "Alpine + ERB Constraints".)
%>
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Modal Preview" %></title>
    <link rel="apple-touch-icon" href="/favicon.png">
    <%# Solana web3 + nacl — ONLY the username modal's signing path needs
        them. Loading ~1.5MB from unpkg in every preview iframe stalled the
        gallery's page load (15+ iframes × unpkg), so scope it to the one
        modal that uses it. @modal_id is nil for modal_preview_crop → skipped. %>
    <% if @modal_id == "username" %>
      <script src="https://unpkg.com/@solana/web3.js@1/lib/index.iife.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/tweetnacl@1.0.3/nacl-fast.min.js"></script>
    <% end %>
    <%# Cropper.js + image-upload factories (cropPhotoModal) — the crop-photo
        modal preview needs them; ships from studio-engine (v0.4.12). %>
    <%= render "studio/cropper_assets" %>
    <% content_for :head do %>
      <%# Session context — modal partials read $store.session. Reuses the
          same #session-context JSON tag the application layout writes. %>
      <script type="application/json" id="session-context"><%= wallet_context.to_json.html_safe %></script>
      <script>
        // Minimal wallet provider stub (full module overwrites on import).
        window.walletProvider = {
          isAvailable: function() {
            return !!(window.__WALLET_KEYPAIR_SECRET) || !!(window.phantom && window.phantom.solana && window.phantom.solana.isPhantom);
          },
          isMobile: function() {
            return /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || (navigator.maxTouchPoints > 1 && /Macintosh/.test(navigator.userAgent));
          },
          detect: function() { return null; }
        };

        // solanaWalletConnect — auth modal's Phantom button references this
        // function in its x-data, so the stub must exist before Alpine inits.
        // The preview never actually clicks Phantom; we just need the symbol.
        window.solanaWalletConnect = function() {
          return { connecting: false, error: null, statusText: 'Connect Wallet',
                   walletAvailable: false, isMobile: false,
                   async connect() { /* preview no-op */ } };
        };

        document.addEventListener('alpine:init', function() {
          if (Alpine.store('solanaModal')) return;

          Alpine.store('session', {
            loggedIn: false, mode: 'guest', phantomLinked: false,
            userId: null, address: '',
            usdcCents: 0, usdtCents: 0, tokensAvailable: 0,
            get isGuest() { return this.mode === 'guest'; },
            get isWeb2()  { return this.mode === 'web2';  },
            get isWeb3()  { return this.mode === 'web3';  },
            hydrate: function(ctx) {
              if (!ctx) return;
              this.loggedIn = !!ctx.loggedIn;
              this.mode = ctx.mode || 'guest';
              this.phantomLinked = !!ctx.phantomLinked;
              this.userId = ctx.userId || null;
              this.address = ctx.address || '';
              if (ctx.usdcCents       !== undefined) this.usdcCents       = (ctx.usdcCents       == null) ? null : (ctx.usdcCents       | 0);
              if (ctx.usdtCents       !== undefined) this.usdtCents       = (ctx.usdtCents       == null) ? null : (ctx.usdtCents       | 0);
              if (ctx.tokensAvailable !== undefined) this.tokensAvailable = (ctx.tokensAvailable == null) ? 0    : (ctx.tokensAvailable | 0);
            }
          });
          (function() {
            var el = document.getElementById('session-context');
            if (!el) return;
            try { Alpine.store('session').hydrate(JSON.parse(el.textContent)); } catch (e) {}
          })();

          // solanaModal store — proxy over Alpine.store('modals') for the
          // onchain-tx preview. Same shape as application.html.erb; kept
          // in sync manually. If you touch one, touch the other.
          var _txCluster = document.body ? (document.body.dataset.solanaCluster || 'devnet') : 'devnet';
          var _txClusterParam = _txCluster === 'devnet' ? '?cluster=devnet' : '';
          var _onCurrent = function() {
            var c = Alpine.store('modals').current();
            return (c && c.id === 'onchain-tx') ? c : null;
          };
          var _propRead = function(k, fb) { var c = _onCurrent(); return c ? (c.props[k] !== undefined ? c.props[k] : fb) : fb; };
          Alpine.store('solanaModal', {
            _recoveryHandler: null, _onCloseHandler: null,
            show: function() { /* preview no-op */ },
            success: function() { /* preview no-op */ },
            error:   function() { /* preview no-op */ },
            close:   function() { if (_onCurrent()) Alpine.store('modals').close(); },
            setRecovery: function() { /* preview no-op */ },
            _triggerRecovery: function() { /* preview no-op */ },
            get visible()         { return !!_onCurrent(); },
            get state()           { return _propRead('state', null); },
            get title()           { return _propRead('title', ''); },
            get message()         { return _propRead('message', ''); },
            get txSignature()     { return _propRead('txSignature', null); },
            get errorMessage()    { return _propRead('errorMessage', null); },
            get seedsEarned()     { return _propRead('seedsEarned', 0); },
            get seedsTotal()      { return _propRead('seedsTotal', 0); },
            get seedsLevel()      { return _propRead('seedsLevel', 0); },
            get lobbyUrl()        { return _propRead('lobbyUrl', null); },
            get recoveryLabel()   { return _propRead('recoveryLabel', null); },
            get recoveryPhantom() { return _propRead('recoveryPhantom', false); },
            get explorerUrl()     { var tx = this.txSignature; return tx ? ('https://explorer.solana.com/tx/' + tx + _txClusterParam) : null; }
          });
        });
      </script>
    <% end %>
    <%= render "layouts/studio/head" %>
  </head>

  <body x-data class="bg-page text-body" data-logged-in="<%= logged_in? %>" data-user-id="<%= current_user&.id %>" data-solana-cluster="<%= Solana::Config.devnet? ? 'devnet' : 'mainnet-beta' %>" data-solana-rpc-url="<%= Solana::Config.public_rpc_url %>">
    <%# Inline x-data factories (cdpRampFlow, emailValidator, …). The app
        layout renders these for every page; the preview iframes need them
        too or any modal whose x-data references a factory mounts as a
        silent no-op (the username preview only worked because its modal
        mounts after the importmap duplicate loads — cdpRampFlow has no
        module duplicate). %>
    <%= render "shared/alpine_factories" %>
    <%= render "studio/birthday_assets" %>
    <%= yield %>
    <%= render "studio/modals/host" do %>
      <template x-if="$store.modals.current().id === 'auth'">
        <%= render "modals/auth" %>
      </template>
      <template x-if="$store.modals.current().id === 'onchain-tx'">
        <%= render "modals/onchain_tx" %>
      </template>
      <template x-if="$store.modals.current().id === 'crop-photo'">
        <%= render "studio/modals/crop_photo" %>
      </template>
      <template x-if="$store.modals.current().id === 'wallet-deposit'">
        <%= render "modals/wallet_deposit" %>
      </template>
      <template x-if="$store.modals.current().id === 'wallet-connect'">
        <%= render "modals/wallet_connect" %>
      </template>
      <template x-if="$store.modals.current().id === 'wallet-changed'">
        <%= render "modals/wallet_changed" %>
      </template>
      <%# wallet-setup — the web3-only onboarding step. Registered here as well
          as in the app layout; this preview layout keeps its OWN registration
          list, so a modal added to only one of them renders blank in the other. %>
      <%# Onboarding chain step 1 — the first-name capture, and the whole modal
          (the welcome step and its step machine were retired 2026-08-15).
          Registered ungated so the chain driver can always reach it. %>
      <template x-if="$store.modals.current().id === 'onboarding'">
        <%= render "modals/onboarding" %>
      </template>
      <template x-if="$store.modals.current().id === 'wallet-setup'">
        <%= render "modals/wallet_setup" %>
      </template>
      <%# web3-step-up — registered here AND in the app layout, per the note
          above: this preview layout keeps its own list, and a modal in only one
          of them renders as a blank card in the other. The catalogue entry for
          this card moved to the engine style guide on 2026-08-24, but the
          registration STAYS: #modal_preview is addressed by id and does not
          consult MODAL_VARIANTS, and this app's component test for the card
          previews it through here.

          Same partial and same locals as the app layout, via the helper — this
          card is exactly where an inline copy drifted before. %>
      <template x-if="$store.modals.current().id === 'web3-step-up'">
        <%= render "studio/modals/web3_step_up", **web3_step_up_locals %>
      </template>
      <%# age-verify was MISSING here until 2026-08-19 — the exact gap the note
          above warns about. The gallery listed the variant and /admin/modals
          opened it, but this layout had no registration for the id, so the card
          rendered empty: the preview looked like a working modal with nothing in
          it. Found while adding the chain's 2-of-3 pill to it, which nobody
          could have reviewed. %>
      <template x-if="$store.modals.current().id === 'birthday'">
        <%= render "modals/birthday" %>
      </template>
      <%# ...and the card it hands a refusal to. Registering one without the
          other is what produced the empty card described above. %>
      <template x-if="$store.modals.current().id === 'age-gate'">
        <%= render "studio/modals/blocks/age_gate", **age_gate_modal_locals %>
      </template>
      <template x-if="$store.modals.current().id === 'buy-entry-token'">
        <%= render "modals/buy_entry_token" %>
      </template>
      <%# cdp-ramp — NOT flag-gated here (unlike the app layout): the gallery
          is the admin dev tool and should preview the Coinbase flow even
          while ENABLE_CDP_RAMP is unset. The modal alone makes no requests
          until a CTA is clicked. %>
      <template x-if="$store.modals.current().id === 'cdp-ramp'">
        <%= render "modals/cdp_ramp" %>
      </template>
      <% if logged_in? %>
        <template x-if="$store.modals.current().id === 'username'">
          <%= render "modals/username" %>
        </template>
      <% end %>

      <%# Template reference modals — surfaced in the gallery as "Templates". %>
      <% unless Rails.env.production? %>
        <template x-if="$store.modals.current().id === 'template-form'">
          <%= render "studio/modals/templates/form" %>
        </template>
        <template x-if="$store.modals.current().id === 'template-action'">
          <%= render "studio/modals/templates/action" %>
        </template>
        <template x-if="$store.modals.current().id === 'template-status'">
          <%= render "studio/modals/templates/status" %>
        </template>
        <template x-if="$store.modals.current().id === 'template-success'">
          <%= render "studio/modals/templates/success" %>
        </template>
        <template x-if="$store.modals.current().id === 'template-wizard'">
          <%= render "studio/modals/templates/wizard" %>
        </template>
      <% end %>
    <% end %>
  </body>
</html>
