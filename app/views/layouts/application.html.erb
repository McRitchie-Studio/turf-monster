              // not re-derived. This rejection is not yet a user-facing failure:
              // the fallback below either SUCCEEDS, in which case the user signed
              // in and a row would be noise on a triage surface (see the
              // over-reporting guard in e2e/wallet_failure_report.spec.js), or it
              // fails too and reports its own rejection with the wallet's words
              // intact. An extension holding no keypair fails both calls with the
              // same generic string, which is the case the reporting exists for.
              // What is genuinely lost is a signIn rejection that differs from the
              // fallback's; that stays in the console, deliberately, rather than
              // buying it with a row per successful two-prompt sign-in.
              console.warn('[siws] signIn unusable, falling back to connect + signMessage:', rejMsg);
              useSignIn = false;
            }
          }

          if (!useSignIn) {
            // THE CATCH BELOW HAS EXACTLY ONE DIAGNOSIS, AND THIS IS ITS SCOPE.
            // `connected` flips the instant connect() hands back a publicKey. At
            // that moment the wallet has PROVEN it holds a keypair, so nothing
            // that fails afterwards — a signMessage rejection, our own nonce
            // fetch — can be a wallet with no wallet in it. Declared out here
            // because the catch has to read it, and `var` in the try would be
            // hoisted-but-unassigned on the paths that matter.
            var connected = false;
            try {
              var resp = await provider.connect();
              pubkeyB58 = resp.publicKey.toBase58();
              connected = true;
              // AWAITED HERE, BELOW connect(), ON PURPOSE. The fetch was fired at
              // the top of this function; blocking on it only now means the round
              // trip runs while the wallet sheet is open and the human is reading
              // it, rather than before the sheet exists. The tagged rejection
              // above is what makes that safe — see the first guard in the catch.
              var data = await noncePromise;
              // Byte-identical to the message this flow has always signed.
              message = domain + ' wants you to sign in with your Solana account:\n' + pubkeyB58 + '\n\n' + userIdLine + 'Sign in to Turf Monster\n\nNonce: ' + data.nonce;
              var signed = await provider.signMessage(new TextEncoder().encode(message), 'utf8');
              signatureB58 = encodeBase58(signed.signature);
            } catch (e) {
              // AN INSTALLED WALLET WITH NO WALLET IN IT. Hit on production
              // 2026-09-06: the Phantom extension is present — so the picker
              // paints "Installed" and supportsSignIn() is true — but it holds no
              // keypair, and Phantom is sitting on its own "create a new wallet or
              // import an existing one" onboarding. With nothing to sign, signIn()
              // rejects with Phantom's generic "Unexpected error" and this fallback
              // rejects the same way.
              //
              // That string used to travel to parseSolanaError, whose generic
              // branch reads it as a TRANSACTION failure and answers "Wallet
              // couldn't process the transaction. Check wallet connection and USDC
              // balance." — balance advice, in a connect modal, for a user who
              // attempted no transaction and may hold no wallet at all.
              //
              // Rethrow in the vocabulary of the thing that actually failed.
              // parseSolanaError's final line passes unrecognised messages through
              // untouched, so this reaches the picker verbatim without changing the
              // shared mapper, whose transaction wording is correct for the entry
              // paths that own it.
              //
              // A DECLINE IS NOT AN INCAPABILITY — the same rule the signIn guard
              // above states. A human who said no keeps reading "Signature
              // rejected"; only a wallet that could not answer gets the setup copy.
              //
              // THE FOUR GUARDS BELOW ARE THE WHOLE OF THIS FIX. Each one names a
              // failure that is DEMONSTRABLY not "an installed wallet with no
              // wallet in it". THREE RETHROW THE ORIGINAL UNTOUCHED; ONE CANNOT.
              //
              // An untouched rethrow is honest only while parseSolanaError leaves
              // the string alone, and it does NOT do that universally. Its generic
              // branch (app/javascript/solana_errors.js) rewrites both
              // `Unexpected error` and anything matching /^unexpected/i into
              // "Wallet couldn't process the transaction. Check wallet connection
              // and USDC balance." Every surface maps before painting -- see
              // modals/_wallet_setup.html.erb and solana-studio's
              // _wallet_connect.html.erb -- so rethrowing that particular string
              // hands balance advice to someone who attempted no transaction.
              // The `connected` guard below therefore substitutes its own
              // sentence; the other three rethrow strings that genuinely survive
              // the mapper, which the e2e spec pins against the page's OWN mapper
              // rather than a copy.
              //
              // THAT LEFT ONE HOLE OPEN UNTIL 2026-09-08, AND IT IS NOW CLOSED
              // UPSTREAM OF HERE. A nonce fetch that failed with an HTML body
              // made r.json() reject with "Unexpected token '<' ... is not valid
              // JSON", which matches that same /^unexpected/i branch, so the
              // commonest server-failure shape still landed on the transaction
              // sentence. The substitution for it lives in the nonce fetch
              // itself (see nonceServerCopy above), NOT in this guard: the signIn
              // branch awaits that promise above its own try, so a guard here
              // could never have covered it, and only the fetch knows whether the
              // request failed to arrive or came back unreadable. The mapper is
              // untouched -- its transaction wording still belongs to the entry
              // paths that own it. See docs/AUTH.md and
              // test/views/nonce_server_failure_copy_test.rb.

              // OUR OWN SERVER, FIRST. /auth/solana/nonce failing is an offline
              // moment or a blip on our side. Telling that user to create a
              // wallet is the same confidently-wrong diagnosis this whole task
              // exists to remove, pointed at a different innocent party. Either
              // shape arrives tagged, so this rethrow stays exactly as it was:
              // a network failure carries its own words, and a server fault
              // carries the sentence composed for it.
              if (e && e.nonceFetchFailed) throw e;

              var em = (e && e.message) ? e.message : String(e);
              if (/user rejected/i.test(em) || /user declined/i.test(em) || (e && e.code === 4001)) throw e;

              // provider.name is a lowercase SLUG on the legacy provider ('phantom',
              // wallet_provider.js:69) but a display name on the Wallet Standard
              // adapter (:289), so capitalise it. Nothing sets label/displayName.
              //
              // HOISTED ABOVE BOTH SUBSTITUTING GUARDS. Each of them now reports
              // before it replaces the wallet's string, and a report names the
              // brand, so this has to be in hand before the FIRST of them runs.
              var brand = (provider && (provider.label || provider.displayName)) ||
                          (provider && provider.name ? provider.name.charAt(0).toUpperCase() + provider.name.slice(1) : '') ||
                          'your wallet';

              // CONNECT ALREADY ANSWERED. A publicKey came back, so a keypair
              // exists; whatever rejected afterwards (signMessage, most often
              // with Phantom's same generic "Unexpected error") is a signing
              // failure, and "create or import one" is flatly false advice for
              // someone whose wallet just identified itself.
              //
              // SUBSTITUTED, NOT RETHROWN -- the one guard here that cannot pass
              // its error through, for the reason stated above: "Unexpected
              // error" is the string this path carries most often, and it is
              // exactly what the mapper turns into balance advice. This sentence
              // survives parseSolanaError untouched and says only what is known
              // -- the wallet identified itself and then did not sign. The
              // wallet's own string is generic here and the substitution costs it
              // from error_logs, the same trade the setup copy above already
              // makes; docs/AUTH.md carries that consequence into triage.
              //
              // REPORTED BEFORE IT SUBSTITUTES, for exactly the reason the setup
              // copy below is — the long note there is the argument, and it
              // applies here unchanged the moment this guard replaces a string.
              // `em` still holds what the wallet actually said, which on this
              // path is Phantom's generic "Unexpected error" far more often than
              // anything else; the sentence below is what the user reads. A
              // report made downstream of this throw would carry OUR words in
              // both halves, which is the byte-identical row this task exists to
              // remove — the defect simply relocated to a newer guard.
              //
              // ITS OWN STAGE, NOT connect_verify_fallback. That stage means the
              // wallet could not answer connect() at all; here connect() ANSWERED
              // and signMessage refused. The two need different responses from an
              // operator, so they get different filters (Solana::ClientFailureReport::STAGES).
              if (connected) {
                var signFailCopy = 'Your wallet connected but could not sign you in. Signing in moves no funds \u2014 try again.';
                if (typeof window.reportWalletFailure === 'function') {
                  window.reportWalletFailure('connect_verify_signature', brand, em, signFailCopy);
                }
                var signFailError = new Error(signFailCopy);
                signFailError.walletFailureReported = true;
