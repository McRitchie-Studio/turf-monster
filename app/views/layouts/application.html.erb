              // same failure lands twice: once with the wallet's words, and once
              // with ours in both halves — and the useless row is the one an
              // operator meets first. The tag is a plain property for the same
              // reason wallet_provider.js gives for its own: an `instanceof` does
              // not survive script boundaries and a sentinel inside the message
              // would be read by a human.
              var setupError = new Error(setupCopy);
              setupError.walletFailureReported = true;
              throw setupError;
            }
