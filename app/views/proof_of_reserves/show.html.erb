<% content_for :title, "Proof of Reserves — Turf Monster" %>
<% link_preview description: "Every contest's prize pool is a USDC vault on Solana. See it live, from chain." %>

<%
  cfg = @page_config
  explorer = lambda do |kind, value|
    "https://explorer.solana.com/#{kind}/#{value}#{cfg[:network] == 'mainnet-beta' ? '' : "?cluster=#{cfg[:network]}"}"
  end
  short_pubkey = ->(key) { key.present? ? "#{key[0, 4]}…#{key[-4..]}" : "" }
  contests = cfg[:contests]
%>
<%# The proof-of-reserves controller reads the chain from the browser and
    fills the banner and each contest's row. The server renders what is known
    without the chain (the config, the links) and the loading state: Refresh
    disabled and every row "Loading…", because connect starts a refresh. An
    element whose colour follows a state carries each state's classes as
    data-<state>-class, and the controller puts exactly one set on. %>
<div class="max-w-4xl mx-auto py-8 px-2" data-test="proof-of-reserves"
     data-controller="proof-of-reserves"
     data-proof-of-reserves-rpc-url-value="<%= cfg[:rpc_url] %>">

  <!-- ========== HERO ========== -->
  <section class="text-center mb-10">
    <div class="mb-4 flex items-center justify-center gap-3">
      <span class="px-3 py-1 bg-primary-900/30 text-primary text-xs font-bold uppercase tracking-widest rounded-full border border-primary-700">
        Live · <span><%= cfg[:network] %></span>
      </span>
    </div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-heading mb-3">
      Proof of <span class="text-primary">Reserves</span>
    </h1>
    <p class="text-secondary text-lg max-w-xl mx-auto">
      Every contest's prize pool is held in a USDC vault on Solana. This page reads the program's accounts
      <span class="text-heading font-semibold">directly from your browser</span> — no Turf Monster server in the middle.
    </p>
  </section>

  <!-- ========== SOLVENCY BANNER ========== -->
  <section class="mb-10">
    <div class="card border-2 p-6 shadow-lg border-subtle" data-proof-of-reserves-target="card"
         data-ok-class="border-mint/60 shadow-mint/10" data-warn-class="border-red-500/60 shadow-red-500/10" data-muted-class="border-subtle">
      <div class="flex items-start justify-between gap-4 flex-wrap">
        <div>
          <p class="text-xs uppercase tracking-widest text-muted mb-2">Vault solvency</p>
          <p class="text-3xl md:text-4xl font-extrabold text-heading" data-proof-of-reserves-target="label"
             data-ok-class="text-mint" data-warn-class="text-danger-ink" data-muted-class="text-heading">Checking…</p>
        </div>
        <button type="button" class="btn btn-secondary text-sm" disabled
                data-proof-of-reserves-target="refresh" data-action="proof-of-reserves#refresh">
          <span data-proof-of-reserves-target="idle" hidden>Refresh</span>
          <span data-proof-of-reserves-target="busy">Refreshing…</span>
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
        <div class="bg-surface-alt rounded-xl p-4 border border-subtle">
          <p class="text-xs text-muted uppercase tracking-wider mb-1">USDC reserves (on-chain prize pools)</p>
          <p class="font-mono text-2xl text-heading" data-proof-of-reserves-target="reserves">—</p>
          <p class="text-xs text-muted mt-1">Summed across every open &amp; locked contest's prize-pool account</p>
        </div>
        <div class="bg-surface-alt rounded-xl p-4 border border-subtle">
          <p class="text-xs text-muted uppercase tracking-wider mb-1">Guaranteed prizes owed</p>
          <p class="font-mono text-2xl text-heading" data-proof-of-reserves-target="obligations">—</p>
          <p class="text-xs text-muted mt-1">Across all open & locked contests</p>
        </div>
      </div>

      <p class="text-xs text-muted mt-4" data-proof-of-reserves-target="fetched" hidden>
        Last refreshed <span data-proof-of-reserves-target="fetchedAt"></span>
      </p>
      <%# POLITE, NOT ASSERTIVE. refresh() runs from init() as well as from the
          Refresh button, so this paragraph can fill while someone is still
          reading the page they just opened. role=status queues the sentence for
          the next pause instead of interrupting; the failure is informational
          and blocks nothing. Guard: test/views/error_live_regions_test.rb %>
      <p class="text-xs text-danger-ink mt-4" data-proof-of-reserves-target="bannerError" hidden
         role="status" aria-live="polite" aria-atomic="true"></p>
    </div>
  </section>

  <!-- ========== HOW IT WORKS ========== -->
  <section class="mb-10">
    <p class="text-primary font-mono text-sm mb-2">How it works</p>
    <div class="card border border-subtle p-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
        <div>
          <p class="text-heading font-semibold mb-1">1. Program ID</p>
          <a href="<%= explorer.call("address", cfg[:program_id]) %>" target="_blank" rel="noopener"
             class="font-mono text-xs text-violet-ink break-all hover:underline"><%= cfg[:program_id] %></a>
        </div>
        <div>
          <p class="text-heading font-semibold mb-1">2. USDC mint</p>
          <a href="<%= explorer.call("address", cfg[:usdc_mint]) %>" target="_blank" rel="noopener"
             class="font-mono text-xs text-violet-ink break-all hover:underline"><%= cfg[:usdc_mint] %></a>
        </div>
        <div>
          <p class="text-heading font-semibold mb-1">3. Per-contest prize pool</p>
          <p class="font-mono text-xs text-secondary break-all">prize_pool token account</p>
          <p class="text-[10px] text-muted mt-1 font-mono">seeds = [b"prize_pool", sha256(slug)]</p>
        </div>
      </div>
      <p class="text-muted text-xs mt-5 leading-relaxed">
        Your browser opens an RPC connection to <span class="font-mono text-secondary" data-test="proof-of-reserves-rpc-url"><%= cfg[:rpc_url] %></span>,
        reads each Contest PDA (seeds: <span class="font-mono text-secondary">[b"contest", sha256(slug)]</span>)
        and Borsh-decodes its prizes, entry count, and status, then reads that contest's prize-pool
        token account balance directly. The reserves figure above is the sum of those balances.
      </p>
    </div>
  </section>

  <!-- ========== PER-CONTEST TABLE ========== -->
  <section class="mb-10">
    <p class="text-primary font-mono text-sm mb-2">Contests on-chain</p>
    <p class="text-secondary text-base mb-5">
      <%= contests.size %> active contest<%= "s" unless contests.size == 1 %>.
      Each card shows the prize pool USDC currently reserved by the program, alongside Solana Explorer links for the contest, creator, admin, and create transaction.
    </p>

    <% if contests.empty? %>
      <div class="card border border-subtle p-8 text-center">
        <p class="text-muted">No on-chain contests right now. Check back after the next one opens.</p>
      </div>
    <% end %>

    <%# One payout chip, cloned per payout and filled with textContent. %>
    <template data-proof-of-reserves-target="payout">
      <div class="bg-surface-alt rounded-lg px-3 py-1.5 border border-subtle text-xs">
        <span class="text-muted" data-field="place"></span>
        <span class="font-mono text-heading font-semibold ml-1" data-field="amount"></span>
      </div>
    </template>

    <div class="space-y-4">
      <% contests.each do |c| %>
        <div class="card border border-subtle p-5" data-proof-of-reserves-target="row"
             data-contest-pda="<%= c[:contest_pda] %>" data-prize-pool-pda="<%= c[:prize_pool_pda] %>">
          <!-- Header row -->
          <div class="flex items-start justify-between gap-4 flex-wrap mb-5">
            <div class="flex-1 min-w-0">
              <p class="text-heading font-bold text-lg truncate"><%= c[:name] %></p>
              <p class="text-muted text-xs mt-0.5" data-field="season" hidden>
                Season <span class="font-mono" data-field="seasonId"></span>
              </p>
            </div>
            <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-muted/20 text-muted border border-subtle"
                  data-field="status" data-ok-class="bg-mint/20 text-mint border border-mint/30"
                  data-warn-class="bg-violet/20 text-violet-ink border border-violet/30"
                  data-muted-class="bg-muted/20 text-muted border border-subtle">Loading…</span>
          </div>

          <!-- Loading state -->
          <div class="text-muted text-sm font-mono" data-field="loading">Reading account…</div>

          <!-- Error state -->
          <div class="text-danger-ink text-sm" data-field="error" hidden></div>

          <!-- Decoded state -->
          <div data-field="decoded" hidden>
            <!-- Headline stats -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm mb-5">
              <div class="bg-surface-alt rounded-lg p-3 border border-mint/30">
                <p class="text-[10px] text-muted uppercase tracking-wider mb-1">Prize pool on-chain</p>
                <div class="flex items-center gap-1.5">
                  <img src="/usdc-mark.svg" alt="USDC" class="w-5 h-5 flex-shrink-0">
                  <p class="font-mono text-mint text-lg font-bold" data-field="prizePool"></p>
                </div>
                <p class="text-[10px] mt-0.5 text-muted" data-field="poolNote"
                   data-covered-class="text-muted" data-short-class="text-danger-ink"></p>
              </div>
              <div class="bg-surface-alt rounded-lg p-3 border border-subtle">
                <p class="text-[10px] text-muted uppercase tracking-wider mb-1">Guaranteed prize</p>
                <p class="font-mono text-primary text-lg font-bold" data-field="prizes"></p>
              </div>
              <div class="bg-surface-alt rounded-lg p-3 border border-subtle">
                <p class="text-[10px] text-muted uppercase tracking-wider mb-1">Entries</p>
                <p class="font-mono text-heading text-lg font-bold">
                  <span data-field="currentEntries"></span>
                  <span class="text-muted">/</span>
                  <span data-field="maxEntries"></span>
                </p>
              </div>
              <div class="bg-surface-alt rounded-lg p-3 border border-subtle">
                <p class="text-[10px] text-muted uppercase tracking-wider mb-1">Entry fee</p>
                <p class="font-mono text-heading text-lg font-bold" data-field="entryFee"></p>
              </div>
            </div>

            <!-- Payout breakdown -->
            <div class="mb-5" data-field="payouts" hidden>
              <p class="text-[10px] text-muted uppercase tracking-wider mb-2">Payouts</p>
              <div class="flex flex-wrap gap-2" data-field="payoutList"></div>
            </div>

            <!-- Solana links -->
            <div>
              <p class="text-[10px] text-muted uppercase tracking-wider mb-2">On-chain</p>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-1.5 text-xs">
                <a href="<%= explorer.call("address", c[:contest_pda]) %>" target="_blank" rel="noopener"
                   class="flex items-center justify-between bg-surface-alt rounded px-3 py-2 border border-subtle hover:border-violet/50 group">
                  <span class="text-muted">Contest PDA</span>
                  <span class="font-mono text-violet-ink group-hover:underline inline-flex items-center gap-1.5">
                    <span><%= short_pubkey.call(c[:contest_pda]) %></span>
                    <img src="/solana-mark.svg" alt="" class="w-3 h-3">
                  </span>
                </a>
                <a href="<%= explorer.call("address", c[:prize_pool_pda]) %>" target="_blank" rel="noopener"
                   class="flex items-center justify-between bg-surface-alt rounded px-3 py-2 border border-subtle hover:border-violet/50 group">
                  <span class="text-muted">Prize pool</span>
                  <span class="font-mono text-violet-ink group-hover:underline inline-flex items-center gap-1.5">
                    <span><%= short_pubkey.call(c[:prize_pool_pda]) %></span>
                    <img src="/solana-mark.svg" alt="" class="w-3 h-3">
                  </span>
                </a>
                <% if c[:create_tx_signature].present? %>
                  <a href="<%= explorer.call("tx", c[:create_tx_signature]) %>" target="_blank" rel="noopener"
                     class="flex items-center justify-between bg-surface-alt rounded px-3 py-2 border border-subtle hover:border-violet/50 group">
                    <span class="text-muted">Created <span><%= c[:created_label] %></span></span>
                    <span class="font-mono text-violet-ink group-hover:underline inline-flex items-center gap-1.5">
                      <span><%= short_pubkey.call(c[:create_tx_signature]) %></span>
                      <img src="/solana-mark.svg" alt="" class="w-3 h-3">
                    </span>
                  </a>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <hr class="border-subtle my-10">

  <!-- ========== FOOTNOTE ========== -->
  <section class="text-center py-4">
    <p class="text-muted text-xs max-w-xl mx-auto leading-relaxed">
      As of v0.16 each contest's USDC sits in its own prize-pool token account
      (<span class="font-mono">seeds = [b"prize_pool", sha256(slug)]</span>), authority-controlled by the turf-vault
      program's vault-state PDA — so every contest's reserve is independently verifiable on-chain.
      The obligation each pool must cover is the contest's guaranteed prize (<span class="font-mono">prize_pool</span> on the Contest PDA,
      equal to the sum of its payouts); collected entry fees are operator revenue, tracked in a separate account.
    </p>
  </section>

</div>
