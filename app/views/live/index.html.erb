<% slot_label = if @slot.nil?
     "NFL"
   else
     type = Game::SEASON_TYPES[@slot[:season_type]]
     prefix = type == "regular" ? "" : "#{type.to_s.titleize} · "
     "#{@slot[:season_year]} NFL · #{prefix}Week #{@slot[:week]}"
   end %>
<% content_for(:title) { "#{slot_label} — Live Scores" } %>

<%# ONE stream for the whole board. Nfl::LiveBroadcast updates the scoreboard
    target and appends to the event feed; nothing on this page polls. %>
<%= turbo_stream_from "nfl_live" %>

<%# max-w-7xl, not 6xl: four cards across need the extra 128px to keep each
    one wide enough for a mascot, a city and a two-digit score without truncation. %>
<div class="max-w-7xl mx-auto px-4 py-6">
  <div class="mb-5 flex items-start justify-between gap-3 flex-wrap">
    <div class="min-w-0">
      <p class="text-sm text-secondary font-medium">Live Scoreboard</p>
      <h1 class="text-2xl md:text-3xl font-extrabold text-heading flex items-center gap-2 flex-wrap">
        <%= slot_label %>
        <% if @games.any?(&:live?) %>
          <span class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-red-400">
            <span class="h-2 w-2 rounded-full bg-red-500 animate-pulse"></span> Live
          </span>
        <% end %>
      </h1>
    </div>
    <%= render "live/dev_score_tools", games: @games %>
  </div>

  <div id="nfl_live_scoreboard">
    <%= render "live/scoreboard", games: @games %>
  </div>

  <%# Hidden event feed — broadcast_append_to drops data-only nodes here; the
      observer below turns each into the scoring animation, then removes it.
      aria-hidden because these nodes are DATA, not prose: they carry bare
      attributes a screen reader would read as noise. The announcement lives in
      the live region below instead, written as a sentence. %>
  <div id="nfl_live_event_feed" class="hidden" aria-hidden="true"></div>

  <%# THE SCREEN-READER ANNOUNCEMENT. Everything else about a scoring play is
      visual — a banner, a colour wash, a number that swells — so without this a
      non-sighted viewer is told nothing at all when the board moves. polite, so
      it waits for a pause rather than interrupting. %>
  <div id="nfl_live_announcer" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
</div>

<%# The scoring banner. One reused element rather than one per event, so a
    rapid-fire sequence (a touchdown and its two-point conversion) replaces the
    banner instead of stacking a pile of them down the screen. %>
<%# z-[130] clears the whole fixed-chrome stack: the navbar sits at z-[110]
    and the modal host's backdrop at z-[120] (see layouts/_navbar). A scoring
    banner that a sticky header can paint over is a scoring banner nobody
    sees — which is exactly what z-50 bought before this was measured. It is
    pointer-events-none and self-dismisses, so sitting on top costs nothing. %>
<div id="nfl-score-overlay" class="fixed inset-x-0 top-0 z-[130] pointer-events-none hidden">
  <div id="nfl-score-banner" class="mx-auto max-w-lg m-3 rounded-xl shadow-2xl overflow-hidden relative">
    <div class="px-5 py-4 flex items-center gap-4">
      <span id="nfl-score-emoji" class="text-4xl leading-none"></span>
      <div class="min-w-0 flex-1">
        <div id="nfl-score-label" class="text-xl font-extrabold uppercase tracking-wide leading-tight"></div>
        <div id="nfl-score-team" class="text-sm font-semibold opacity-90 truncate"></div>
      </div>
      <div id="nfl-score-points" class="text-3xl font-black tabular-nums opacity-95"></div>
    </div>
    <div id="nfl-score-line" class="px-5 py-2 text-sm font-bold tabular-nums bg-black/25"></div>
    <span id="nfl-score-shimmer" class="absolute inset-0 pointer-events-none"></span>
  </div>
</div>


<style>
  /* ── BANNER ENTRANCES — one per scoring type ────────────────────────────
     Each type gets its own motion because the motion is the point: a glance
     should tell you WHAT happened before you have read a word of it. They are
     deliberately different in weight, not just in duration — a touchdown
     should not feel like an extra point played faster. */

  /* TOUCHDOWN — the heaviest arrival. Slams down, overshoots, settles. */
  @keyframes nflBannerTd {
    0%   { transform: translateY(-140%) scale(.92); opacity: 0; }
    55%  { transform: translateY(8%)    scale(1.05); opacity: 1; }
    78%  { transform: translateY(-3%)   scale(.99); }
    100% { transform: translateY(0)     scale(1); opacity: 1; }
  }
  /* FIELD GOAL — kicked up and through: rises, tilts, straightens. */
  @keyframes nflBannerFg {
    0%   { transform: translateY(-60%) rotate(-4deg); opacity: 0; }
    55%  { transform: translateY(7%)   rotate(2deg);  opacity: 1; }
    100% { transform: translateY(0)    rotate(0deg);  opacity: 1; }
  }
  /* TWO-POINT — a decisive double beat, because the try was chosen not kicked. */
  @keyframes nflBannerTwoPt {
    0%   { transform: translateY(-130%); opacity: 0; }
    38%  { transform: translateY(5%);    opacity: 1; }
    54%  { transform: translateY(-8%); }
    72%  { transform: translateY(3%); }
    100% { transform: translateY(0); }
  }
  /* EXTRA POINT — understated on purpose. It is one point and it should read
     as routine; giving it the touchdown's motion would flatten the vocabulary. */
  @keyframes nflBannerPat {
    0%   { transform: translateY(-100%) scale(.97); opacity: 0; }
    100% { transform: translateY(0)     scale(1);   opacity: 1; }
  }
  /* SAFETY — a jolt. The defense took these two points, and the motion is the
     only cue that says so before the text does. */
  @keyframes nflBannerSafety {
    0%   { transform: translateY(-120%); opacity: 0; }
    42%  { transform: translateY(0);     opacity: 1; }
    54%  { transform: translateX(-11px); }
    66%  { transform: translateX(9px); }
    78%  { transform: translateX(-6px); }
    89%  { transform: translateX(4px); }
    100% { transform: translateX(0); }
  }
  @keyframes nflBannerOut { to { transform: translateY(-130%); opacity: 0; } }

  .nfl-b-td     { animation: nflBannerTd     620ms cubic-bezier(.2,.9,.3,1.4) both; }
  .nfl-b-fg     { animation: nflBannerFg     560ms cubic-bezier(.2,.9,.3,1.2) both; }
  .nfl-b-2pt    { animation: nflBannerTwoPt  680ms cubic-bezier(.3,.8,.3,1.2) both; }
  .nfl-b-pat    { animation: nflBannerPat    360ms cubic-bezier(.2,.8,.4,1)   both; }
  .nfl-b-saf    { animation: nflBannerSafety 760ms cubic-bezier(.3,.7,.3,1)   both; }
  .nfl-b-final  { animation: nflBannerPat    420ms ease-out both; }
  .nfl-b-out    { animation: nflBannerOut    340ms ease-in both; }

  /* ── SCORE DIGITS — the same five, echoed on the number itself ──────────
     The second animation Mr. McRitchie asked for: the banner announces, and
     the score on the board reacts in the same idiom. */
  @keyframes nflScoreTd    { 0%{transform:scale(1)} 32%{transform:scale(1.8)} 62%{transform:scale(.93)} 100%{transform:scale(1)} }
  @keyframes nflScoreFg    { 0%{transform:translateY(0) scale(1)} 40%{transform:translateY(-10px) scale(1.45)} 100%{transform:translateY(0) scale(1)} }
  @keyframes nflScoreTwoPt { 0%,100%{transform:scale(1)} 22%{transform:scale(1.45)} 48%{transform:scale(1.02)} 72%{transform:scale(1.38)} }
  @keyframes nflScorePat   { 0%{transform:scale(1)} 45%{transform:scale(1.2)} 100%{transform:scale(1)} }
  @keyframes nflScoreSaf   { 0%,100%{transform:translateX(0) scale(1)} 18%{transform:translateX(-6px) scale(1.35)} 38%{transform:translateX(6px)} 58%{transform:translateX(-4px)} 78%{transform:translateX(3px)} }

  /* The 560ms delay is the whole trick: the sweep is 720ms wide, so the number
     detonates just as the strip passes under it rather than before it starts. */
  .nfl-s-td   { animation: nflScoreTd 700ms cubic-bezier(.2,.9,.3,1.4) 560ms both; display:inline-block; }
  .nfl-s-fg   { animation: nflScoreFg    640ms cubic-bezier(.2,.9,.3,1.3) both; display:inline-block; }
  .nfl-s-2pt  { animation: nflScoreTwoPt 760ms cubic-bezier(.3,.8,.3,1.2) both; display:inline-block; }
  .nfl-s-pat  { animation: nflScorePat   420ms ease-out both;               display:inline-block; }
  .nfl-s-saf  { animation: nflScoreSaf   680ms ease-out both;               display:inline-block; }

  /* ── THE TOUCHDOWN SWEEP ────────────────────────────────────────────────
     A strip of the team's ink colour crossing the row left to right, timed so
     it arrives under the score exactly as the number pops. Touchdown only —
     it is the biggest play on the board and it should be the only one that
     takes the whole width of the card to say so. */
  @keyframes nflSweep {
    0%   { transform: translateX(-130%); opacity: 0; }
    18%  { opacity: .55; }
    82%  { opacity: .55; }
    100% { transform: translateX(330%);  opacity: 0; }
  }
  .nfl-sweep-run { animation: nflSweep 720ms cubic-bezier(.35,.05,.25,1) both; }

  /* ── THE SCORING ROW ────────────────────────────────────────────────────
     Answers "which team scored?" in the TEAM'S colour rather than leaving the
     number to tick over in grey. --nfl-team is set inline per row by the tile. */
  /* Lower than it was: the wash is now the INK colour laid over the team's own
     field, and a light overlay at .30 washed the name straight out. */
  @keyframes nflRowWash { 0%{opacity:0} 22%{opacity:.18} 55%{opacity:.08} 100%{opacity:0} }
  @keyframes nflRailPulse {
    0%,100% { transform: scaleY(1);   box-shadow: 0 0 0 0 transparent; }
    35%     { transform: scaleY(1.45); box-shadow: 0 0 14px 2px var(--nfl-team); }
  }
  .nfl-wash-run  { animation: nflRowWash 1500ms ease-out both; }
  .nfl-rail-run  { animation: nflRailPulse 1100ms ease-out both; }

  /* THE HOT SCORE — the score stays bold and in the team's colour after it
     changes, then fades back. This is what makes a board you glance at
     answer "what just moved?" without having watched it move. The colour is
     applied inline by the script (it is per-team); the weight and scale live
     here. The fade home is a transition, not a keyframe, so cooling off is
     smooth from wherever it is. */
  /* Resting: the team's ink over the team's field. Same specificity as the hot
     rule below, which is ordered after it and therefore wins while it applies. */
  [data-role="score"] { color: var(--nfl-team-fg); }

  /* Hot: the row is ALREADY the team's colours, so a colour swap alone would
     not read. The signal is brightness plus a glow in the team's ink — white
     over a team field, lit from behind. */
  .nfl-score-hot {
    font-weight: 900;
    transform: scale(1.08);
    color: #ffffff;
    text-shadow: 0 0 18px var(--nfl-team-ink), 0 0 6px var(--nfl-team-ink);
  }
  /* Fading home is a transition, not a keyframe, so it is smooth from wherever
     the value happens to be. text-shadow is listed explicitly because Tailwind's
     transition-colors on the span covers colour but not the glow. */
  [data-role="score"] { transition: color .7s ease, text-shadow .7s ease, transform .7s ease; }

  /* A light sweep across the banner, once, just after it lands. */
  @keyframes nflShimmer { 0% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }
  #nfl-score-shimmer::after {
    content: ""; position: absolute; inset: 0; width: 45%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.28), transparent);
  }
  .nfl-shimmer-run::after { animation: nflShimmer 900ms ease-out 260ms both; }

  /* Respect the system setting. The board still updates and the score still
     goes bold in the team's colour — it just stops moving, which is the
     distinction the preference actually asks for. */
  @media (prefers-reduced-motion: reduce) {
    .nfl-b-td, .nfl-b-fg, .nfl-b-2pt, .nfl-b-pat, .nfl-b-saf, .nfl-b-final, .nfl-b-out,
    .nfl-s-td, .nfl-s-fg, .nfl-s-2pt, .nfl-s-pat, .nfl-s-saf,
    .nfl-wash-run, .nfl-rail-run, .nfl-sweep-run, .nfl-shimmer-run::after {
      animation: none !important;
    }
    .nfl-score-hot { transform: none; }
    /* The LIVE dot pulses via a Tailwind utility, so it sat outside every rule
       above and kept animating for a viewer who asked for stillness. */
    .animate-pulse { animation: none !important; }
  }
</style>

<script>
  (function () {
    var feed = document.getElementById('nfl_live_event_feed');
    if (!feed || feed.dataset.observed) return;  // guard double-attach across Turbo visits
    feed.dataset.observed = '1';

    var overlay = document.getElementById('nfl-score-overlay');
    var banner  = document.getElementById('nfl-score-banner');
    var shimmer = document.getElementById('nfl-score-shimmer');
    var board   = document.getElementById('nfl_live_scoreboard');
    var hideTimer = null;

    // The two hold windows. Both are overridable from the page so a test can
    // prove the RESET rule in seconds instead of waiting out a real 45s ring —
    // without that seam the only honest test of "a second score restarts the
    // timer" is a 90-second one, and the rule would go untested instead.
    // Nothing in production sets these globals.
    var HOT_MS  = window.NFL_HOT_MS  || 50000;   // score stays bold and lit
    var GLOW_MS = window.NFL_GLOW_MS || 45000;   // card wears its team ring

    // scoring_type -> the pair of animations it owns. Unknown types fall back to
    // the touchdown pair rather than animating nothing: a scoring play we do not
    // recognise is still a scoring play, and silence would read as a bug.
    var ANIM = {
      // `sweep` is touchdown-only: the strip of colour that crosses the row and
      // hands off to the score pop. Every type animates; only this one takes the
      // full width of the card to do it.
      touchdown:  { banner: 'nfl-b-td',  score: 'nfl-s-td',  sweep: true },
      field_goal: { banner: 'nfl-b-fg',  score: 'nfl-s-fg'  },
      two_point:  { banner: 'nfl-b-2pt', score: 'nfl-s-2pt' },
      pat:        { banner: 'nfl-b-pat', score: 'nfl-s-pat' },
      safety:     { banner: 'nfl-b-saf', score: 'nfl-s-saf' }
    };
    var FALLBACK = ANIM.touchdown;
    var BANNER_CLASSES = ['nfl-b-td','nfl-b-fg','nfl-b-2pt','nfl-b-pat','nfl-b-saf','nfl-b-final','nfl-b-out'];
    var SCORE_CLASSES  = ['nfl-s-td','nfl-s-fg','nfl-s-2pt','nfl-s-pat','nfl-s-saf'];

    // Re-running an animation on an element that already carries its class is a
    // no-op — the class never changed. Strip, force a reflow, re-add.
    function restart(el, classes, cls) {
      if (!el) return;
      classes.forEach(function (c) { el.classList.remove(c); });
      void el.offsetWidth;
      if (cls) el.classList.add(cls);
    }

    function row(gameSlug, teamSlug) {
      if (!gameSlug || !teamSlug) return null;
      return document.querySelector(
        '[data-game-slug="' + gameSlug + '"] [data-team-slug="' + teamSlug + '"]'
      );
    }

    // WHICH SCORES ARE STILL HOT. Held in JS and re-applied after every board
    // replacement, because a broadcast swaps the whole scoreboard partial and
    // takes any class the script added with it — so state that lives only in the
    // DOM survives exactly until the next goal anywhere in the league.
    // TWO registries, each holding its own timeout id.
    //
    // The timer has to be STORED to be resettable. Firing a fresh setTimeout on
    // every score without clearing the last one looks correct and is not: the
    // FIRST timeout still comes due on the original schedule and cools a score
    // that was re-lit seconds ago. Two touchdowns 40s apart would leave the
    // second one lit for 5 seconds instead of the full window.
    var hot  = {};   // "gameSlug|teamSlug" -> timeout id, the bold score
    var glow = {};   // "gameSlug"          -> timeout id, the card ring
    function key(g, t) { return g + '|' + t; }

    // The class alone is enough: both brand colours are custom properties on the
    // ROW, so the score inherits the right pair wherever it is re-rendered. That
    // is also why nothing here writes an inline colour — an inline value would
    // have to be re-derived every time the board is replaced.
    function applyHot() {
      Object.keys(hot).forEach(function (k) {
        var parts = k.split('|');
        var el = row(parts[0], parts[1]);
        var score = el && el.querySelector('[data-role="score"]');
        if (score) score.classList.add('nfl-score-hot');
      });
    }

    function cool(gameSlug, teamSlug) {
      var k = key(gameSlug, teamSlug);
      if (!(k in hot)) return;
      clearTimeout(hot[k]);
      delete hot[k];
      var el = row(gameSlug, teamSlug);
      var score = el && el.querySelector('[data-role="score"]');
      if (!score) return;
      score.classList.remove('nfl-score-hot');   // the transition above fades it home
    }

    function card(gameSlug) {
      return gameSlug ? document.querySelector('[data-game-slug="' + gameSlug + '"]') : null;
    }

    // Re-applied after every board replacement, same as the hot score: a
    // broadcast swaps the scoreboard partial wholesale, so a ring set on the old
    // node would go dark the moment ANY game scored.
    var glowColors = {};
    function applyGlow() {
      Object.keys(glowColors).forEach(function (g) {
        var el = card(g);
        if (!el) return;
        el.style.setProperty('--studio-team-glow-color', glowColors[g].a);
        el.style.setProperty('--studio-team-glow-color-b', glowColors[g].b);
        el.style.setProperty('--studio-team-glow-opacity', '1');
      });
    }

    function unglow(gameSlug) {
      if (!(gameSlug in glow)) return;
      clearTimeout(glow[gameSlug]);
      delete glow[gameSlug];
      delete glowColors[gameSlug];
      var el = card(gameSlug);
      // Back to 0 rather than removing the property: the class's own 0.4s
      // opacity transition then fades the ring out instead of cutting it.
      if (el) el.style.setProperty('--studio-team-glow-opacity', '0');
    }

    function lightCard(gameSlug, a, b) {
      if (!card(gameSlug)) return;
      glowColors[gameSlug] = { a: a || 'var(--color-cta)', b: b || a || 'var(--color-cta)' };
      applyGlow();
      if (glow[gameSlug]) clearTimeout(glow[gameSlug]);   // RESET, never stack
      glow[gameSlug] = setTimeout(function () { unglow(gameSlug); }, GLOW_MS);
    }

    function animateRow(d) {
      var el = row(d.gameSlug, d.teamSlug);
      if (!el) return;
      var anim = ANIM[d.scoringType] || FALLBACK;

      restart(el.querySelector('.nfl-row-wash'), ['nfl-wash-run'], 'nfl-wash-run');
      restart(el.querySelector('.nfl-rail'),     ['nfl-rail-run'], 'nfl-rail-run');
      restart(el.querySelector('.nfl-sweep'), ['nfl-sweep-run'], anim.sweep ? 'nfl-sweep-run' : null);
      restart(el.querySelector('[data-role="score"]'), SCORE_CLASSES, anim.score);

      var k = key(d.gameSlug, d.teamSlug);
      if (hot[k]) clearTimeout(hot[k]);                   // RESET, never stack
      hot[k] = setTimeout(function () { cool(d.gameSlug, d.teamSlug); }, HOT_MS);
      applyHot();

      lightCard(d.gameSlug, d.glowA, d.glowB);
    }

    function showBanner(d) {
      var isFinal = d.event === 'final';
      var bg = isFinal ? '#1e293b' : (d.teamBg || '#1e293b');
      var fg = isFinal ? '#e2e8f0' : (d.teamFg || '#e2e8f0');

      banner.style.background = bg;
      banner.style.color = fg;
      document.getElementById('nfl-score-emoji').textContent  = isFinal ? '🏁' : (d.teamEmoji || '🏈');
      document.getElementById('nfl-score-label').textContent  = isFinal ? 'Final' : (d.label || 'Score');
      document.getElementById('nfl-score-team').textContent   = isFinal ? '' : (d.teamName || d.team || '');
      document.getElementById('nfl-score-points').textContent = (isFinal || !d.points) ? '' : ('+' + d.points);
      document.getElementById('nfl-score-line').textContent =
        (d.awayTeam || '') + ' ' + (d.awayScore || '0') + '  –  ' + (d.homeScore || '0') + ' ' + (d.homeTeam || '');

      overlay.classList.remove('hidden');
      var cls = isFinal ? 'nfl-b-final' : ((ANIM[d.scoringType] || FALLBACK).banner);
      restart(banner, BANNER_CLASSES, cls);
      restart(shimmer, ['nfl-shimmer-run'], 'nfl-shimmer-run');

      if (hideTimer) clearTimeout(hideTimer);
      hideTimer = setTimeout(function () {
        restart(banner, BANNER_CLASSES, 'nfl-b-out');
        setTimeout(function () { overlay.classList.add('hidden'); }, 340);
      }, isFinal ? 3200 : 4000);
    }

    function announce(d) {
      var region = document.getElementById('nfl_live_announcer');
      if (!region) return;
      var line = d.event === 'final'
        ? 'Final. ' + (d.awayTeam || '') + ' ' + (d.awayScore || '0') + ', ' + (d.homeTeam || '') + ' ' + (d.homeScore || '0') + '.'
        : (d.label || 'Score') + ', ' + (d.teamName || d.team || '') + '. ' +
          (d.awayTeam || '') + ' ' + (d.awayScore || '0') + ', ' + (d.homeTeam || '') + ' ' + (d.homeScore || '0') + '.';
      region.textContent = line;
    }

    function fire(node) {
      if (node.nodeType !== 1) return;
      var d = node.dataset;
      showBanner(d);
      announce(d);
      // Next frame, not this one. The server sends the board update ahead of the
      // event (see Nfl::LiveBroadcast.scoring_event), but Turbo applies streams
      // as they arrive and a SECOND game scoring at the same instant would
      // replace the board out from under an animation started synchronously
      // here. Waiting a frame means the row we decorate is the row that stays.
      if (d.event !== 'final') {
        var payload = {
          gameSlug: d.gameSlug, teamSlug: d.teamSlug, scoringType: d.scoringType,
          glowA: d.glowA, glowB: d.glowB
        };
        requestAnimationFrame(function () { animateRow(payload); });
      }
      node.remove();
    }

    // Drain anything already present (a broadcast can land before attach).
    Array.prototype.slice.call(feed.children).forEach(fire);
    new MutationObserver(function (muts) {
      muts.forEach(function (m) { Array.prototype.slice.call(m.addedNodes).forEach(fire); });
    }).observe(feed, { childList: true });

    // A broadcast replaces the board wholesale; re-paint the still-hot scores
    // onto the new nodes so a score that just changed does not go grey again
    // because a DIFFERENT game scored.
    if (board) {
      new MutationObserver(function () { applyHot(); applyGlow(); })
        .observe(board, { childList: true, subtree: true });
    }
  })();
</script>
