<%# WHERE THE GAME IS UP TO — the resting pane of the hero tile's status half.
    Locals: game (Game).

    ITS OWN PARTIAL because it is the one part of the tile that changes every
    snap. A score repaints the whole focus panel; a play does not, and must not
    — the panel hosts the scoring animations, and replacing it every twenty
    seconds would wipe one mid-flight. So Contest::LiveBroadcast.plays_changed
    updates just this (the tile gives its wrapper the id game_<slug>_status)
    and the clock, the down and the ball keep moving between scores. %>
<%# WHERE IT IS PLAYED, first, in every state: "Lumen Field, Seattle, WA",
    "Tottenham Hotspur Stadium, London". It is the one line here that never
    changes, which is why it is the quietest. %>
<% if game.venue.present? %>
  <span class="text-[11px] font-medium text-white/60 truncate max-w-full leading-none"
        data-test="live-focus-venue"><%= game.venue %></span>
<% end %>
<% if game.live? %>
  <%# THE CLOCK LINE. `status_detail` says the same thing in
      ESPN's words ("11:49 - 3rd"); this says it in ours, and
      only one of them gets the line. %>
  <div class="flex items-center justify-center gap-2">
    <% if game.period_clock_label %>
      <span class="text-lg font-extrabold uppercase tracking-wide text-white tabular-nums leading-none"
            data-test="live-focus-clock"><%= game.period_clock_label %></span>
    <% end %>
    <span class="inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-red-400">
      <span class="h-2 w-2 rounded-full bg-red-500 animate-pulse"></span> Live
    </span>
  </div>

  <%# THE BIG LINE — the down, in the slot the kickoff time used
      to hold. Between possessions and at the half ESPN sends no
      situation at all, so the detail stands in — but only when it
      is not the clock we just printed above ("11:49 - 3rd" is;
      "Halftime" is not). Repeating the clock in a bigger font
      would be the loudest line on the card saying nothing new. %>
  <% detail = game.status_detail.presence %>
  <% detail = nil if detail && game.clock.present? && detail.include?(game.clock) %>
  <%# THE DOWN MOVED TO THE MIDDLE THIRD (Alex, 2026-10-04), over the field it
      describes — see live/_game_field. What is left for this line is the
      detail that stands in when there is no down at all: "Halftime", "End of
      3rd". The clock above took the size the down used to have. %>
  <% if detail && game.down_distance_label.blank? %>
    <span class="text-lg font-bold text-white/90 leading-none truncate max-w-full"
          data-test="live-focus-detail"><%= detail %></span>
  <% end %>

<% else %>
  <% if game.kickoff_at %>
    <time datetime="<%= game.kickoff_at.utc.iso8601 %>" data-role="kickoff-date"
          class="text-xs font-bold uppercase tracking-wider text-white/60"><%= game.kickoff_at.utc.strftime("%b %-d") %></time>
    <time datetime="<%= game.kickoff_at.utc.iso8601 %>" data-role="kickoff"
          class="text-lg font-bold text-white/90 leading-none"><%= game.kickoff_at.utc.strftime("%a %-I:%M %p") %></time>
  <% end %>

  <%# FINAL earns its line; a scheduled game's does not. The
      detail rides alongside only when it says MORE than the badge
      — "Final/OT" survives, a second "Final" does not, and a
      scheduled game's restatement of the kickoff never appears. %>
  <% if game.completed? %>
    <% detail = game.status_detail.presence %>
    <% detail = nil if detail && detail.casecmp("final").zero? %>
    <div class="flex items-center justify-center gap-2">
      <span class="text-xs font-bold uppercase tracking-wider text-white/70">Final</span>
      <% if detail %>
        <span class="text-sm font-mono text-white/80 truncate"><%= detail %></span>
      <% end %>
    </div>
  <% end %>
<% end %>
