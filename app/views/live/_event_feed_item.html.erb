<%# A data-only node appended to the hidden event feed. The page's
    MutationObserver reads these data-* attrs, plays the scoring animation, then
    removes the node. NO <script> here — Turbo does not execute scripts inside
    broadcast <template>s, which is why every value it needs is an attribute.
    Locals: event ("score"|"final"), goal (Goal|nil), team (Team|nil), game. %>
<div data-event="<%= event %>"
     data-game-slug="<%= game.slug %>"
     data-team-slug="<%= team&.slug %>"
     data-team="<%= team ? (team.short_name.presence || team.name) : "" %>"
     data-team-name="<%= team&.name %>"
     data-team-emoji="<%= team&.emoji %>"
     data-team-bg="<%= team&.card_background %>"
     data-team-fg="<%= team&.card_mascot %>"
     <%# The two wedge colours for the card's glow ring. `accent` is the mascot
         colour; `glow` is the team's extra brand colour where it curates one
         (the Ravens' red, the Buccaneers' orange) and falls back to the light,
         so a two-colour team lights two wedges and a one-colour team reads as
         a single hue rather than a mismatch. %>
     data-glow-a="<%= team ? team_card_palette(team)[:accent] : "" %>"
     data-glow-b="<%= team ? team_card_palette(team)[:glow] : "" %>"
     data-label="<%= goal&.scoring_label %>"
     <%# The RAW type, not the label — the page keys its per-type animations off
         this, and "2-Point Conversion" is a display string that will change. %>
     data-scoring-type="<%= goal&.scoring_type %>"
     data-points="<%= goal&.points %>"
     <%# THE NAME BLOCK'S OWN DATA. The banner names the team the way the team
         card does — the city quietly above, the action below in the team's own
         accent — so it needs both colours by name. The contest feed has carried
         these since the focus panel adopted the convention; the league board
         raises the SAME banner, and without them its name block printed in the
         banner's flat foreground while the contest page's wore the team's.
         `accent` duplicates `glow-a` by value today and not by meaning: one is
         the ring's first wedge, the other is the ink on the action line. %>
     data-team-location="<%= team&.location %>"
     data-accent="<%= team ? team_card_palette(team)[:accent] : "" %>"
     data-location-color="<%= team ? team_card_palette(team)[:location] : "" %>"
     <%# THE HALO THE ACCENT NEEDS TO SURVIVE ITS OWN FIELD. The banner's
         background is the team's own card colour and its action line is now the
         team's own mascot colour, which is the pairing the tile solves with
         `mascot_shadow` — Buffalo is red-on-blue at 1.88:1 unaided. Computed
         server-side because the direction of the halo depends on the accent's
         luminance (a near-black mascot takes a LIGHT halo), which is a decision
         TeamColorsHelper already makes. %>
     data-accent-shadow="<%= team ? team_card_palette(team)[:mascot_shadow] : "" %>"
     <%# THE SCORE LINE'S OWN DATA. The banner's bottom bar is a 50/50 blend of
         the two teams' dark colours with each abbreviation in that team's light,
         and it carries the game's SITUATION beside the tally — down and distance
         on the left, quarter and clock on the right. Both are blank on a game
         that is not in progress, which is how the bar collapses to just the
         score for a final.
         Colours come from the server's palette rather than being guessed in JS,
         the same way `accent` and `location-color` already do. %>
     <% away_line = game.away_team ? team_scoreline_palette(game.away_team) : {} %>
     <% home_line = game.home_team ? team_scoreline_palette(game.home_team) : {} %>
     data-away-dark="<%= away_line[:dark] %>"
     data-away-light="<%= away_line[:light] %>"
     data-home-dark="<%= home_line[:dark] %>"
     data-home-light="<%= home_line[:light] %>"
     data-down-distance="<%= game.down_distance_label %>"
     data-field-spot="<%= game.field_spot_label %>"
     data-clock="<%= game.period_clock_label %>"
     data-home-team="<%= game.home_team&.short_name || game.home_team_slug %>"
     data-away-team="<%= game.away_team&.short_name || game.away_team_slug %>"
     data-home-score="<%= game.home_score.to_i %>"
     data-away-score="<%= game.away_score.to_i %>"></div>
