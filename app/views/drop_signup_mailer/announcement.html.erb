<p style="margin:0 0 16px;font-size:22px;line-height:1.3;font-weight:700;color:#1f2a1c;"><%= @label %> is live.</p>

<p style="margin:0 0 16px;font-size:16px;line-height:1.6;color:#3f4a3c;">
  The slate you asked about just opened. Pick your teams: every point they score counts, times their multiplier, and underdogs score big.
</p>

<% if @variant == :new_player %>
  <p style="margin:0 0 28px;font-size:16px;line-height:1.6;color:#3f4a3c;">
    The button below creates your account with <strong style="color:#1f2a1c;"><%= @signup.email %></strong> and takes you to the slate.
    It works once and expires in <%= Studio.magic_link_ttl.in_minutes.round %> minutes; after that it takes you to sign-in with your email filled in.
  </p>
<% else %>
  <p style="margin:0 0 28px;font-size:16px;line-height:1.6;color:#3f4a3c;">
    Make your picks before the first game locks.
  </p>
<% end %>

<%= render "drop_signup_mailer/cta", label: @primary_label, url: @primary_url %>

<%= render "drop_signup_mailer/footer" %>
