<section class="space-y-6">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
    <div>
      <h2 class="text-2xl font-bold text-heading">
        <%= @team ? "#{@team.name} Roster" : (@position ? "#{@position}s — All Teams" : "NFL Players") %>
      </h2>
      <% if @team || @position %>
        <%= link_to "← All teams", nfl_players_path, class: "text-sm text-secondary hover:text-primary" %>
      <% end %>
    </div>
  </div>

  <%# Position filter — a real link, not a client-side toggle, because the
      league-wide set is ~2,900 players and the filtering has to happen in SQL. %>
  <% if @positions.any? %>
    <div class="flex flex-wrap gap-2">
      <%= link_to "All",
                  nfl_players_path(team: @team&.slug),
                  class: "btn btn-sm #{@position ? 'btn-outline' : 'btn-primary'}" %>
      <% @positions.each do |pos| %>
        <%= link_to pos,
                    nfl_players_path(team: @team&.slug, position: pos),
                    class: "btn btn-sm #{@position == pos ? 'btn-primary' : 'btn-outline'}" %>
      <% end %>
    </div>
  <% end %>

  <% if @athletes %>
    <div x-data="cardListFilter({ selector: '[data-athlete-card]' })">
      <div class="flex items-center gap-3 mb-4">
        <input type="text"
               x-model.debounce.300ms="search"
               placeholder="Search players..."
               class="input-field text-sm !py-2 !px-3 w-full sm:w-64">
        <span class="text-sm text-muted whitespace-nowrap" x-text="visibleCount + ' players'"></span>
      </div>

      <% if @athletes.empty? %>
        <%= render "components/empty_state", message: "No players seeded yet. Run: bin/rails nfl:players_seed" %>
      <% else %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          <%= render partial: "nfl_players/athlete_card", collection: @athletes, as: :athlete %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# No team or position chosen — the 32-team picker. %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      <% @teams.each do |team| %>
        <%= link_to nfl_players_path(team: team.slug),
                    class: "card p-4 flex items-center gap-3 hover:border-primary/40 transition-colors" do %>
          <% if team.card_background.present? %>
            <span class="inline-block w-3 h-3 rounded-full shrink-0" style="background-color: <%= team.card_background %>"></span>
          <% end %>
          <span class="text-heading font-semibold truncate"><%= team.emoji %> <%= team.short_name || team.name %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
