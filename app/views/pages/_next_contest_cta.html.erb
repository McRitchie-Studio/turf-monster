<%# locals: (pick:, test_id:)

    /turf-monster-v2's one call to action. NextContest decides it server-side:
      a contest is open to enter  -> a link straight to it, by its real name
      none is                     -> "Get notified for Weeks 7-9", which opens
                                     the drop-notify modal (countdown + form)
    After the drop with nothing open yet, the same modal says the slate is live.
    The modal button is an anchor to #notify, so with JS off it still lands on
    the page's own notify section. %>
<% if pick.link? %>
  <%= link_to "Play #{pick.contest.name}", contest_path(pick.contest),
        class: "btn btn-primary btn-lg shadow-lg shadow-primary/30 text-base sm:text-lg whitespace-nowrap", data: { test: test_id } %>
<% else %>
  <a href="#notify" class="btn btn-primary btn-lg shadow-lg shadow-primary/30 text-base sm:text-lg whitespace-nowrap" data-test="<%= test_id %>"
     @click.prevent="$store.modals.open('drop-notify', { title: 'Get notified when <%= NextSlateDrop::LABEL %> drops' })"><%= NextSlateDrop.dropped? ? "See the #{NextSlateDrop::LABEL} slate" : "Get notified for #{NextSlateDrop::LABEL}" %></a>
<% end %>
