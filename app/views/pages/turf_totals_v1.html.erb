<% content_for :title, "Turf Totals v1 — How It Works" %>
<% content_for :head do %>
  <meta property="og:title" content="Turf Totals v1 — How It Works">
  <meta property="og:description" content="Pick 6 team offensive matchups. Multiplier scoring. Win cash.">
  <meta property="og:type" content="article">
  <meta property="og:image" content="<%= request.base_url %>/logo.png">
<% end %>

<%# data-test hook: the tests scope their copy assertions to THIS subtree, so a
    page-wide assert_select cannot pass on navbar/footer text. Mirrors the NFL
    rulebook's turf-monster-rules hook. %>
<div class="max-w-3xl mx-auto py-8 px-2" data-test="turf-totals-rules">

  <!-- ========== HERO ========== -->
  <section class="text-center mb-16">
    <div class="mb-4 flex items-center justify-center gap-3">
      <span class="px-3 py-1 bg-primary-900/30 text-primary text-xs font-bold uppercase tracking-widest rounded-full border border-primary-700">World Cup 2026</span>
    </div>
    <h1 class="text-4xl md:text-6xl font-extrabold text-heading mb-2">
      Turf <span class="text-primary">Totals</span>
      <span class="ml-2 px-2 py-0.5 bg-violet/20 text-violet text-sm md:text-base font-mono rounded-md align-middle border border-violet/30">v1</span>
    </h1>
    <p class="text-2xl md:text-3xl font-bold text-body mt-4 mb-3">Pick. Multiply. Get Paid.</p>
    <p class="text-secondary text-lg max-w-xl mx-auto mb-8">
      Pick 6 team offensive matchups from the World Cup. Each team has a Turf Score based on how good their offense is — weaker teams = higher Turf Score = bigger payoff when they score.
    </p>
    <%= link_to "Start Playing", root_path, class: "btn btn-primary btn-lg shadow-lg shadow-primary/20 text-lg" %>
  </section>

  <hr class="border-subtle my-10">

  <!-- ========== 01 — THE BASICS ========== -->
  <section class="mb-12 md:mb-16">
    <p class="text-primary font-mono text-sm mb-2">01</p>
    <h2 class="text-2xl md:text-3xl font-bold text-heading mb-4">The Basics</h2>
    <p class="text-secondary text-base md:text-lg leading-relaxed mb-8">
      Each matchup card represents one team's offensive performance in a specific game. Pick a team, and you're betting on them to score goals. The more goals they score, the more points you earn — multiplied by their ranking.
    </p>

    <!-- Mock matchup card -->
    <div class="max-w-xs mx-auto">
      <div class="bg-surface-alt rounded-2xl border border-subtle p-6 text-center relative">
        <span class="absolute top-3 right-3 text-[10px] font-mono text-muted">#42</span>
        <div class="flex items-center justify-center mb-2">
          <span class="text-3xl">&#127482;&#127480;</span>
        </div>
        <p class="font-bold text-heading text-lg mb-1">United States</p>
        <p class="text-xs text-muted mb-2">vs Brazil</p>
        <p class="font-mono text-3xl text-violet mb-1">2.9x</p>
        <p class="text-xs text-muted">Turf Score</p>
      </div>
      <p class="text-center text-muted text-xs mt-3 italic">Example matchup card — not a live pick</p>
    </div>
  </section>

  <hr class="border-subtle my-10">

  <!-- ========== 02 — YOUR ENTRY ========== -->
  <section class="mb-12 md:mb-16">
    <p class="text-primary font-mono text-sm mb-2">02</p>
    <h2 class="text-2xl md:text-3xl font-bold text-heading mb-4">Your Entry</h2>
    <p class="text-secondary text-base md:text-lg leading-relaxed mb-8">
      Each entry is <span class="text-heading font-semibold">6 team picks</span>. Select 6 offensive matchups from the card grid, then hold-to-confirm. You can submit up to 3 entries per contest with different combos.
    </p>

    <!-- Mock pick slots -->
    <div class="bg-surface-alt rounded-2xl border border-subtle p-6">
      <div class="grid grid-cols-3 gap-2">
        <div class="card p-3 text-center border border-mint/30">
          <div class="text-lg mb-1">&#127463;&#127479;</div>
          <p class="text-xs text-secondary mb-0.5">BRA</p>
          <p class="text-[10px] text-muted">vs SER</p>
          <p class="font-mono text-xs text-violet mt-1">1.4x</p>
        </div>
        <div class="card p-3 text-center border border-mint/30">
          <div class="text-lg mb-1">&#127471;&#127477;</div>
          <p class="text-xs text-secondary mb-0.5">JPN</p>
          <p class="text-[10px] text-muted">vs QAT</p>
          <p class="font-mono text-xs text-violet mt-1">2.4x</p>
        </div>
        <div class="card p-3 text-center border border-mint/30">
          <div class="text-lg mb-1">&#127482;&#127480;</div>
          <p class="text-xs text-secondary mb-0.5">USA</p>
          <p class="text-[10px] text-muted">vs PAR</p>
          <p class="font-mono text-xs text-violet mt-1">2.9x</p>
        </div>
        <div class="card p-3 text-center border border-mint/30">
          <div class="text-lg mb-1">&#127469;&#127481;</div>
          <p class="text-xs text-secondary mb-0.5">HAI</p>
          <p class="text-[10px] text-muted">vs SCO</p>
          <p class="font-mono text-xs text-violet mt-1">3.0x</p>
        </div>
        <div class="card p-3 text-center border border-mint/30">
          <div class="text-lg mb-1">&#127475;&#127487;</div>
          <p class="text-xs text-secondary mb-0.5">NZL</p>
          <p class="text-[10px] text-muted">vs IRN</p>
          <p class="font-mono text-xs text-violet mt-1">2.9x</p>
        </div>
        <div class="card p-3 text-center border border-mint/30">
          <div class="text-lg mb-1">&#127464;&#127483;</div>
          <p class="text-xs text-secondary mb-0.5">CPV</p>
          <p class="text-[10px] text-muted">vs ESP</p>
          <p class="font-mono text-xs text-violet mt-1">3.0x</p>
        </div>
      </div>
      <div class="mt-4 text-center">
        <p class="text-muted text-sm">Entry fee: <span class="font-mono text-heading">$19.00</span></p>
      </div>
    </div>
  </section>

  <hr class="border-subtle my-10">

  <!-- ========== 03 — TURF SCORE SCORING ========== -->
  <section class="mb-12 md:mb-16">
    <p class="text-primary font-mono text-sm mb-2">03</p>
    <h2 class="text-2xl md:text-3xl font-bold text-heading mb-4">Turf Score Scoring</h2>
    <p class="text-secondary text-base md:text-lg leading-relaxed mb-8">
      Every team is ranked 1–48 by offensive strength. The Turf Score runs from <span class="text-violet font-mono font-bold">x1.0</span> (rank 1, the best offense) up to <span class="text-violet font-mono font-bold">x3.0</span> (rank 48) on a logarithmic curve — <span class="text-violet font-mono font-bold">1 + 2&middot;ln(rank)/ln(48)</span>. Better offenses get lower Turf Scores, underdogs get higher ones, but the curve is compressed so mid-table teams still pay well. Your points = <span class="text-heading font-semibold">goals scored &times; Turf Score</span>.
    </p>

    <!-- Three example cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-6">
      <div class="rounded-xl p-5 text-center bg-surface-alt border border-subtle">
        <p class="text-sm text-muted mb-1">Rank #1 (best offense)</p>
        <p class="text-3xl font-mono font-bold text-violet mb-1">x1.0</p>
        <p class="text-secondary text-xs">Low reward, high chance of goals</p>
      </div>
      <div class="rounded-xl p-5 text-center bg-surface-alt border border-subtle">
        <p class="text-sm text-muted mb-1">Rank #24 (mid-tier)</p>
        <p class="text-3xl font-mono font-bold text-violet mb-1">x2.6</p>
        <p class="text-secondary text-xs">Balanced risk & reward</p>
      </div>
      <div class="rounded-xl p-5 text-center bg-surface-alt border border-subtle">
        <p class="text-sm text-muted mb-1">Rank #48 (weakest offense)</p>
        <p class="text-3xl font-mono font-bold text-violet mb-1">x3.0</p>
        <p class="text-secondary text-xs">High reward if they score</p>
      </div>
    </div>
  </section>

  <hr class="border-subtle my-10">

  <!-- ========== 04 — SCORING EXAMPLE ========== -->
  <section class="mb-12 md:mb-16">
    <p class="text-primary font-mono text-sm mb-2">04</p>
    <h2 class="text-2xl md:text-3xl font-bold text-heading mb-4">Scoring Example</h2>
    <p class="text-secondary text-base md:text-lg leading-relaxed mb-8">
      Here's how an entry might play out. You pick 6 teams, their games are played, and points are calculated. Notice how an underdog's two goals (Haiti, 3.0x) outscore a favorite's three (Brazil, 1.4x).
    </p>

    <!-- Scoring example table -->
    <div class="card overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-subtle">
            <th class="px-4 py-3 text-left text-xs font-semibold text-muted uppercase tracking-wider">Team</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-muted uppercase tracking-wider">Match</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-muted uppercase tracking-wider">Turf</th>
            <th class="px-4 py-3 text-center text-xs font-semibold text-muted uppercase tracking-wider">Goals</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-muted uppercase tracking-wider">Points</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-subtle">
          <tr>
            <td class="px-4 py-3 text-body">&#127463;&#127479; Brazil</td>
            <td class="px-4 py-3 text-center text-muted">vs Serbia</td>
            <td class="px-4 py-3 text-center font-mono text-violet">1.4x</td>
            <td class="px-4 py-3 text-center text-heading font-bold">3</td>
            <td class="px-4 py-3 text-right font-mono text-primary font-bold">4.2</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-body">&#127471;&#127477; Japan</td>
            <td class="px-4 py-3 text-center text-muted">vs Qatar</td>
            <td class="px-4 py-3 text-center font-mono text-violet">2.4x</td>
            <td class="px-4 py-3 text-center text-heading font-bold">2</td>
            <td class="px-4 py-3 text-right font-mono text-primary font-bold">4.8</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-body">&#127482;&#127480; USA</td>
            <td class="px-4 py-3 text-center text-muted">vs Paraguay</td>
            <td class="px-4 py-3 text-center font-mono text-violet">2.9x</td>
            <td class="px-4 py-3 text-center text-heading font-bold">1</td>
            <td class="px-4 py-3 text-right font-mono text-primary font-bold">2.9</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-body">&#127469;&#127481; Haiti</td>
            <td class="px-4 py-3 text-center text-muted">vs Scotland</td>
            <td class="px-4 py-3 text-center font-mono text-violet">3.0x</td>
            <td class="px-4 py-3 text-center text-heading font-bold">2</td>
            <td class="px-4 py-3 text-right font-mono text-primary font-bold">6.0</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-body">&#127475;&#127487; New Zealand</td>
            <td class="px-4 py-3 text-center text-muted">vs Iran</td>
            <td class="px-4 py-3 text-center font-mono text-violet">2.9x</td>
            <td class="px-4 py-3 text-center text-heading font-bold">0</td>
            <td class="px-4 py-3 text-right font-mono text-muted font-bold">0.0</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-body">&#127464;&#127483; Cape Verde</td>
            <td class="px-4 py-3 text-center text-muted">vs Spain</td>
            <td class="px-4 py-3 text-center font-mono text-violet">3.0x</td>
            <td class="px-4 py-3 text-center text-heading font-bold">1</td>
            <td class="px-4 py-3 text-right font-mono text-primary font-bold">3.0</td>
          </tr>
        </tbody>
        <tfoot>
          <tr class="border-t-2 border-violet/30 bg-surface-alt">
            <td colspan="4" class="px-4 py-3 text-right text-heading font-semibold">Total Score</td>
            <td class="px-4 py-3 text-right font-mono text-xl text-violet font-bold">20.9</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </section>

  <hr class="border-subtle my-10">

  <!-- ========== 05 — PAYOUTS ========== -->
  <section class="mb-12 md:mb-16">
    <p class="text-primary font-mono text-sm mb-2">05</p>
    <h2 class="text-2xl md:text-3xl font-bold text-heading mb-4">Payouts</h2>
    <p class="text-secondary text-base md:text-lg leading-relaxed mb-8">
      In a standard 29-player contest, the top 5 entries win cash — $500 in total prizes. First place takes $300; 2nd through 5th each take $50. Ties split their place's prize evenly.
    </p>

    <!-- Payout table -->
    <div class="card overflow-hidden mb-6">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-subtle">
            <th class="px-4 py-3 text-left text-xs font-semibold text-muted uppercase tracking-wider">Place</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-muted uppercase tracking-wider">Payout</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-subtle">
          <tr class="border-l-4 border-l-mint">
            <td class="px-4 py-3 text-heading font-semibold">1st Place</td>
            <td class="px-4 py-3 text-right font-mono text-primary font-bold text-lg">$300.00</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-body">2nd Place</td>
            <td class="px-4 py-3 text-right font-mono text-heading">$50.00</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-body">3rd Place</td>
            <td class="px-4 py-3 text-right font-mono text-heading">$50.00</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-body">4th Place</td>
            <td class="px-4 py-3 text-right font-mono text-heading">$50.00</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-body">5th Place</td>
            <td class="px-4 py-3 text-right font-mono text-heading">$50.00</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="grid grid-cols-2 gap-4 text-center text-sm">
      <div class="bg-surface-alt rounded-lg p-3">
        <p class="text-muted mb-1">1st place</p>
        <p class="font-mono text-primary font-bold">$300.00</p>
      </div>
      <div class="bg-surface-alt rounded-lg p-3">
        <p class="text-muted mb-1">Total prizes</p>
        <p class="font-mono text-primary font-bold">$500.00</p>
      </div>
    </div>
  </section>

  <hr class="border-subtle my-10">

  <%# CORRECTED 2026-09-07. This section used to be headed "Per-Game Lock" and
      promised each selection locked at its OWN kickoff, with a worked example
      showing a 9pm pick still swappable at 3:01pm. Entry has never allowed
      that. The H7 prelaunch audit (2026-05-24) closed it deliberately as the
      staggered-kickoff information-edge attack — see the guard comment on
      Entry#assert_enterable!, which refuses EVERY edit once Contest#locks_at
      passes. The corrected rule stays at section 06, where a player who read
      the old promise will look for it. Pinned by
      test/integration/turf_totals_lock_rule_test.rb, which measures the guard
      against a staggered slate rather than grepping for these sentences.

      CORRECTED AGAIN 2026-09-08, and the two edits are easy to confuse. The
      first fixed the rule AFTER the lock. This one fixes the sentence before
      it, which promised a swap "as often as you like" right up to the lock.
      That is false whenever a contest carries an explicit starts_at trailing a
      kickoff on its own slate: the contest is still open and unlocked, yet
      SlateMatchup#locked? has already frozen that team's pick. Nothing
      validates starts_at against the first kickoff, and every production
      contest sets it by hand.

      DO NOT RESTORE the em-dash aside that read "the first kickoff on its
      slate". It was dropped in the same edit, for the same reason: in that
      configuration the stated start time is NOT the first kickoff, so the
      aside states an equivalence the code does not hold to. Both halves are
      operator-approved copy on a real-money page.

      CORRECTED A THIRD TIME 2026-09-08. That aside came out of the PROSE, but
      the same equivalence survived twice more on this page: the worked example
      resolved its lock with "because that is the first kickoff on the slate",
      and the quick-reference row read "First kickoff on the slate". Both now
      name the stated start time, which is the attribute Contest.locks_at
      actually reads.

      THE GUARD CHANGED WITH THEM, and this is the part worth knowing before
      the next reword. The old assertion REQUIRED the phrase "first kickoff"
      inside this section, and it passed ONLY because the worked example still
      supplied it. A guard everyone read as pinning the prose was load-bearing
      on an example nobody thought was load-bearing, so rewording the example
      alone turned it red with a message that could not explain why. It now
      asks Contest.locks_at whether the lock can leave the slate first kickoff,
      and holds every lock surface on both rulebooks to that one answer. %>
  <!-- ========== 06 — WHEN PICKS LOCK ========== -->
  <section class="mb-12 md:mb-16" data-test="lock-rules">
    <p class="text-primary font-mono text-sm mb-2">06</p>
    <h2 class="text-2xl md:text-3xl font-bold text-heading mb-4">When Picks Lock</h2>
    <p class="text-secondary text-base md:text-lg leading-relaxed mb-8">
      A contest locks all at once, at its stated start time. Until then you can swap any team whose match has not kicked off. After it, every pick is final, including picks whose own match kicks off later in the contest; there are no substitutions.
    </p>

    <div class="bg-surface-alt rounded-xl border border-violet/30 p-6" data-test="lock-example">
      <p class="text-heading font-semibold mb-3">Example</p>
      <p class="text-secondary text-sm leading-relaxed">
        You picked USA (3pm kickoff) and Haiti (9pm kickoff). The contest locks at 3pm, its stated start time. At 3:01pm both picks are final — Haiti&rsquo;s later kickoff does not buy you extra time to change it. Everyone picks blind, from the same board, before a single match starts; nobody gets to watch the 3pm result and then choose their 9pm team.
      </p>
    </div>
  </section>

  <hr class="border-subtle my-10">

  <!-- ========== 07 — QUICK REFERENCE ========== -->
  <section class="mb-12 md:mb-16">
    <p class="text-primary font-mono text-sm mb-2">07</p>
    <h2 class="text-2xl md:text-3xl font-bold text-heading mb-4">Quick Reference</h2>

    <div class="card border-2 border-violet/50 p-6 shadow-lg shadow-violet/10">
      <div class="grid grid-cols-2 gap-y-4 gap-x-6 text-sm">
        <div class="text-secondary">Picks per entry</div>
        <div class="font-mono text-heading text-right">6 teams</div>

        <div class="text-secondary">Scoring</div>
        <div class="text-right text-heading">Goals &times; Turf Score</div>

        <div class="text-secondary">Turf Score range</div>
        <div class="font-mono text-violet text-right">x1 – x3</div>

        <div class="text-secondary">Turf Score formula</div>
        <div class="font-mono text-violet text-right">1 + 2&middot;ln(rank)/ln(48)</div>

        <div class="col-span-2 border-t border-subtle my-1"></div>

        <div class="text-secondary">1st place</div>
        <div class="font-mono text-primary font-bold text-right">$300.00</div>

        <div class="text-secondary">2nd–5th place</div>
        <div class="font-mono text-heading text-right">$50.00 each</div>

        <div class="text-secondary">Total prizes</div>
        <div class="font-mono text-primary font-bold text-right">$500.00</div>

        <div class="col-span-2 border-t border-subtle my-1"></div>

        <div class="text-secondary">Entry fee</div>
        <div class="font-mono text-heading text-right">$19.00</div>

        <div class="text-secondary">Contest size</div>
        <div class="font-mono text-heading text-right">29 entries</div>

        <div class="text-secondary">Entries per user</div>
        <div class="text-heading text-right">Up to 3</div>

        <div class="text-secondary">Ties</div>
        <div class="text-heading text-right">Split evenly</div>

        <div class="text-secondary">Lock</div>
        <div class="text-heading text-right" data-test="lock-quick-ref">Stated start time</div>
      </div>
    </div>
  </section>

  <hr class="border-subtle my-10">

  <!-- ========== FOOTER CTA ========== -->
  <section class="text-center py-8">
    <p class="text-2xl md:text-3xl font-bold text-heading mb-6">Ready to play?</p>
    <%= link_to "Start Playing", root_path, class: "btn btn-primary btn-lg shadow-lg shadow-primary/20 text-lg" %>
  </section>

</div>
