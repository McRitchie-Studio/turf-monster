<%# The agent API keys card's BODY: the player's keys, the form that mints one,
    and the one-time reveal of a key just minted. docs/AGENT_API.md.

    Locals:
      user           (required)
      blocked_reason nil, or why this player cannot mint right now
                     (ApplicationController#api_key_mint_blocker). A local and
                     not a helper call in here, so the partial renders without a
                     request.
      new_key        the ApiKey just minted, still carrying its raw_token. Only
                     ApiKeysController#create passes it.
      form_error     a refusal to show under the name field
      form_name      what the player typed, so a refused form keeps it
      card_error     a refusal that is not about the form: a revoke that failed

    BODY ONLY, like its siblings: the call site owns the card and the heading.

    IT IS A TURBO FRAME, and that is how the card updates in place. Every
    ApiKeysController response carries this same frame, so a form submitted
    inside it (create, revoke) swaps only the card. Nothing here reloads the
    page.

    THE BLOCKER IS A SERVER FACT. Whether this player may mint is decided from
    the request, so when it changes under the page — the birthday card reports
    age-verified — the frame re-fetches itself rather than guessing client-side.

    THE FORM IS A COURTESY, NOT THE GATE. ApiKeysController#create re-asks the
    same question on the POST.

    A REFUSAL IS ALWAYS SAID IN THE CARD. A frame that gets an answer without
    this frame in it shows Turbo's "Content missing", and one that gets an
    answer that is not HTML shows nothing at all. So the controller answers a
    failed revoke with the card (card_error), and the one refusal that never
    reaches the controller, the mint throttle's 429 from rack-attack, is read
    off the response status by the form itself.

    THE REVEAL IS data-turbo-temporary. Turbo snapshots the page when the
    player follows a link, and Back restores that snapshot without asking the
    server: without the attribute the raw key comes back on screen from the
    browser's memory. Turbo drops temporary elements before it takes the
    snapshot. The key row and the rest of the card are kept. %>
<% new_key    = local_assigns[:new_key] %>
<% form_error = local_assigns[:form_error] %>
<% form_name  = local_assigns[:form_name] %>
<% card_error = local_assigns[:card_error] %>
<% keys       = user.api_keys.where(revoked_at: nil).newest_first.to_a %>
<% at_limit   = keys.count(&:active?) >= ApiKey::MAX_ACTIVE_PER_USER %>
<%= turbo_frame_tag "api_keys_card", data: { api_keys: true } do %>
  <p class="text-secondary text-sm mb-4">
    An API key lets an AI agent play for you: read contests, spend your free entry, check your score.
    Treat it like a password. Keys expire after <%= ApiKey::LIFETIME.in_days.to_i %> days.
  </p>

  <% if new_key&.raw_token.present? %>
    <%# Shown once: this block exists only in the response to the create POST. %>
    <div class="bg-inset rounded-lg p-4 mb-4" data-api-key-created data-turbo-temporary>
      <p class="text-body font-semibold mb-1">Copy your new key now. We can't show it again.</p>
      <p class="text-secondary text-sm mb-4">
        We store only a fingerprint of it, so if you lose it, revoke it and create another.
      </p>

      <%# The key is printed in a block of its own so it can wrap on a phone;
          the engine copy button beside it carries the full value and shows
          only the prefix, which keeps Copy on screen at any width. %>
      <div class="mb-4" data-api-key-secret>
        <code class="block bg-surface-alt border border-subtle rounded px-3 py-2 mb-2 text-primary font-mono text-sm break-all"
              data-api-key-value><%= new_key.raw_token %></code>
        <%= render "components/copy_button", text: new_key.raw_token, display: "#{new_key.prefix}…" %>
      </div>

      <p class="text-sm font-bold text-heading mb-2">Check that it works</p>
      <div class="mb-4" data-api-key-curl>
        <code class="block bg-surface-alt border border-subtle rounded px-3 py-2 mb-2 text-secondary font-mono text-xs break-all">curl -H "Authorization: Bearer <%= new_key.prefix %>…" <%= root_url %>api/v1/me</code>
        <%= render "components/copy_button",
              text: %(curl -H "Authorization: Bearer #{new_key.raw_token}" #{root_url}api/v1/me),
              display: "curl with your key" %>
      </div>

      <%= link_to "I've copied it", account_api_keys_path, class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>

  <% if card_error.present? %>
    <p role="alert" class="text-sm mb-4 text-danger-ink" data-api-key-card-error><%= card_error %></p>
  <% end %>

  <% if keys.any? %>
    <ul class="mb-4" data-api-key-list>
      <% keys.each do |key| %>
        <li class="py-3 border-b border-subtle flex items-center justify-between gap-3 flex-wrap" data-api-key-row="<%= key.id %>">
          <div class="min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="text-body text-sm font-semibold truncate"><%= key.name %></span>
              <code class="bg-inset rounded px-2 py-1 text-primary font-mono text-xs"><%= key.prefix %>…</code>
              <% if key.expired? %>
                <span class="text-xs font-bold text-muted uppercase">Expired</span>
              <% end %>
            </div>
            <p class="text-xs text-muted mt-1">
              <%= key.expired? ? "Expired" : "Expires" %> <%= key.expires_at.strftime("%b %-d, %Y") %>
              ·
              <%= key.last_used_at ? "Last used #{time_ago_in_words(key.last_used_at)} ago" : "Never used" %>
            </p>
          </div>
          <%# busy follows Turbo's own submit events, not the click: submit-start
              fires only after the confirm is accepted, so declining it never
              leaves a spinner behind. %>
          <%= button_to account_api_key_path(key), method: :delete,
                class: "btn btn-danger btn-sm flex-shrink-0",
                form: { "x-data" => "{ busy: false }",
                        "@turbo:submit-start" => "busy = true",
                        "@turbo:submit-end" => "busy = false",
                        data: { turbo_confirm: "Revoke this key? Any agent using it stops working immediately." } } do %>
            <span x-show="!busy">Revoke</span>
            <span x-show="busy" x-cloak class="inline-flex items-center justify-center gap-2">
              <span class="cta-spinner" aria-hidden="true"></span>Revoking…
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <% if new_key&.raw_token.present? %>
    <%# Nothing else to offer until the key has been copied. %>
  <% elsif blocked_reason == :impersonating %>
    <p class="text-sm text-secondary" data-api-key-blocked="impersonating">
      API keys can't be created while acting as another user.
    </p>
  <% elsif blocked_reason == :frozen %>
    <p class="text-sm text-secondary" data-api-key-blocked="frozen">
      New keys are unavailable while your account is on hold.
    </p>
  <% elsif blocked_reason == :geo %>
    <p class="text-sm text-secondary" data-api-key-blocked="geo">
      API keys aren't available where you are, because contests aren't either.
    </p>
  <% elsif blocked_reason == :age %>
    <%# The birthday card dispatches age-verified on success. Re-fetch the frame
        so the server, which decides the blocker, renders the form. %>
    <div class="flex items-center justify-between gap-3 flex-wrap" data-api-key-blocked="age"
         x-data
         @age-verified.window="(frame => frame.src ? frame.reload() : (frame.src = '<%= account_api_keys_path %>'))($el.closest('turbo-frame'))">
      <p class="text-sm text-secondary min-w-0">Verify your age to create an API key.</p>
      <button type="button" @click="$store.modals.open('birthday', {})" class="btn btn-primary btn-sm flex-shrink-0">
        Verify age
      </button>
    </div>
  <% elsif at_limit %>
    <p class="text-sm text-secondary" data-api-key-blocked="limit">
      You have <%= ApiKey::MAX_ACTIVE_PER_USER %> active keys, the most an account can hold. Revoke one to create another.
    </p>
  <% else %>
    <%# With no keys the form is the card. With keys it waits behind a link, and
        a refused submit comes back with it open. %>
    <div x-data="{ adding: <%= keys.empty? || form_error.present? %>, busy: false, throttled: false }">
      <% if keys.any? %>
        <button type="button" x-show="!adding" @click="adding = true; $nextTick(() => $refs.name.focus())"
                class="text-sm font-semibold text-primary hover:underline underline-offset-2" data-api-key-add>
          Add another API key
        </button>
      <% end %>

      <%= form_with url: account_api_keys_path, method: :post,
            data: { api_key_form: true },
            html: { "x-show" => "adding", "x-cloak" => true,
                    "@turbo:submit-start" => "busy = true; throttled = false",
                    "@turbo:submit-end" => "busy = false; throttled = $event.detail.fetchResponse?.response.status === 429" } do %>
        <label for="api_key_name" class="block text-sm font-bold text-heading mb-2">Name</label>
        <div class="flex gap-2">
          <input type="text" name="name" id="api_key_name" x-ref="name" required
                 maxlength="<%= ApiKey::NAME_MAX_LENGTH %>" value="<%= form_name %>"
                 class="input-field flex-1 min-w-0" placeholder="e.g. Claude" autocomplete="off"
                 <% if form_error.present? %>aria-invalid="true" aria-describedby="api_key_name_error"<% end %>>
          <button type="submit" class="btn btn-primary flex-shrink-0" :disabled="busy">
            <span x-show="!busy">Create key</span>
            <span x-show="busy" x-cloak class="inline-flex items-center justify-center gap-2">
              <span class="cta-spinner" aria-hidden="true"></span>Creating…
            </span>
          </button>
        </div>
        <% if form_error.present? %>
          <p id="api_key_name_error" role="alert" class="text-xs mt-2 text-danger-ink" data-api-key-error><%= form_error %></p>
        <% end %>
        <%# The mint throttle answers from rack-attack, in JSON, before any
            controller runs: there is no card in that response to swap in. %>
        <p x-show="throttled" x-cloak role="alert" class="text-xs mt-2 text-danger-ink" data-api-key-throttled>
          You've created too many keys in the last hour. Please wait a while and try again.
        </p>
      <% end %>
    </div>
  <% end %>
<% end %>
