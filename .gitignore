# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Hidden per-task git worktrees created by mcritchie-studio/bin/agent-worktree.
/.worktrees/

# Solana test validator
test-ledger/

# Playwright / Node
node_modules/
test-results/
playwright-report/
playwright/.cache/
.env

/app/assets/builds/*
!/app/assets/builds/.keep
coverage/

# DraftKings scraper debug artifacts — screenshots + raw page dumps are opt-in
# (--debug/--headed) and must never be committed again. The scraped odds JSON
# (scripts/data/draftkings_team_totals.json, consumed by db/seeds.rb) stays tracked.
scripts/data/*.png
scripts/data/dk_*_raw.txt
scripts/data/dk_market_raw.txt
