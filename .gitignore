# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates).
/.env*
!/.env*.erb
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

# Hidden per-task git worktrees created by mcritchie-studio/bin/agent-worktree.
/.worktrees/

# Solana test validator
test-ledger/

# Playwright / Node
#
# NO TRAILING SLASH, AND THAT IS THE WHOLE POINT. A pattern ending in "/"
# matches DIRECTORIES ONLY. node_modules here was a committed SYMLINK (mode
# 120000) whose content was an ABSOLUTE path to this repo's own node_modules --
# it pointed at itself -- and "node_modules/" did not match it, so a routine
# `git add -A` staged it and
# da74fbc5 shipped it to main and accepted. Every desk git created after that
# checked the symlink out, which is why the local e2e lane was dead on all of
# them while CI stayed green: CI installs its own. Restoring the slash re-opens
# exactly that hole.
node_modules
test-results/
playwright-report/
playwright/.cache/
.env

/app/assets/builds/*
!/app/assets/builds/.keep
coverage/

# DraftKings scraper debug artifacts — screenshots + raw page dumps are opt-in
# (--debug/--headed) and must never be committed again. The scraped odds JSON
# (scripts/data/draftkings_team_totals.json, consumed by db/seeds.rb) stays tracked.
scripts/data/*.png
scripts/data/dk_*_raw.txt
scripts/data/dk_market_raw.txt
