#!/usr/bin/env ruby
# frozen_string_literal: true

# The QA contest rehearsal, as five steps you run one at a time.
#
#   bin/qa-contest-rehearsal seed       # 0. once per QA database: the parked roster
#   bin/qa-contest-rehearsal create     # 1. contest, on-chain, pool funded
#   bin/qa-contest-rehearsal enter      # 2. the cast enters, as real players
#   bin/qa-contest-rehearsal play       # 3. replay preseason, every play, unattended
#   bin/qa-contest-rehearsal play --pace 4   #    ... or paced, to watch
#   bin/qa-contest-rehearsal conclude   # 4. lock, grade, settle
#   bin/qa-contest-rehearsal close      # 5. reclaim rent
#
# Options:
#   --cast mack,turf        who plays (default: mack,turf)
#   --cosign agent|link     step 4: `agent` (default) settles unattended on devnet
#                           v0.26 with the server key plus a seated devnet-only agent
#                           key, never a mainnet key; `link` mints a link you sign
#                           in Phantom
#   --no-reset              step 3: keep the scores already recorded
#   --pace SECONDS          step 3, watched: that far apart (fractions work; 0 is refused)
#   --no-replay             step 3: poll only, skipping the per-play chain
#
# Option parsing lives in lib/turf_monster/qa_rehearsal/options.rb.
#
# DEVNET ONLY. Every step runs NetworkGuard before it loads a key, and the
# guard refuses any app but turf-monster-qa running the devnet program. That
# is not ceremony: the cast's keys are real wallets. MainnetSignerFence refuses
# any key the driver loads that is a mainnet signer or Squads member, so Mason
# (CytJ…, a mainnet signer) no longer plays.
#
# Steps share state through tmp/qa-rehearsal/current.json, so each one is
# re-runnable on its own and `create` starts a fresh run.

require_relative "../config/environment"

begin
  step, options = TurfMonster::QaRehearsal::Options.parse(ARGV)
rescue TurfMonster::QaRehearsal::Options::Invalid => e
  warn "STOPPED — #{e.message}"
  exit 1
end

unless step
  puts TurfMonster::QaRehearsal::Options.parser
  exit 1
end

driver = TurfMonster::QaRehearsal::Driver.new(
  **{ cast: options[:cast] }.compact
)

# Every step says how long it took, so the gauntlet's end-to-end time is read
# off the transcript rather than reconstructed afterwards.
started = Process.clock_gettime(Process::CLOCK_MONOTONIC)

begin
  case step
  when "seed"     then driver.seed_roster
  when "create"   then driver.create_contest
  when "enter"    then driver.enter_cast
  when "play"     then driver.play_preseason(reset: options[:reset], pace: options[:pace], replay: options[:replay])
  when "conclude" then driver.conclude(cosign: options[:cosign])
  when "close"    then driver.close_contest
  when "status"
    puts JSON.pretty_generate(driver.manifest.read_or_empty)
  else
    warn "unknown step #{step.inspect}"
    puts TurfMonster::QaRehearsal::Options.parser
    exit 1
  end
rescue TurfMonster::QaRehearsal::NetworkGuard::RefusedError => e
  # The refusal is the headline, not a stack trace behind it.
  warn e.message
  exit 2
rescue TurfMonster::QaRehearsal::Driver::StepError, TurfMonster::QaRehearsal::RemoteRunner::Refused => e
  # A stop the driver or the dyno explained: the sentence is the whole report.
  warn "STOPPED — #{e.message}"
  exit 1
rescue StandardError => e
  warn "#{e.class}: #{e.message}"
  exit 1
ensure
  unless step == "status"
    puts format("  elapsed: %ds (%s)", Process.clock_gettime(Process::CLOCK_MONOTONIC) - started, step)
  end
end
